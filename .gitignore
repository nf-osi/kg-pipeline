# Ignore generated data artifacts
# Keep data directory contents out of the repository
# (files will remain locally but will not be tracked)
data/

# Ignore RMLMapper logs
logs/

# Ignore harmonization reports
reports/

# Ignore local RMLMapper binary
tools/rmlmapper-8.1.0.jar

# Ignore test output artifacts
test/output.ttl
test/*.log
test/temp_*.ttl

# Ignore .env (API keys)
.env

# Ignore generated eval data
astabench/astabench/evals/nf_rag/eval_data.yaml

# Ignore Python cache artifacts
__pycache__/
*.py[cod]
*.egg-info/

# Ignore Python virtual environments
.venv/
venv/
env/

# Ignore Dagster temporary directories
.tmp_dagster_home_*/
.dagster_home/
