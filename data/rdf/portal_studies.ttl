        :initiative          "Patient Reported Outcomes" ;
        rdf:type             :Study ;
        :studyName           "Development of a Child Neurofibromatosis Type 1 Health Related Quality of Life Measure" ;
        :dataStatus          "Under Embargo" ;
        :fundingAgency       "NTAP" .

<https://www.synapse.org/#!Synapse:syn4939876>
        :grantDOI            <https://doi.org/10.54464/pc.gr.147694> ;
        :studyName           "Combination Index Validation Studies (2 drug combinations)" ;
        :diseaseFocus        :Neurofibromatosis_Type_1 ;
