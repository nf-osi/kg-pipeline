@prefix : <http://nf-osi.github.com/terms#> .
@prefix nfgraph: <http://nf-osi.github.com/templates/0.1/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix pav: <http://purl.org/pav/> .

@prefix ottr: <http://ns.ottr.xyz/0.4/> .
@prefix o-rdfs:    <http://tpl.ottr.xyz/rdfs/0.2/> .
@prefix o-rdf:     <http://tpl.ottr.xyz/rdf/0.1/> .
@prefix o-docttr:  <http://tpl.ottr.xyz/p/docttr/0.1/> .


nfgraph:File_Resource [
   ottr:IRI ?iri ,
   ? xsd:string ?name ,
   ? ottr:IRI ?studyId ,
   ? List<ottr:IRI> ?assay ,
   ? List<ottr:IRI> ?platform ,
   ? ottr:IRI ?resourceType ,
   ? List<ottr:IRI> ?dataType ,
   ? List<ottr:IRI> ?dataSubtype ,
   ? ottr:IRI ?fileFormat ,
   ? xsd:string ?individualID ,
   ? List<ottr:IRI> ?diagnosis ,
   ? List<ottr:IRI> ?nf1Genotype ,
   ? List<ottr:IRI> ?nf2Genotype ,
   ? List<ottr:IRI> ?sex ,
   ? List<ottr:IRI> ?species,
   ? xsd:string ?specimenID ,
   ? ottr:IRI ?bodyPart ,
   ? List<ottr:IRI> ?organ ,
   ? List<ottr:IRI> ?cellType ,
   ? List<ottr:IRI> ?tissue ,
   ? List<ottr:IRI> ?tumorType ,
   ? xsd:string ?fundingAgency ,
   ? xsd:string ?reportMilestone ,
   ? xsd:string ?compoundName ,
   ? ottr:IRI ?drugScreenType ,
   ? List<ottr:IRI> ?modelSystemName
   ]
:: {

    o-rdf:Type(?iri, :File),
    ottr:Triple(?iri, :name , ?name),
    ottr:Triple(?iri, :studyId, ?studyId ),
    cross | ottr:Triple(?iri, :assay, ++?assay ),
    cross | ottr:Triple(?iri, :platform, ++?platform ),
    ottr:Triple(?iri, :resourceType, ?resourceType ),
    cross | ottr:Triple(?iri, :dataType, ++?dataType ),
    cross | ottr:Triple(?iri, :dataSubtype, ++?dataSubtype) ,
    ottr:Triple(?iri, :fileFormat, ?fileFormat) ,
    ottr:Triple(?iri, :individualID, ?individualID ),
    cross | ottr:Triple(?iri, :diagnosis, ++?diagnosis ),
    cross | ottr:Triple(?iri, :nf1Genotype,  ++?nf1Genotype ),
    cross | ottr:Triple(?iri, :nf2Genotype, ++?nf2Genotype ),
    cross | ottr:Triple(?iri, :sex, ++?sex ),
    cross | ottr:Triple(?iri, :species, ++?species),
    ottr:Triple(?iri, :specimenID, ?specimenID ),
    ottr:Triple(?iri, :bodyPart, ?bodyPart ),
    cross | ottr:Triple(?iri, :organ , ++?organ ) ,
    cross | ottr:Triple(?iri, :cellType, ++?cellType ),
    cross | ottr:Triple(?iri, :tissue, ++?tissue ),
    cross | ottr:Triple(?iri, :tumorType, ++?tumorType ),
    ottr:Triple(?iri, :fundingAgency, ?fundingAgency ) ,
    ottr:Triple(?iri, :reportMilestone, ?reportMilestone ),
    ottr:Triple(?iri, :compoundName, ?compoundName ),
    ottr:Triple(?iri, :drugScreenType, ?drugScreenType ),
    cross | ottr:Triple(?iri, :modelSystemName, ++?modelSystemName )
} .
