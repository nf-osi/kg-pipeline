@prefix : <http://nf-osi.github.com/terms#> .
@prefix nfgraph: <http://nf-osi.github.com/templates/0.1/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix pav: <http://purl.org/pav/> .

@prefix ottr: <http://ns.ottr.xyz/0.4/> .
@prefix o-rdfs:    <http://tpl.ottr.xyz/rdfs/0.2/> .
@prefix o-rdf:     <http://tpl.ottr.xyz/rdf/0.1/> .
@prefix o-docttr:  <http://tpl.ottr.xyz/p/docttr/0.1/> .

nfgraph:Resource [
   ottr:IRI ?iri , #resourceId
   ! ottr:IRI ?uuid ,
   ? ottr:IRI ?rrid ,
   ! ottr:IRI ?resourceType ,
   ! xsd:string ?name ,
   ? List<xsd:string> ?synonyms ,
   ? xsd:string ?description ,
   ? xsd:string ?usageRequirements ,
   ? xsd:string ?howToAcquire ,
   ? xsd:string ?dateAdded ,
   ? xsd:string ?dateModified
   ]
:: {

    cross | o-rdf:Type(?iri, ++(rdfs:Resource, ?resourceType)),
    cross | ottr:Triple(?iri, owl:sameAs, ++(?uuid, ?rrid)),
    ottr:Triple(?iri, rdf:label, ?name),
    cross | ottr:Triple(?iri, skos:altLabel, ++?synonyms),
    ottr:Triple(?iri, :description, ?description),
    ottr:Triple(?iri, :usageRestriction, ?usageRequirements),
    ottr:Triple(?iri, :howToAcquire, ?howToAcquire),
    ottr:Triple(?iri, :dateAdded, ?dateAdded),
    ottr:Triple(?iri, :dateModified, ?dateModified)
} .


nfgraph:Donor [
   ottr:IRI ?iri ,
   ? ottr:IRI ?parentDonorId ,
   ? ottr:IRI ?species ,
   ? ottr:IRI ?race ,
   ? ottr:IRI ?sex ,
   ? xsd:double ?age
   ]
:: {

    o-rdf:Type(?iri, ?species),
    ottr:Triple(?iri, :donor, ?parentDonorId),
    ottr:Triple(?iri, :race, ?race),
    ottr:Triple(?iri, :sex, ?sex),
    ottr:Triple(?iri, :age, ?age)
} .


nfgraph:AnimalModel [
   ottr:IRI ?iri ,
   ? ottr:IRI ?donorId ,
   ? ottr:IRI ?backgroundSubstrain ,
   ? xsd:string ?strainNomenclature ,
   ? ottr:IRI ?manifestation ,
   ? ottr:IRI ?geneticDisorder ,
   ? ottr:IRI ?state ,
   ? ottr:IRI ?generation
   ]
:: {

    o-rdf:Type(?iri, ?category),
    ottr:Triple(?iri, :donor, ?donorId),
    ottr:Triple(?iri, :backgroundSubstrain, ?backgroundSubstrain),
    ottr:Triple(?iri, :strainNomenclature, ?strainNomenclature),
    ottr:Triple(?iri, :tissue, ?tissue),
    ottr:Triple(?iri, :manifestation, ?manifestation),
    ottr:Triple(?iri, :geneticDisorder, ?geneticDisorder),
    ottr:Triple(?iri, :state, ?state),
    ottr:Triple(?iri, :generation, ?generation)
} .


nfgraph:CellLine [
   ottr:IRI ?iri ,
   ! ottr:IRI ?category ,
   ? ottr:IRI ?donorId ,
   ? ottr:IRI ?organ ,
   ? ottr:IRI ?tissue ,
   ? ottr:IRI ?manifestation ,
   ? ottr:IRI ?geneticDisorder ,
   ? xsd:string ?populationDoublingTime 
   ]
:: {

    o-rdf:Type(?iri, ?category),
    ottr:Triple(?iri, :donor, ?donorId),
    ottr:Triple(?iri, :organ, ?organ),
    ottr:Triple(?iri, :tissue, ?tissue),
    ottr:Triple(?iri, :manifestation, ?manifestation),
    ottr:Triple(?iri, :geneticDisorder, ?geneticDisorder),
    ottr:Triple(?iri, :populationDoublingTime, ?populationDoublingTime)
} .

nfgraph:Mutation [
   ottr:IRI ?iri ,
   ? ottr:IRI ?mutationType ,
   ? ottr:IRI ?mutationMethod ,
   ? xsd:string ?clinVar ,
   ? ottr:IRI ?alleleType ,
   ? ottr:IRI ?affectedGene ,
   ? xsd:string ?sequenceVariation ,
   ? xsd:string ?proteinVariation ,
   ? xsd:positiveInteger ?chromosome 
   ]
:: {

    cross | o-rdf:Type(?iri, ++(:Mutation, ?mutationType)),
    ottr:Triple(?iri, :mutationMethod, ?mutationMethod),
    ottr:Triple(?iri, :clinVar, ?clinVar),
    ottr:Triple(?iri, :alleleType, ?alleleType),
    ottr:Triple(?iri, :affectedGene, ?affectedGene),
    ottr:Triple(?iri, :sequenceVariation, ?sequenceVariation),
    ottr:Triple(?iri, :proteinVariation, ?proteinVariation),
    ottr:Triple(?iri, :onChromosome, ?chromosome),

} .

nfgraph:Vector [
   ottr:IRI ?iri ,
   ! ottr:IRI ?vectorType ,
   ? xsd:string ?insertEntrezId ,
   ? xsd:string ?insertName ,
   ? xsd:string ?fiveprimer ,
   ? ottr:IRI ?cloningMethod ,
   ? ottr:IRI ?copyNumber ,
   ? ottr:IRI ?insertSpecies,
   ? xsd:string ?nTerminalTag ,
   ? xsd:string ?cTerminalTag ,
   ? xsd:string ?totalSize ,
   ? xsd:string ?fiveprimeCloningSite ,
   ? xsd:string ?growthTemp ,
   ? xsd:string ?threeprimer,
   ? xsd:boolean ?fiveprimeSiteDestroyed ,
   ? xsd:boolean ?threePrimeSiteDestroyed ,
   ? xsd:string ?threeprimeCloningSite ,
   ? xsd:string ?promoter ,
   ? xsd:string ?backboneSize ,
   ? xsd:string ?insertSize ,
   ? xsd:string ?vectorBackbone ,
   ? xsd:growthStrain ?vectorName ,
   ? xsd:string ?gRNAshRNASequence ,
   ? xsd:string ?growthStrain ,
   ? xsd:string ?selectableMarker ,
   ? xsd:string ?bacterialResistance
   ]
:: {

    o-rdf:Type(?iri, ?vectorType),
    ottr:Triple(?iri, :insertEntrezId, ?insertEntrezId),
    ottr:Triple(?iri, :insertName, ?insertName),
    ottr:Triple(?iri, :5primer, ?fiveprimer),
    ottr:Triple(?iri, :cloningMethod, ?cloningMethod),
    ottr:Triple(?iri, :copyNumber, ?copyNumber),
    ottr:Triple(?iri, :insertSpecies, ?insertSpecies),
    ottr:Triple(?iri, :nTerminalTag, ?nTerminalTag),
    ottr:Triple(?iri, :cTerminalTag, ?cTerminalTag),
    ottr:Triple(?iri, :totalSize, ?totalSize),
    ottr:Triple(?iri, :5primeCloningSite, ?fiveprimeCloningSite),
    ottr:Triple(?iri, :growthTemp, ?growthTemp),
    ottr:Triple(?iri, :threeprimer, ?threeprimer),
    ottr:Triple(?iri, :fiveprimeSiteDestroyed, ?fiveprimeSiteDestroyed),
    ottr:Triple(?iri, :threePrimeSiteDestroyed, ?threePrimeSiteDestroyed),
    ottr:Triple(?iri, :threeprimeCloningSite, ?threeprimeCloningSite),
    ottr:Triple(?iri, :promoter, ?promoter),
    ottr:Triple(?iri, :backboneSize, ?backboneSize),
    ottr:Triple(?iri, :insertSize, ?insertSize),
    ottr:Triple(?iri, :vectorBackbone, ?vectorBackbone),
    ottr:Triple(?iri, :vectorName, ?vectorName),
    ottr:Triple(?iri, :gRNAshRNASequence, ?gRNAshRNASequence),
    ottr:Triple(?iri, :growthStrain, ?growthStrain),
    ottr:Triple(?iri, :selectableMarker, ?selectableMarker),
    ottr:Triple(?iri, :bacterialResistance, ?bacterialResistance)

} .

nfgraph:Mutation_Resource [
   ottr:IRI ?mutation ,
   ? ottr:IRI ?animalModel ,
   ? ottr:IRI ?cellLine
   ]
:: {

    ottr:Triple(?animalModel, :hasMutation, ?mutation),
    ottr:Triple(?cellLine, :hasMutation, ?mutation)
} .

nfgraph:Publication_Resource [
   ottr:IRI ?publication ,
   ! ottr:IRI ?resource
   ]
:: {

    ottr:Triple(?publication, :used, ?resource)
} .

nfgraph:Development [
    ottr:IRI ?resourceUUID ,
    ? ottr:IRI ?investigator ,
    ? ottr:IRI ?publication ,
    ? ottr:IRI ?funder 
]
:: {
    ottr:Triple(?resourceUUID, :createdBy, ?investigator),
    ottr:Triple(?resourceUUID, :reference, ?publication),
    ottr:Triple(?resourceUUID, :fundedBy, ?funder)
} .



