@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix fnml: <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno:  <https://w3id.org/function/ontology#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .
@prefix nf:   <http://nf-osi.github.com/terms#> .
@prefix map:  <http://nf-osi.github.com/mappings/portal-animal-models#> .

################################################################################
# Logical source
################################################################################

map:PortalAnimalModelsSource a rml:LogicalSource ;
    rml:source "data/csv/animal_models_harmonized.csv" ;
    rml:referenceFormulation ql:CSV .

################################################################################
# Animal Model core facts
################################################################################

map:AnimalModelCore a rr:TriplesMap ;
    rdfs:label "Animal Model Core" ;
    rml:logicalSource map:PortalAnimalModelsSource ;
    rr:subjectMap [
        rr:template "http://nf-osi.github.com/terms#animalModel/{animalModelId}" ;
        rr:termType rr:IRI
    ] ;
    rr:predicateObjectMap [ rr:predicate rdf:type ; rr:objectMap [ rr:constant nf:AnimalModel ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate rdf:type ; rr:objectMap [ rml:reference "animalModelClass" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:animalModelId ; rr:objectMap [ rml:reference "animalModelId" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:donorId ; rr:objectMap [ rr:template "http://nf-osi.github.com/terms#donor/{donorId}" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:fromDonor ; rr:objectMap [ rr:template "http://nf-osi.github.com/terms#donor/{donorId}" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:species ; rr:objectMap [ rml:reference "species" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:transplantationDonorId ; rr:objectMap [ rr:template "http://nf-osi.github.com/terms#donor/{transplantationDonorId}" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:backgroundStrain ; rr:objectMap [ rml:reference "backgroundStrain" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:backgroundSubstrain ; rr:objectMap [ rml:reference "backgroundSubstrain" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:strainNomenclature ; rr:objectMap [ rml:reference "strainNomenclature" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:transplantationType ; rr:objectMap [ rml:reference "transplantationType" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:animalState ; rr:objectMap [ rml:reference "animalState" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:generation ; rr:objectMap [ rml:reference "generation" ; rr:datatype xsd:string ] ] .

################################################################################
# Multi-valued fields (StringList)
################################################################################

map:AnimalModelManifestation a rr:TriplesMap ;
    rdfs:label "Animal Model Manifestation" ;
    rml:logicalSource map:PortalAnimalModelsSource ;
    rr:subjectMap [
        rr:template "http://nf-osi.github.com/terms#animalModel/{animalModelId}" ;
        rr:termType rr:IRI
    ] ;
    rr:predicateObjectMap [
        rr:predicate nf:manifestation ;
        rr:objectMap [
            a fnml:FunctionTermMap ;
            rr:datatype xsd:string ;
            fnml:functionValue [
                a fno:Execution ;
                rml:logicalSource map:PortalAnimalModelsSource ;
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant grel:string_split ; rr:termType rr:IRI ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "animalModelOfManifestation" ; rr:termType rr:Literal ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_sep ;
                    rr:objectMap [ rr:constant "\\|" ; rr:termType rr:Literal ]
                ]
            ]
        ]
    ] .

map:AnimalModelGeneticDisorder a rr:TriplesMap ;
    rdfs:label "Animal Model Genetic Disorder" ;
    rml:logicalSource map:PortalAnimalModelsSource ;
    rr:subjectMap [
        rr:template "http://nf-osi.github.com/terms#animalModel/{animalModelId}" ;
        rr:termType rr:IRI
    ] ;
    rr:predicateObjectMap [
        rr:predicate nf:geneticDisorder ;
        rr:objectMap [
            a fnml:FunctionTermMap ;
            rr:datatype xsd:string ;
            fnml:functionValue [
                a fno:Execution ;
                rml:logicalSource map:PortalAnimalModelsSource ;
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant grel:string_split ; rr:termType rr:IRI ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "animalModelGeneticDisorder" ; rr:termType rr:Literal ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_sep ;
                    rr:objectMap [ rr:constant "\\|" ; rr:termType rr:Literal ]
                ]
            ]
        ]
    ] .
