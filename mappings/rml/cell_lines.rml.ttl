@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix fnml: <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno:  <https://w3id.org/function/ontology#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .
@prefix nf:   <http://nf-osi.github.com/terms#> .
@prefix map:  <http://nf-osi.github.com/mappings/portal-cell-lines#> .

################################################################################
# Logical source
################################################################################

map:PortalCellLinesSource a rml:LogicalSource ;
    rml:source "data/csv/cell_lines_harmonized.csv" ;
    rml:referenceFormulation ql:CSV .

################################################################################
# Cell Line core facts
################################################################################

map:CellLineCore a rr:TriplesMap ;
    rdfs:label "Cell Line Core" ;
    rml:logicalSource map:PortalCellLinesSource ;
    rr:subjectMap [
        rr:template "http://nf-osi.github.com/terms#resource/{resourceId}" ;
        rr:termType rr:IRI
    ] ;
    rr:predicateObjectMap [ rr:predicate rdf:type ; rr:objectMap [ rr:constant nf:Tool ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:resourceId ; rr:objectMap [ rml:reference "resourceId" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:name ; rr:objectMap [ rml:reference "resourceName" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ; rr:objectMap [ rml:reference "resourceName" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:resourceType ; rr:objectMap [ rml:reference "resourceType" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:description ; rr:objectMap [ rml:reference "description" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:aiSummary ; rr:objectMap [ rml:reference "aiSummary" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:rrid ; rr:objectMap [ rml:reference "rrid" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:howToAcquire ; rr:objectMap [ rml:reference "howToAcquire" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:dateAdded ; rr:objectMap [ rml:reference "dateAdded" ; rr:datatype xsd:long ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:dateModified ; rr:objectMap [ rml:reference "dateModified" ; rr:datatype xsd:long ] ] ;
    rr:predicateObjectMap [ rr:predicate rdf:type ; rr:objectMap [ rr:constant nf:CellLine ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate rdf:type ; rr:objectMap [ rml:reference "cellLineClass" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:donorId ; rr:objectMap [ rr:template "http://nf-osi.github.com/terms#donor/{donorId}" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:fromDonor ; rr:objectMap [ rr:template "http://nf-osi.github.com/terms#donor/{donorId}" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:originYear ; rr:objectMap [ rml:reference "originYear" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:organ ; rr:objectMap [ rml:reference "organ" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:race ; rr:objectMap [ rml:reference "race" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:strProfile ; rr:objectMap [ rml:reference "strProfile" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:tissue ; rr:objectMap [ rml:reference "tissue" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:resistance ; rr:objectMap [ rml:reference "resistance" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:cellLineCategory ; rr:objectMap [ rml:reference "cellLineCategory" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:populationDoublingTime ; rr:objectMap [ rml:reference "populationDoublingTime" ; rr:datatype xsd:string ] ] .

################################################################################
# Multi-valued fields (StringList)
################################################################################

map:CellLineManifestation a rr:TriplesMap ;
    rdfs:label "Cell Line Manifestation" ;
    rml:logicalSource map:PortalCellLinesSource ;
    rr:subjectMap [
        rr:template "http://nf-osi.github.com/terms#resource/{resourceId}" ;
        rr:termType rr:IRI
    ] ;
    rr:predicateObjectMap [
        rr:predicate nf:manifestation ;
        rr:objectMap [
            a fnml:FunctionTermMap ;
            rr:datatype xsd:string ;
            fnml:functionValue [
                a fno:Execution ;
                rml:logicalSource map:PortalCellLinesSource ;
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant grel:string_split ; rr:termType rr:IRI ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "manifestation" ; rr:termType rr:Literal ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_sep ;
                    rr:objectMap [ rr:constant "\\|" ; rr:termType rr:Literal ]
                ]
            ]
        ]
    ] .

map:CellLineGeneticDisorder a rr:TriplesMap ;
    rdfs:label "Cell Line Genetic Disorder" ;
    rml:logicalSource map:PortalCellLinesSource ;
    rr:subjectMap [
        rr:template "http://nf-osi.github.com/terms#resource/{resourceId}" ;
        rr:termType rr:IRI
    ] ;
    rr:predicateObjectMap [
        rr:predicate nf:geneticDisorder ;
        rr:objectMap [
            a fnml:FunctionTermMap ;
            rr:datatype xsd:string ;
            fnml:functionValue [
                a fno:Execution ;
                rml:logicalSource map:PortalCellLinesSource ;
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant grel:string_split ; rr:termType rr:IRI ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "geneticDisorder" ; rr:termType rr:Literal ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_sep ;
                    rr:objectMap [ rr:constant "\\|" ; rr:termType rr:Literal ]
                ]
            ]
        ]
    ] .

map:CellLineSynonyms a rr:TriplesMap ;
    rdfs:label "CellLine Synonyms" ;
    rml:logicalSource map:PortalCellLinesSource ;
    rr:subjectMap [
        rr:template "http://nf-osi.github.com/terms#resource/{resourceId}" ;
        rr:termType rr:IRI
    ] ;
    rr:predicateObjectMap [
        rr:predicate nf:synonyms ;
        rr:objectMap [
            a fnml:FunctionTermMap ;
            rr:datatype xsd:string ;
            fnml:functionValue [
                a fno:Execution ;
                rml:logicalSource map:PortalCellLinesSource ;
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant grel:string_split ; rr:termType rr:IRI ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "synonyms" ; rr:termType rr:Literal ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_sep ;
                    rr:objectMap [ rr:constant "\\|" ; rr:termType rr:Literal ]
                ]
            ]
        ]
    ] .

map:CellLineUsageRequirements a rr:TriplesMap ;
    rdfs:label "CellLine Usage Requirements" ;
    rml:logicalSource map:PortalCellLinesSource ;
    rr:subjectMap [
        rr:template "http://nf-osi.github.com/terms#resource/{resourceId}" ;
        rr:termType rr:IRI
    ] ;
    rr:predicateObjectMap [
        rr:predicate nf:usageRequirements ;
        rr:objectMap [
            a fnml:FunctionTermMap ;
            rr:datatype xsd:string ;
            fnml:functionValue [
                a fno:Execution ;
                rml:logicalSource map:PortalCellLinesSource ;
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant grel:string_split ; rr:termType rr:IRI ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "usageRequirements" ; rr:termType rr:Literal ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_sep ;
                    rr:objectMap [ rr:constant "\\|" ; rr:termType rr:Literal ]
                ]
            ]
        ]
    ] .
