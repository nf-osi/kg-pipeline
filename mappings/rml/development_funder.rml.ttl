@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix nf:   <http://nf-osi.github.com/terms#> .
@prefix map:  <http://nf-osi.github.com/mappings/development-funder#> .

################################################################################
# Logical source
################################################################################

map:DevelopmentFunderSource a rml:LogicalSource ;
    rml:source "data/csv/development_funder.csv" ;
    rml:referenceFormulation ql:CSV .

################################################################################
# Development -> Funder relationship
################################################################################

map:DevelopmentHasFunder a rr:TriplesMap ;
    rdfs:label "Development Has Funder" ;
    rml:logicalSource map:DevelopmentFunderSource ;
    rr:subjectMap [ rr:template "http://nf-osi.github.com/terms#development/{developmentId}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate nf:hasFunder ;
        rr:objectMap [ rr:template "http://nf-osi.github.com/terms#funder/{funderId}" ; rr:termType rr:IRI ]
    ] .

################################################################################
# Funder properties
################################################################################

map:FunderCore a rr:TriplesMap ;
    rdfs:label "Funder Core" ;
    rml:logicalSource map:DevelopmentFunderSource ;
    rr:subjectMap [ rr:template "http://nf-osi.github.com/terms#funder/{funderId}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [ rr:predicate rdf:type ; rr:objectMap [ rr:constant nf:Funder ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:name ; rr:objectMap [ rml:reference "funderName" ; rr:datatype xsd:string ] ] .

################################################################################
# Resource -> Funder relationship (via development)
################################################################################

map:ResourceHasFunder a rr:TriplesMap ;
    rdfs:label "Resource Has Funder" ;
    rml:logicalSource map:DevelopmentFunderSource ;
    rr:subjectMap [ rr:template "http://nf-osi.github.com/terms#resource/{resourceId}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate nf:hasFunder ;
        rr:objectMap [ rr:template "http://nf-osi.github.com/terms#funder/{funderId}" ; rr:termType rr:IRI ]
    ] .

################################################################################
# Publication -> Funder relationship (via development)
################################################################################

map:PublicationHasFunder a rr:TriplesMap ;
    rdfs:label "Publication Has Funder" ;
    rml:logicalSource map:DevelopmentFunderSource ;
    rr:subjectMap [ rr:template "http://nf-osi.github.com/terms#publication/{publicationId}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate nf:hasFunder ;
        rr:objectMap [ rr:template "http://nf-osi.github.com/terms#funder/{funderId}" ; rr:termType rr:IRI ]
    ] .
