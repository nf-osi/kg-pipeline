@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix nf:   <http://nf-osi.github.com/terms#> .
@prefix map:  <http://nf-osi.github.com/mappings/development-investigator#> .

################################################################################
# Logical source
################################################################################

map:DevelopmentInvestigatorSource a rml:LogicalSource ;
    rml:source "data/csv/development_investigator.csv" ;
    rml:referenceFormulation ql:CSV .

################################################################################
# Development -> Investigator relationship
################################################################################

map:DevelopmentHasInvestigator a rr:TriplesMap ;
    rdfs:label "Development Has Investigator" ;
    rml:logicalSource map:DevelopmentInvestigatorSource ;
    rr:subjectMap [ rml:reference "developmentId" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate nf:hasInvestigator ;
        rr:objectMap [ rml:reference "investigatorId" ; rr:termType rr:IRI ]
    ] .

################################################################################
# Investigator properties
################################################################################

map:InvestigatorCore a rr:TriplesMap ;
    rdfs:label "Investigator Core" ;
    rml:logicalSource map:DevelopmentInvestigatorSource ;
    rr:subjectMap [ rml:reference "investigatorId" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [ rr:predicate rdf:type ; rr:objectMap [ rr:constant nf:Investigator ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:investigatorName ; rr:objectMap [ rml:reference "investigatorName" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:institution ; rr:objectMap [ rml:reference "institution" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:orcid ; rr:objectMap [ rml:reference "orcid" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:investigatorSynapseId ; rr:objectMap [ rr:template "https://www.synapse.org/Profile:{investigatorSynapseId}" ; rr:termType rr:IRI ] ] .

################################################################################
# Resource -> Investigator relationship (via development)
################################################################################

map:ResourceHasInvestigator a rr:TriplesMap ;
    rdfs:label "Resource Has Investigator" ;
    rml:logicalSource map:DevelopmentInvestigatorSource ;
    rr:subjectMap [ rml:reference "resourceId" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate nf:hasInvestigator ;
        rr:objectMap [ rml:reference "investigatorId" ; rr:termType rr:IRI ]
    ] .

################################################################################
# Publication -> Investigator relationship (via development)
################################################################################

map:PublicationHasInvestigator a rr:TriplesMap ;
    rdfs:label "Publication Has Investigator" ;
    rml:logicalSource map:DevelopmentInvestigatorSource ;
    rr:subjectMap [ rml:reference "publicationId" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate nf:hasInvestigator ;
        rr:objectMap [ rml:reference "investigatorId" ; rr:termType rr:IRI ]
    ] .

################################################################################
# Funder -> Investigator relationship (via development)
################################################################################

map:FunderHasInvestigator a rr:TriplesMap ;
    rdfs:label "Funder Has Investigator" ;
    rml:logicalSource map:DevelopmentInvestigatorSource ;
    rr:subjectMap [ rml:reference "funderId" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate nf:hasInvestigator ;
        rr:objectMap [ rml:reference "investigatorId" ; rr:termType rr:IRI ]
    ] .
