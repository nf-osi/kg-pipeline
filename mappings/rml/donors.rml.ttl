@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix fnml: <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno:  <https://w3id.org/function/ontology#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .
@prefix nf:   <http://nf-osi.github.com/terms#> .
@prefix map:  <http://nf-osi.github.com/mappings/portal-donors#> .

################################################################################
# Logical source
################################################################################

map:PortalDonorsSource a rml:LogicalSource ;
    rml:source "data/csv/donors.csv" ;
    rml:referenceFormulation ql:CSV .

################################################################################
# Donor core facts
################################################################################

map:DonorCore a rr:TriplesMap ;
    rdfs:label "Donor Core" ;
    rml:logicalSource map:PortalDonorsSource ;
    rr:subjectMap [
        rr:template "http://nf-osi.github.com/terms#donor/{donorId}" ;
        rr:termType rr:IRI
    ] ;
    rr:predicateObjectMap [ rr:predicate rdf:type ; rr:objectMap [ rr:constant nf:Donor ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:donorId ; rr:objectMap [ rml:reference "donorId" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:parentDonorId ; rr:objectMap [ rml:reference "parentDonorId" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:race ; rr:objectMap [ rml:reference "race" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:sex ; rr:objectMap [ rml:reference "sex" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:age ; rr:objectMap [ rml:reference "age" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:transplantationDonorId ; rr:objectMap [ rml:reference "transplantationDonorId" ; rr:termType rr:IRI ] ] .

################################################################################
# Multi-valued fields (StringList)
################################################################################

map:DonorSpecies a rr:TriplesMap ;
    rdfs:label "Donor Species" ;
    rml:logicalSource map:PortalDonorsSource ;
    rr:subjectMap [
        rr:template "http://nf-osi.github.com/terms#donor/{donorId}" ;
        rr:termType rr:IRI
    ] ;
    rr:predicateObjectMap [
        rr:predicate nf:species ;
        rr:objectMap [
            a fnml:FunctionTermMap ;
            rr:datatype xsd:string ;
            fnml:functionValue [
                a fno:Execution ;
                rml:logicalSource map:PortalDonorsSource ;
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant grel:string_split ; rr:termType rr:IRI ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "species" ; rr:termType rr:Literal ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_sep ;
                    rr:objectMap [ rr:constant "\\|" ; rr:termType rr:Literal ]
                ]
            ]
        ]
    ] .
