@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix nf:   <http://nf-osi.github.com/terms#> .
@prefix map:  <http://nf-osi.github.com/mappings/funders#> .

################################################################################
# Logical source
################################################################################

map:FundersSource a rml:LogicalSource ;
    rml:source "data/csv/funders.csv" ;
    rml:referenceFormulation ql:CSV .

################################################################################
# Funder core facts
################################################################################

map:FunderCore a rr:TriplesMap ;
    rdfs:label "Funder Core" ;
    rml:logicalSource map:FundersSource ;
    rr:subjectMap [ rr:template "http://nf-osi.github.com/terms#funder/{funderId}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [ rr:predicate rdf:type ; rr:objectMap [ rr:constant nf:Funder ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:funderId ; rr:objectMap [ rml:reference "funderId" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:name ; rr:objectMap [ rml:reference "funderName" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ; rr:objectMap [ rml:reference "funderName" ; rr:datatype xsd:string ] ] .
