@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix nf:   <http://nf-osi.github.com/terms#> .
@prefix map:  <http://nf-osi.github.com/mappings/portal-mutation-animal-model#> .

################################################################################
# Logical source
################################################################################

map:PortalMutationAnimalModelSource a rml:LogicalSource ;
    rml:source "data/csv/mutation_animal_model.csv" ;
    rml:referenceFormulation ql:CSV .

################################################################################
# Animal Model -> Mutation relationship
################################################################################

map:AnimalModelHasMutation a rr:TriplesMap ;
    rdfs:label "Animal Model Has Mutation" ;
    rml:logicalSource map:PortalMutationAnimalModelSource ;
    rr:subjectMap [ rr:template "http://nf-osi.github.com/terms#resource/{resourceId}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate nf:hasMutation ;
        rr:objectMap [
            rr:template "http://nf-osi.github.com/terms#mutation/{mutationId}" ;
            rr:termType rr:IRI
        ]
    ] .
