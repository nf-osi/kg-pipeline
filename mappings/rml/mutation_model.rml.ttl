@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix nf:   <http://nf-osi.github.com/terms#> .
@prefix map:  <http://nf-osi.github.com/mappings/mutation-model#> .

################################################################################
# Logical source
################################################################################

map:MutationModelSource a rml:LogicalSource ;
    rml:source "data/csv/mutation_model.csv" ;
    rml:referenceFormulation ql:CSV .

################################################################################
# Resource -> Mutation relationship
################################################################################

# Upstream re-keyed this junction from separate animalModelId / cellLineId
# columns onto a single resourceId, so the two former per-type triples maps
# (map:AnimalModelHasMutation, map:CellLineHasMutation) collapse into one. Any
# tool type can now carry a mutation, not just animal models and cell lines.
map:ResourceHasMutation a rr:TriplesMap ;
    rdfs:label "Resource Has Mutation" ;
    rml:logicalSource map:MutationModelSource ;
    rr:subjectMap [ rr:template "http://nf-osi.github.com/terms#resource/{resourceId}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate nf:hasMutation ;
        rr:objectMap [
            rr:template "http://nf-osi.github.com/terms#mutation/{mutationId}" ;
            rr:termType rr:IRI
        ]
    ] .
