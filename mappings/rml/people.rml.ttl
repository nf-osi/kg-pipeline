@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix map:  <http://nf-osi.github.com/mappings/people#> .

################################################################################
# Logical source
################################################################################

map:PeopleSource a rml:LogicalSource ;
    rml:source "data/csv/people.csv" ;
    rml:referenceFormulation ql:CSV .

################################################################################
# Person core facts
#
# Subject is the Synapse Profile IRI itself (same template used for
# nf:investigatorSynapseId, nf:createdBy, nf:modifiedBy elsewhere), so this
# ingest attaches an ORCID to the same node already referenced across the
# graph rather than minting a separate identity. owl:sameAs asserts the
# Profile IRI and the ORCID IRI denote the same real-world person.
################################################################################

map:PersonCore a rr:TriplesMap ;
    rdfs:label "Person Core" ;
    rml:logicalSource map:PeopleSource ;
    rr:subjectMap [ rr:template "https://www.synapse.org/Profile:{ownerID}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [ rr:predicate rdf:type ; rr:objectMap [ rr:constant biolink:Person ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate owl:sameAs ; rr:objectMap [ rr:template "https://orcid.org/{orcid}" ; rr:termType rr:IRI ] ] .
