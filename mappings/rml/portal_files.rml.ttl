@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix fnml: <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno:  <https://w3id.org/function/ontology#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .
@prefix nf:   <http://nf-osi.github.com/terms#> .
@prefix map:  <http://nf-osi.github.com/mappings/portal-files#> .

################################################################################
# Logical source
################################################################################

map:PortalFilesSource a rml:LogicalSource ;
    rml:source "data/csv/files.csv" ;
    rml:referenceFormulation ql:CSV .

################################################################################
# File core facts
################################################################################

map:FileCore a rr:TriplesMap ;
    rdfs:label "File Core" ;
    rml:logicalSource map:PortalFilesSource ;
    rr:subjectMap [ rml:reference "id" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [ rr:predicate rdf:type ; rr:objectMap [ rr:constant nf:File ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:name ; rr:objectMap [ rml:reference "name" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:studyId ; rr:objectMap [ rml:reference "studyId" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:assay ; rr:objectMap [ rml:reference "assay" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:platform ; rr:objectMap [ rml:reference "platform" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:resourceType ; rr:objectMap [ rml:reference "resourceType" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:dataType ; rr:objectMap [ rml:reference "dataType" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:dataSubtype ; rr:objectMap [ rml:reference "dataSubtype" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:fileFormat ; rr:objectMap [ rml:reference "fileFormat" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:individualID ; rr:objectMap [ rml:reference "individualID" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:nf1Genotype ; rr:objectMap [ rml:reference "nf1Genotype" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:nf2Genotype ; rr:objectMap [ rml:reference "nf2Genotype" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:sex ; rr:objectMap [ rml:reference "sex" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:species ; rr:objectMap [ rml:reference "species" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:cellType ; rr:objectMap [ rml:reference "cellType" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:tissue ; rr:objectMap [ rml:reference "tissue" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:reportMilestone ; rr:objectMap [ rml:reference "reportMilestone" ; rr:datatype xsd:double ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:compoundName ; rr:objectMap [ rml:reference "compoundName" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:experimentalCondition ; rr:objectMap [ rml:reference "experimentalCondition" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:modelSystemName ; rr:objectMap [ rml:reference "modelSystemName" ; rr:datatype xsd:string ] ] .

################################################################################
# Funding Agency as IRI (with space normalization)
################################################################################

map:FileFundingAgency a rr:TriplesMap ;
    rdfs:label "File Funding Agency" ;
    rml:logicalSource map:PortalFilesSource ;
    rr:subjectMap [ rml:reference "id" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate nf:hasFunder ;
        rr:objectMap [
            a fnml:FunctionTermMap ;
            rr:termType rr:IRI ;
            fnml:functionValue [
                a fno:Execution ;
                rml:logicalSource map:PortalFilesSource ;
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant grel:string_replace ; rr:termType rr:IRI ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rr:template "http://nf-osi.github.com/terms#{fundingAgency}" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_find ;
                    rr:objectMap [ rr:constant "%20" ; rr:termType rr:Literal ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_replace ;
                    rr:objectMap [ rr:constant "_" ; rr:termType rr:Literal ]
                ]
            ]
        ]
    ] .

################################################################################
# Multi-value fields (pipe-separated)
################################################################################

map:FileDiagnosis a rr:TriplesMap ;
    rdfs:label "File Diagnosis" ;
    rml:logicalSource map:PortalFilesSource ;
    rr:subjectMap [ rml:reference "id" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate nf:diagnosis ;
        rr:objectMap [
            a fnml:FunctionTermMap ;
            rr:datatype xsd:string ;
            fnml:functionValue [
                a fno:Execution ;
                rml:logicalSource map:PortalFilesSource ;
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant grel:string_split ; rr:termType rr:IRI ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "diagnosis" ; rr:termType rr:Literal ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_sep ;
                    rr:objectMap [ rr:constant "\\|" ; rr:termType rr:Literal ]
                ]
            ]
        ]
    ] .

map:FileSpecimenID a rr:TriplesMap ;
    rdfs:label "File SpecimenID" ;
    rml:logicalSource map:PortalFilesSource ;
    rr:subjectMap [ rml:reference "id" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate nf:specimenID ;
        rr:objectMap [
            a fnml:FunctionTermMap ;
            rr:datatype xsd:string ;
            fnml:functionValue [
                a fno:Execution ;
                rml:logicalSource map:PortalFilesSource ;
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant grel:string_split ; rr:termType rr:IRI ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "specimenID" ; rr:termType rr:Literal ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_sep ;
                    rr:objectMap [ rr:constant "\\|" ; rr:termType rr:Literal ]
                ]
            ]
        ]
    ] .

map:FileTumorType a rr:TriplesMap ;
    rdfs:label "File TumorType" ;
    rml:logicalSource map:PortalFilesSource ;
    rr:subjectMap [ rml:reference "id" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate nf:tumorType ;
        rr:objectMap [
            a fnml:FunctionTermMap ;
            rr:datatype xsd:string ;
            fnml:functionValue [
                a fno:Execution ;
                rml:logicalSource map:PortalFilesSource ;
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant grel:string_split ; rr:termType rr:IRI ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "tumorType" ; rr:termType rr:Literal ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_sep ;
                    rr:objectMap [ rr:constant "\\|" ; rr:termType rr:Literal ]
                ]
            ]
        ]
    ] .
