@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix fnml: <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno:  <https://w3id.org/function/ontology#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .
@prefix nf:   <http://nf-osi.github.com/terms#> .
@prefix map:  <http://nf-osi.github.com/mappings/portal-mutations#> .

################################################################################
# Logical source
################################################################################

map:PortalMutationsSource a rml:LogicalSource ;
    rml:source "data/csv/mutations.csv" ;
    rml:referenceFormulation ql:CSV .

################################################################################
# Mutation core facts
################################################################################

map:MutationCore a rr:TriplesMap ;
    rdfs:label "Mutation Core" ;
    rml:logicalSource map:PortalMutationsSource ;
    rr:subjectMap [
        rr:template "http://nf-osi.github.com/terms#mutation/{mutationId}" ;
        rr:termType rr:IRI
    ] ;
    rr:predicateObjectMap [ rr:predicate rdf:type ; rr:objectMap [ rr:constant nf:Mutation ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:mutationId ; rr:objectMap [ rml:reference "mutationId" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:humanClinVarMutation ; rr:objectMap [ rml:reference "humanClinVarMutation" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:affectedGeneSymbol ; rr:objectMap [ rml:reference "affectedGeneSymbol" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:externalMutationID ; rr:objectMap [ rml:reference "externalMutationID" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:affectedGeneName ; rr:objectMap [ rml:reference "affectedGeneName" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:sequenceVariation ; rr:objectMap [ rml:reference "sequenceVariation" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:chromosome ; rr:objectMap [ rml:reference "chromosome" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:proteinVariation ; rr:objectMap [ rml:reference "proteinVariation" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:animalModelMutation ; rr:objectMap [ rml:reference "animalModelMutation" ; rr:datatype xsd:string ] ] .

################################################################################
# Multi-valued fields (StringList)
################################################################################

map:MutationAlleleType a rr:TriplesMap ;
    rdfs:label "Mutation Allele Type" ;
    rml:logicalSource map:PortalMutationsSource ;
    rr:subjectMap [
        rr:template "http://nf-osi.github.com/terms#mutation/{mutationId}" ;
        rr:termType rr:IRI
    ] ;
    rr:predicateObjectMap [
        rr:predicate nf:alleleType ;
        rr:objectMap [
            a fnml:FunctionTermMap ;
            rr:datatype xsd:string ;
            fnml:functionValue [
                a fno:Execution ;
                rml:logicalSource map:PortalMutationsSource ;
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant grel:string_split ; rr:termType rr:IRI ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "alleleType" ; rr:termType rr:Literal ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_sep ;
                    rr:objectMap [ rr:constant "\\|" ; rr:termType rr:Literal ]
                ]
            ]
        ]
    ] .

map:MutationMethod a rr:TriplesMap ;
    rdfs:label "Mutation Method" ;
    rml:logicalSource map:PortalMutationsSource ;
    rr:subjectMap [
        rr:template "http://nf-osi.github.com/terms#mutation/{mutationId}" ;
        rr:termType rr:IRI
    ] ;
    rr:predicateObjectMap [
        rr:predicate nf:mutationMethod ;
        rr:objectMap [
            a fnml:FunctionTermMap ;
            rr:datatype xsd:string ;
            fnml:functionValue [
                a fno:Execution ;
                rml:logicalSource map:PortalMutationsSource ;
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant grel:string_split ; rr:termType rr:IRI ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "mutationMethod" ; rr:termType rr:Literal ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_sep ;
                    rr:objectMap [ rr:constant "\\|" ; rr:termType rr:Literal ]
                ]
            ]
        ]
    ] .

map:MutationType a rr:TriplesMap ;
    rdfs:label "Mutation Type" ;
    rml:logicalSource map:PortalMutationsSource ;
    rr:subjectMap [
        rr:template "http://nf-osi.github.com/terms#mutation/{mutationId}" ;
        rr:termType rr:IRI
    ] ;
    rr:predicateObjectMap [
        rr:predicate nf:mutationType ;
        rr:objectMap [
            a fnml:FunctionTermMap ;
            rr:datatype xsd:string ;
            fnml:functionValue [
                a fno:Execution ;
                rml:logicalSource map:PortalMutationsSource ;
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant grel:string_split ; rr:termType rr:IRI ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "mutationType" ; rr:termType rr:Literal ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_sep ;
                    rr:objectMap [ rr:constant "\\|" ; rr:termType rr:Literal ]
                ]
            ]
        ]
    ] .
