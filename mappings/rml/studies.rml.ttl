@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix fnml: <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno:  <https://w3id.org/function/ontology#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .
@prefix nf:      <http://nf-osi.github.com/terms#> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix map:  <http://nf-osi.github.com/mappings/portal-studies#> .

################################################################################
# Logical source shared by all triples maps
################################################################################

map:PortalStudiesSource a rml:LogicalSource ;
    rml:source "data/csv/studies_harmonized.csv" ;
    rml:referenceFormulation ql:CSV .

################################################################################
# Study core facts
################################################################################

map:StudyCore a rr:TriplesMap ;
    rdfs:label "Study Core" ;
    rml:logicalSource map:PortalStudiesSource ;
    rr:subjectMap [ rr:template "https://www.synapse.org/Synapse:{studyId}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [ rr:predicate rdf:type ; rr:objectMap [ rr:constant biolink:Study ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:name ; rr:objectMap [ rml:reference "studyName" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ; rr:objectMap [ rml:reference "studyName" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:description ; rr:objectMap [ rml:reference "summary" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [
        rr:predicate nf:initiative ;
        rr:objectMap [
            a fnml:FunctionTermMap ;
            rr:termType rr:IRI ;
            fnml:functionValue [
                a fno:Execution ;
                rml:logicalSource map:PortalStudiesSource ;
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant grel:string_replace ; rr:termType rr:IRI ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rr:template "http://nf-osi.github.com/terms#{initiative}" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_find ;
                    rr:objectMap [ rr:constant "%20" ; rr:termType rr:Literal ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_replace ;
                    rr:objectMap [ rr:constant "_" ; rr:termType rr:Literal ]
                ]
            ]
        ]
    ] ;
    rr:predicateObjectMap [ rr:predicate nf:studyStatus ; rr:objectMap [ rml:reference "studyStatus" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:dataStatus ; rr:objectMap [ rml:reference "dataStatus" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:accessRequirements ; rr:objectMap [ rml:reference "accessRequirements" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nf:acknowledgementStatements ; rr:objectMap [ rml:reference "acknowledgementStatements" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [
        rr:predicate nf:studyFileviewId ;
        rr:objectMap [ rr:template "https://www.synapse.org/Synapse:{studyFileviewId}" ; rr:termType rr:IRI ]
    ] .

################################################################################
# Helper macro for literal splits (expanded inline per property)
################################################################################

map:StudyLeads a rr:TriplesMap ;
    rdfs:label "Study Leads" ;
    rml:logicalSource map:PortalStudiesSource ;
    rr:subjectMap [ rr:template "https://www.synapse.org/Synapse:{studyId}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate nf:studyLeads ;
        rr:objectMap [
            a fnml:FunctionTermMap ;
            rr:datatype xsd:string ;
            fnml:functionValue [
                a fno:Execution ;
                rml:logicalSource map:PortalStudiesSource ;
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant grel:string_split ; rr:termType rr:IRI ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "studyLeads" ; rr:termType rr:Literal ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_sep ;
                    rr:objectMap [ rr:constant "\\|" ; rr:termType rr:Literal ]
                ]
            ]
        ]
    ] .

map:StudyInstitutions a rr:TriplesMap ;
    rdfs:label "Study Institutions" ;
    rml:logicalSource map:PortalStudiesSource ;
    rr:subjectMap [ rr:template "https://www.synapse.org/Synapse:{studyId}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate nf:institutions ;
        rr:objectMap [
            a fnml:FunctionTermMap ;
            rr:datatype xsd:string ;
            fnml:functionValue [
                a fno:Execution ;
                rml:logicalSource map:PortalStudiesSource ;
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant grel:string_split ; rr:termType rr:IRI ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "institutions" ; rr:termType rr:Literal ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_sep ;
                    rr:objectMap [ rr:constant "\\|" ; rr:termType rr:Literal ]
                ]
            ]
        ]
    ] .

