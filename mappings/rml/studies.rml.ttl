map:StudyFundingAgency a rr:TriplesMap ;
    rdfs:label "Study Funding Agency" ;
    rml:logicalSource map:PortalStudiesSource ;
    rr:subjectMap [ rr:template "https://www.synapse.org/Synapse:{studyId}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate nf:hasFunder ;
        rr:objectMap [
            a fnml:FunctionTermMap ;
            rr:termType rr:IRI ;
            fnml:functionValue [
                a fno:Execution ;
                rml:logicalSource map:PortalStudiesSource ;
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant grel:string_split ; rr:termType rr:IRI ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [
                        a fnml:FunctionTermMap ;
                        fnml:functionValue [
                            a fno:Execution ;
                            rml:logicalSource map:PortalStudiesSource ;
                            rr:predicateObjectMap [
                                rr:predicate fno:executes ;
                                rr:objectMap [ rr:constant grel:string_replace ; rr:termType rr:IRI ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate grel:valueParameter ;
                                rr:objectMap [
                                    a fnml:FunctionTermMap ;
                                    fnml:functionValue [
                                        a fno:Execution ;
                                        rml:logicalSource map:PortalStudiesSource ;
                                        rr:predicateObjectMap [
                                            rr:predicate fno:executes ;
                                            rr:objectMap [ rr:constant grel:string_replace ; rr:termType rr:IRI ]
                                        ] ;
                                        rr:predicateObjectMap [
                                            rr:predicate grel:valueParameter ;
                                            rr:objectMap [ rr:template "http://nf-osi.github.com/terms#{fundingAgency}" ]
                                        ] ;
                                        rr:predicateObjectMap [
                                            rr:predicate grel:p_string_find ;
                                            rr:objectMap [ rr:constant "%20" ; rr:termType rr:Literal ]
                                        ] ;
                                        rr:predicateObjectMap [
                                            rr:predicate grel:p_string_replace ;
                                            rr:objectMap [ rr:constant "_" ; rr:termType rr:Literal ]
                                        ]
                                    ]
                                ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate grel:p_string_find ;
                                rr:objectMap [ rr:constant "%7C" ; rr:termType rr:Literal ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate grel:p_string_replace ;
                                rr:objectMap [ rr:constant "%7Chttp://nf-osi.github.com/terms#" ; rr:termType rr:Literal ]
                            ]
                        ]
                    ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_sep ;
                    rr:objectMap [ rr:constant "%7C" ; rr:termType rr:Literal ]
                ]
            ]
        ]
    ] .

map:StudyDataType a rr:TriplesMap ;
    rdfs:label "Study Data Type" ;
    rml:logicalSource map:PortalStudiesSource ;
    rr:subjectMap [ rr:template "https://www.synapse.org/Synapse:{studyId}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate nf:dataType ;
        rr:objectMap [
            a fnml:FunctionTermMap ;
            rr:termType rr:IRI ;
            fnml:functionValue [
                a fno:Execution ;
                rml:logicalSource map:PortalStudiesSource ;
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant grel:string_split ; rr:termType rr:IRI ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "dataTypeIRI" ; rr:termType rr:Literal ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_sep ;
                    rr:objectMap [ rr:constant "\\|" ; rr:termType rr:Literal ]
                ]
            ]
        ]
    ] .

map:StudyRelatedStudies a rr:TriplesMap ;
    rdfs:label "Study Related Studies" ;
    rml:logicalSource map:PortalStudiesSource ;
    rr:subjectMap [ rr:template "https://www.synapse.org/Synapse:{studyId}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate nf:relatedStudies ;
        rr:objectMap [
            a fnml:FunctionTermMap ;
            rr:termType rr:IRI ;
            fnml:functionValue [
                a fno:Execution ;
                rml:logicalSource map:PortalStudiesSource ;
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant grel:string_split ; rr:termType rr:IRI ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [
                        a fnml:FunctionTermMap ;
                        fnml:functionValue [
                            a fno:Execution ;
                            rml:logicalSource map:PortalStudiesSource ;
                            rr:predicateObjectMap [
                                rr:predicate fno:executes ;
                                rr:objectMap [ rr:constant grel:string_replace ; rr:termType rr:IRI ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate grel:valueParameter ;
                                rr:objectMap [ rr:template "https://www.synapse.org/Synapse:{relatedStudies}" ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate grel:p_string_find ;
                                rr:objectMap [ rr:constant "%7C" ; rr:termType rr:Literal ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate grel:p_string_replace ;
                                rr:objectMap [ rr:constant "%7Chttps://www.synapse.org/Synapse:" ; rr:termType rr:Literal ]
                            ]
                        ]
                    ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_sep ;
                    rr:objectMap [ rr:constant "%7C" ; rr:termType rr:Literal ]
                ]
            ]
        ]
    ] .

map:StudyGrantDOI a rr:TriplesMap ;
    rdfs:label "Study Grant DOI" ;
    rml:logicalSource map:PortalStudiesSource ;
    rr:subjectMap [ rr:template "https://www.synapse.org/Synapse:{studyId}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate nf:grantDOI ;
        rr:objectMap [
            a fnml:FunctionTermMap ;
            rr:termType rr:IRI ;
            fnml:functionValue [
                a fno:Execution ;
                rml:logicalSource map:PortalStudiesSource ;
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant grel:string_split ; rr:termType rr:IRI ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [
                        a fnml:FunctionTermMap ;
                        fnml:functionValue [
                            a fno:Execution ;
                            rml:logicalSource map:PortalStudiesSource ;
                            rr:predicateObjectMap [
                                rr:predicate fno:executes ;
                                rr:objectMap [ rr:constant grel:controls_if ; rr:termType rr:IRI ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate grel:bool_b ;
                                rr:objectMap [
                                    a fnml:FunctionTermMap ;
                                    fnml:functionValue [
                                        a fno:Execution ;
                                        rml:logicalSource map:PortalStudiesSource ;
                                        rr:predicateObjectMap [
                                            rr:predicate fno:executes ;
                                            rr:objectMap [ rr:constant grel:string_contains ; rr:termType rr:IRI ]
                                        ] ;
                                        rr:predicateObjectMap [
                                            rr:predicate grel:valueParameter ;
                                            rr:objectMap [ rml:reference "grantDOI" ; rr:termType rr:Literal ]
                                        ] ;
                                        rr:predicateObjectMap [
                                            rr:predicate grel:string_sub ;
                                            rr:objectMap [ rr:constant "://" ; rr:termType rr:Literal ]
                                        ]
                                    ]
                                ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate grel:any_true ;
                                rr:objectMap [ rml:reference "grantDOI" ; rr:termType rr:Literal ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate grel:any_false ;
                                rr:objectMap [ rml:reference "_no_valid_grant_doi" ; rr:termType rr:Literal ]
                            ]
                        ]
                    ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_sep ;
                    rr:objectMap [ rr:constant "\\|" ; rr:termType rr:Literal ]
                ]
            ]
        ]
    ] .
