@prefix prov:  <http://www.w3.org/ns/prov#> .

:DNA_Assay  rdf:type     owl:Class ;
        rdfs:subClassOf  :Assay .

:RNA_Assay  rdf:type     owl:Class ;
        rdfs:subClassOf  :Assay .

:Behavioral_Assay  rdf:type  owl:Class ;
        rdfs:subClassOf  :Assay .

:Proteomics_Assay  rdfs:subClassOf  :Assay ;
        rdf:type         owl:Class .

:Radio_Assay  rdf:type   owl:Class ;
        rdfs:subClassOf  :Assay .

:Cell_Assay  rdf:type    owl:Class ;
        rdfs:subClassOf  :Assay .

:Epigenetics_Assay  rdfs:subClassOf  :Assay ;
        rdf:type         owl:Class .

:Imaging_Assay  rdfs:subClassOf  :Assay ;
        rdf:type         owl:Class .

:Volume_Measurement_Assay
        rdfs:subClassOf  :Assay ;
        rdf:type         owl:Class .

:Drug_Screen  rdf:type   owl:Class ;
        rdfs:subClassOf  :Assay .

:Electrophysiology_Assay
        rdfs:subClassOf  :Assay ;
        rdf:type         owl:Class .

:Clinical_Assay  rdfs:subClassOf  :Assay ;
        rdf:type         owl:Class .

:MRI_Assay  rdfs:subClassOf  :Imaging_Assay ;
        rdf:type         owl:Class .

:Assay_Template  rdfs:subClassOf  :Manifest_Template ;
        rdf:type         owl:Class .

:Non_Assay_Template  rdfs:subClassOf  :Template ;
        rdf:type         owl:Class .

:Manifest_Template  rdf:type  owl:Class ;
        rdfs:subClassOf  :Template .

:Update_Milestone_Report_Template
        rdfs:subClassOf  :Non_Assay_Template ;
        rdf:type         owl:Class .

:Resource  rdf:type  owl:Class .

:Species  rdf:type  owl:Class .

:Model_System  rdf:type  owl:Class .

:Model_Organism  rdfs:subClassOf  :Model_System ;
        rdf:type         owl:Class .

:Cell_Line_Model  rdf:type  owl:Class ;
        rdfs:subClassOf  :Model_System .

:Genotype  rdf:type  owl:Class .

:Methods  rdf:type  owl:Class .

:NGS_Parameter  rdf:type  owl:Class ;
        rdfs:subClassOf  :Methods .

:Unit   rdf:type  owl:Class .

:Time_Unit  rdfs:subClassOf  :Unit ;
        rdf:type         owl:Class .
