        rdf:type         owl:Class .

:Forearm  rdf:type       owl:Class ;
        rdfs:subClassOf  :Body_Part .

:Muscle  rdfs:subClassOf  :Body_Part ;
        rdf:type         owl:Class .

:Finger  rdf:type        owl:Class ;
        rdfs:subClassOf  :Body_Part .

