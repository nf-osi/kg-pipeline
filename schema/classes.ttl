:Illumina_NovaSeq_6000
        rdfs:subClassOf  :Platform ;
        rdfs:comment     "Illumina NovaSeq 6000 performs whole-genome sequencing" ;
        rdf:type         owl:Class .

:Paired_End_1  rdfs:subClassOf  :Read_Pair ;
        rdfs:comment     "One of a pair of sequencing reads in which the two members of the pair are related by originating at either end of a clone insert." ;
        rdf:type         owl:Class .

:Paired_End_2  rdfs:comment  "One of a pair of sequencing reads in which the two members of the pair are related by originating at either end of a clone insert." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Read_Pair .

:Inward_Read  rdfs:comment  "Reads face each other" ;
        rdfs:subClassOf  :Read_Pair_Orientation ;
        rdf:type         owl:Class .

:Outward_Read  rdf:type  owl:Class ;
        rdfs:subClassOf  :Read_Pair_Orientation ;
        rdfs:comment     "Reads face away from each other" .

:Matching_Read  rdfs:comment  "Reads face the same direction" ;
        rdfs:subClassOf  :Read_Pair_Orientation ;
        rdf:type         owl:Class .

:Forward_Read  rdfs:comment  "Read 1 (or unpaired read) comes from the forward strand and read 2 (if applicable) comes from the reverse strand; equivalent to Tophat 'fr-secondstrand' type" ;
        rdfs:subClassOf  :Read_Strand_Origin ;
        rdf:type         owl:Class .

:Reverse_Read  rdfs:comment  "read 1 (or unpaired read) comes from the reverse strand and read 2 (if applicable) comes from the forward strand; equivalent to Tophat 'fr-firststrand' type" ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Read_Strand_Origin .

:GRCh38  rdfs:subClassOf  :Reference_Genome ;
        rdf:type         owl:Class ;
        rdfs:comment     "Genome Reference Consortium Human Build 38" .

:GRCh37  rdfs:subClassOf  :Reference_Genome ;
        rdfs:comment     "Genome Reference Consortium Human Build 37" ;
        rdf:type         owl:Class .

:MMUL1.0  rdfs:subClassOf  :Reference_Genome ;
        rdf:type         owl:Class ;
        rdfs:comment     "Ensembl preliminary assembly Macaca mulatta" .

:HRC    rdfs:comment     "Human haplotype reference panel" ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Reference_Genome .

:Experimental_Data  rdf:type  owl:Class ;
        rdfs:comment     "Any file derived from or pertaining to a scientific experiment. experimentalData annotations should be applied, possibly disease-related" ;
        rdfs:subClassOf  :Resource .

:Result  rdfs:subClassOf  :Resource ;
        rdfs:comment     "Any file that reports data results. Examples include figures, presentations, analysis, etc." ;
        rdf:type         owl:Class .

:Tool   rdfs:subClassOf  :Resource ;
        rdf:type         owl:Class ;
        rdfs:comment     "Any file or link that represents a tool, model, or algorithm; the tool annotations could be applied" .

:Report  rdfs:comment    "a document assembled by an author for the purpose of providing information for the audience. A report is the output of a documenting process and has the objective to be consumed by a specific audience. Topic of the report is on something that has completed. A report is not a single figure. Examples of reports are journal article, patent application, grant progress report, case report (not patient record)." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Resource .

:Single_End  rdf:type    owl:Class ;
        rdfs:subClassOf  :Run_Type ;
        rdfs:comment     "A library preparation that results in the creation of a library of 5' ends of DNA." .

:Paired_End  rdf:type    owl:Class ;
        rdfs:subClassOf  :Run_Type ;
        rdfs:comment     "A library preparation that results in the creation of a library of the 5' and 3' ends of DNA or cDNA fragments using adaptors and endonucleases. The preparation may or may not include cloning process." .

:Human  rdfs:comment     "Homo sapiens with taxonomy ID: 9606 and Genbank common name: human" ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Species .

:Mouse  rdf:type         owl:Class ;
        rdfs:comment     "Mus musculus with taxonomy ID: 10090 and Genbank common name: house mouse" ;
        rdfs:subClassOf  :Species .

:Humanized_Mouse  rdfs:comment  "Mus musculus with taxonomy ID: 10090 and Genbank common name: house mouse" ;
        rdfs:subClassOf  :Species ;
        rdf:type         owl:Class .

:Rat    rdfs:subClassOf  :Species ;
        rdf:type         owl:Class ;
        rdfs:comment     "Rattus with taxonomy ID:10116 and Genbank common name: Norway rat" .

:Fruitfly  rdf:type      owl:Class ;
        rdfs:subClassOf  :Species ;
        rdfs:comment     "Drosophila melanogaster with taxonomy ID: 7227 and Genbank common name: fruit fly" .

:Rhesus_Monkey  rdfs:subClassOf  :Species ;
        rdfs:comment     "Macaca mulatta with taxonomy ID: 9544 and Genbank common name: Rhesus monkey" ;
        rdf:type         owl:Class .

:Chimpanzee  rdfs:comment  "Pan troglodytes with taxonomy ID: 9598 and Genbank common name: chimpanzee" ;
        rdfs:subClassOf  :Species ;
        rdf:type         owl:Class .

:Chicken  rdfs:comment   "The common domestic fowl, Chicken." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Species .

:Pig    rdfs:subClassOf  :Species ;
        rdfs:comment     "Sus scrofa with taxonomy ID: 9823 and Genbank common name: pig" ;
        rdf:type         owl:Class .

:Rabbit  rdfs:comment    "Oryctolagus cuniculus with taxonomy ID: 9986 and Genbank common name: rabbit" ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Species .

:Zebrafish  rdf:type     owl:Class ;
        rdfs:subClassOf  :Species ;
        rdfs:comment     "Danio rerio with taxonomy ID: 7955 and Genbank common name: zebrafish" .

:seconds  rdfs:subClassOf  :Time_Unit ;
        rdf:type         owl:Class .

:minutes  rdfs:subClassOf  :Time_Unit ;
        rdf:type         owl:Class .

:hours  rdf:type         owl:Class ;
        rdfs:subClassOf  :Time_Unit .

:days   rdfs:subClassOf  :Time_Unit ;
        rdf:type         owl:Class .

:weeks  rdfs:subClassOf  :Time_Unit ;
        rdf:type         owl:Class .

:months  rdf:type        owl:Class ;
        rdfs:subClassOf  :Time_Unit .

:Nerve_Tissue  rdfs:subClassOf  :Tissue ;
        rdfs:comment     "Portion of tissue in the nervous system which consists of neurons and glial cells, and may also contain parts of the vasculature." ;
        rdf:type         owl:Class .

:Optic_Nerve  rdfs:comment  "The nerve that carries messages from the retina to the brain." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Tissue .

:Serum  rdf:type         owl:Class ;
        rdfs:comment     "Liquid derived from blood plasma that has clotting factors removed." ;
        rdfs:subClassOf  :Tissue .

:Plasma  rdfs:comment    "Plasma is the fluid (noncellular) portion of the circulating blood, as distinguished from the serum that is the fluid portion of the blood obtained by removal of the fibrin clot and blood cells after coagulation." ;
        rdfs:subClassOf  :Tissue ;
        rdf:type         owl:Class .

:Splenocyte  rdfs:subClassOf  :Tissue ;
        rdfs:comment     "Any leukocyte that is part of a spleen." ;
        rdf:type         owl:Class .

:Blood  rdf:type         owl:Class ;
        rdfs:subClassOf  :Tissue ;
        rdfs:comment     "A fluid that is composed of blood plasma and erythrocytes." .

:Primary_Tumor  rdfs:subClassOf  :Tissue ;
        rdfs:comment     "A primary tumor is the tumor at the initial site of cancer, not where the cancer may have spread or metastasized, called the secondary tumor." ;
        rdf:type         owl:Class .

:Embryonic_Tissue  rdfs:subClassOf  :Tissue ;
        rdf:type         owl:Class ;
        rdfs:comment     "A portion of tissue that is part of an embryo." .

:Meninges  rdf:type      owl:Class ;
        rdfs:subClassOf  :Tissue ;
        rdfs:comment     "The three thin layers of tissue that cover and protect the brain and spinal cord." .

:Bone_Marrow  rdf:type   owl:Class ;
        rdfs:comment     "The soft, fatty, vascular tissue that fills most bone cavities and is the source of red blood cells and many white blood cells." ;
        rdfs:subClassOf  :Tissue .

:Buccal_Mucosa  rdfs:subClassOf  :Tissue ;
        rdfs:comment     "The mucosal membranes located on the inside of the cheek, in the buccal cavity.The inner lining of the cheeks." ;
        rdf:type         owl:Class .

:Dorsal_Root_Ganglion
        rdfs:comment     "Ganglion with sensory function within the vertebral column." ;
        rdfs:subClassOf  :Tissue ;
        rdf:type         owl:Class .

:Cerebral_Cortex  rdfs:comment  "The outer layer of the cerebrum composed of neurons and unmyelinated nerve fibers. It is responsible for memory, attention, consciousness and other higher levels of mental function." ;
        rdfs:subClassOf  :Tissue ;
        rdf:type         owl:Class .

:Sciatic_Nerve  rdf:type  owl:Class ;
        rdfs:subClassOf  :Tissue ;
        rdfs:comment     "The longest single nerve that is formed by the merging of the ventral rami of the L4, L5, and S1 in the pelvis and passes down the lower limb where it divides into the common peroneal and tibial nerves" .

:Whole_Brain_Tissue  rdfs:comment  "Brain tissue not limited to a specific region." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Tissue .

:Buffy_Coat  rdfs:comment  "The middle layer of an anticoagulated blood specimen following separation by centrifugation. It contains most of the white blood cells and platelets." ;
        rdfs:subClassOf  :Tissue ;
        rdf:type         owl:Class .

:Allograft  rdfs:comment  "Tissues, cells, or organs transplanted between genetically different individuals of the same species" ;
        rdfs:subClassOf  :Transplantation ;
        rdf:type         owl:Class .

:Xenograft  rdfs:comment  "Tissues, cells or organs transplanted between animals of different species" ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Transplantation .

:Autograft  rdfs:comment  "Transplant comprised of an individual's own tissue, transferred from one part of the body to another." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Transplantation .

:Isograft  rdfs:subClassOf  :Transplantation ;
        rdfs:comment     "Tissues, cells or organs transplanted between genetically identical individuals" ;
        rdf:type         owl:Class .

:Teratoma  rdf:type      owl:Class ;
        rdfs:comment     "A non-seminomatous germ cell tumor characterized by the presence of various tissues which correspond to the different germinal layers (endoderm, mesoderm, and ectoderm). It occurs in the testis, ovary, and extragonadal sites including central nervous system, mediastinum, lung, and stomach" ;
        rdfs:subClassOf  :Tumor .

:Cutaneous_Neurofibroma
        rdfs:subClassOf  :Tumor ;
        rdf:type         owl:Class ;
        rdfs:comment     "A neurofibroma that grows along small branches of nerves in the dermis in patients with neurofibromatosis. It presents as a solid cutaneous tumor." .

:Plexiform_Neurofibroma
        rdf:type         owl:Class ;
        rdfs:comment     "An elongated and multinodular neurofibroma, formed when the tumor involves either multiple trunks of a plexus or multiple fascicles of a large nerve, such as the sciatic. Some plexiform neurofibromas resemble a bag of worms, others produce a massive ropy enlargement of the nerve." ;
        rdfs:subClassOf  :Tumor .

:Atypical_Neurofibroma
        rdfs:subClassOf  :Tumor ;
        rdfs:comment     "A neurofibroma characterized by the presence of cellular pleomorphism." ;
        rdf:type         owl:Class .

:Malignant_Peripheral_Nerve_Sheath_Tumor
        rdfs:subClassOf  :Tumor ;
        rdf:type         owl:Class ;
        rdfs:comment     "The tumors usually develop along peripheral or cranial nerves and are a central feature of NEUROFIBROMATOSIS 1, where they may occur intracranially or involve spinal roots." .

:Adenocarcinoma  rdfs:subClassOf  :Tumor ;
        rdfs:comment     "A common cancer characterized by the presence of malignant glandular cells. Morphologically, adenocarcinomas are classified according to the growth pattern (e.g., papillary, alveolar) or according to the secreting product (e.g., mucinous, serous)." ;
        rdf:type         owl:Class .

:Carcinoma  rdfs:comment  "A cell type cancer that has_material_basis_in abnormally proliferating cells derives_from epithelial cells." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Tumor .

:Ductal_Carcinoma  rdf:type  owl:Class ;
        rdfs:comment     "Invasive ductal carcinoma (IDC), an infiltrating, malignant and abnormal proliferation of neoplastic cells in the breast tissue, or ductal carcinoma in situ (DCIS), a noninvasive, possibly malignant, neoplasm that is still confined to the milk ducts (lactiferous ducts), where breast cancer most often originates." ;
        rdfs:subClassOf  :Tumor .

:Melanoma  rdfs:subClassOf  :Tumor ;
        rdfs:comment     "A malignant, usually aggressive tumor composed of atypical, neoplastic melanocytes." ;
        rdf:type         owl:Class .

:Glioma  rdfs:subClassOf  :Tumor ;
        rdf:type         owl:Class ;
        rdfs:comment     "A benign or malignant brain and spinal cord tumor that arises from glial cells (astrocytes, oligodendrocytes, ependymal cells). Tumors that arise from astrocytes are called astrocytic tumors or astrocytomas. Tumors that arise from oligodendrocytes are called oligodendroglial tumors. Tumors that arise from ependymal cells are called ependymomas." .

:Low_Grade_Glioma  rdfs:subClassOf  :Tumor ;
        rdfs:comment     "Low grade gliomas are brain tumors that come from two different types of brain cells known as astrocytes and oligodendrocytes." ;
        rdf:type         owl:Class .

:Diffuse_Astrocytoma  rdfs:comment  "Also called Low-Grade or Astrocytoma Grade II is a subtype of glial tumor of the brain or spinal cord showing astrocytic differentiation." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Tumor .

:Anaplastic_Astrocytoma
        rdfs:comment     "A diffusely infiltrating, WHO grade III astrocytoma with focal or dispersed anaplasia, and a marked proliferative potential. It may arise from a low-grade astrocytoma, but it can also be diagnosed at first biopsy, without indication of a less malignant precursor lesion. It has an intrinsic tendency for malignant progression to glioblastoma." ;
        rdfs:subClassOf  :Tumor ;
        rdf:type         owl:Class .

:Glioblastoma  rdfs:comment  "Develop primarily through increasing anaplasia of well differentiated gliomas, mainly astrocytomas or oligodendrogliomas. Typically large and contain cells of different sizes with irrregular nuclei and atypical mitotic figures." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Tumor .

:Schwannoma  rdfs:comment  "A neoplasm that arises from SCHWANN CELLS of the cranial, peripheral, and autonomic nerves." ;
        rdfs:subClassOf  :Tumor ;
        rdf:type         owl:Class .

:Lymphoblastic_Lymphoma
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Tumor ;
        rdfs:comment     "A lymphoma composed of immature small to medium-sized precursor lymphoid cells (lymphoblasts). It includes the B- and T-cell lymphoblastic lymphoma." .

:Meningioma  rdf:type    owl:Class ;
        rdfs:subClassOf  :Tumor ;
        rdfs:comment     "A generally slow growing tumor attached to the dura mater. It is composed of neoplastic meningothelial (arachnoidal) cells." .

:Myeloma  rdfs:subClassOf  :Tumor ;
        rdfs:comment     "A bone marrow cancer that is formed of any one of the bone marrow cells belonging to the granulocytic (neutrophil, eosinophil, basophil), monocytic/macrophage, erythroid, megakaryocytic and mast cell lineages." ;
        rdf:type         owl:Class .

:PDX_Genomics_Assay_Template
        rdfs:comment     "Extends genomicsAssay for PDX experiments" ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Genomics_Assay_Template .

:ScRNA_Seq  rdfs:comment  "A procedure that can determine the nucleotide sequence for all of the RNA transcripts in an amplified nucleotide sample that was derived from a single cell." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Sequencing .

:Update_Milestone_Report_Template
        rdfs:comment     "Defines a metadata template for updating milestone report values in NF studies -- currently a supported feature for NTAP and GFF." ;
        rdfs:subClassOf  :Non_Assay_Template ;
        rdf:type         owl:Class .

:Template  rdfs:comment  "Parent attribute for the manifest template attributes." ;
        rdf:type      owl:Class .

:Normal  rdfs:comment  "No pathological entity observable." ;
        rdf:type      owl:Class .

:Massive_Soft_Tissue_Neurofibroma
        rdfs:subClassOf  :Tumor ;
        rdfs:comment     "Massive soft tissue neurofibroma is characterized  by local infiltration and extension to multiple nerve branches,  as well as substantial overgrowth of adjacent soft tissue and  skin, which distinguishes it from its more benign variant, plexiform neurofibroma. With striking presentation and  severe dysmorphism, massive soft tissue neurofibroma is also labeled elephantiasis neuromatosa. Although considered benign it  shares similarities with malignant peripheral nerve sheath  tumors such as local infiltration and cell mitogenesis. Massive soft tissue neurofibroma is associated with significant morbidity and mortality and almost no response to  conventional chemotherapy and radiotherapy. Surgery is eventually pursued, although bleeding may be a life-threatening  complication as massive soft tissue neurofibromas are highly  vascularized." ;
        rdf:type         owl:Class .

:Diffuse_Infiltrating_Neurofibroma
        rdf:type         owl:Class ;
        rdfs:comment     "Diffuse infiltrating neurofibroma can present as slow-growing, soft tissue masses with overlying skin thickening. These le-sions infiltrate the dermis and the subcutaneous tissue and  characteristically spread along the connective tissues enveloping islands of normal fat. Some of these lesions develop fatty proliferation and can mimic lipomas,  angiolipomas, or angiomyolipomas on imaging and histological evaluation" ;
        rdfs:subClassOf  :Tumor .

:Localized_Neurofibroma
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Tumor .

:Neurofibroma_With_Degenerative_Atypia
        rdfs:subClassOf  :Tumor ;
        rdf:type         owl:Class .

:Neurofibroma  rdfs:subClassOf  :Tumor ;
        rdf:type         owl:Class .

:Mesentery  rdfs:subClassOf  :Tissue ;
        rdf:type         owl:Class .

:Connective_Tissue  rdf:type  owl:Class ;
        rdfs:subClassOf  :Tissue .

:Viably_Frozen  rdfs:subClassOf  :Specimen_State ;
        rdf:type         owl:Class .

:Scalp  rdf:type         owl:Class ;
        rdfs:subClassOf  :Body_Part .

