        rdfs:comment     "Illumina HiSeq X Platform for whole-genome sequencing" ;
        rdf:type         owl:Class .

:Bionano_Irys  rdfs:subClassOf  :Platform ;
        rdfs:comment     "Performs whole genome mapping in a nanoscale fluidic environment enabling the structure of the genome to be imaged and then analyzed at the single molecule level" ;
        rdf:type         owl:Class .

:Infinium_HumanOmniExpressExome
        rdfs:comment     "Infinium HumanOmniExpressExome BeadChip" ;
        rdf:type         owl:Class ;
