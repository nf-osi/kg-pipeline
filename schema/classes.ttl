@prefix :      <http://nf-osi.github.com/terms#> .
@prefix o-rdf: <http://tpl.ottr.xyz/rdf/0.1/> .
@prefix o-rdfs: <http://tpl.ottr.xyz/rdfs/0.2/> .
@prefix pav:   <http://purl.org/pav/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix nfgraph: <http://nf-osi.github.com/templates/0.1/> .
@prefix o-docttr: <http://tpl.ottr.xyz/p/docttr/0.1/> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml:   <http://www.w3.org/XML/1998/namespace> .
@prefix ottr:  <http://ns.ottr.xyz/0.4/> .
@prefix obo:   <http://purl.obolibrary.org/obo/> .
@prefix prov:  <http://www.w3.org/ns/prov#> .

:HPLC   rdf:type         owl:Class ;
        rdfs:comment     "Frequently referred to simply as HPLC, this form of column chromatography is used frequently in biochemistry. The analyte is forced through a column by liquid at high pressure, which decreases the time the separated components remain on the stationary phase." ;
        rdfs:subClassOf  :Proteomics_Assay .

:Elevated_Plus_Maze_Test
        rdfs:comment     "A method which utilizes an experimental apparatus consisting of four arms, usually two enclosed and two open, in the shape of a plus (+) upon which the test animal can walk. The maze is elevated a set distance, for example 40 to 60 centimeters, above the floor or platform upon which the apparatus sits." ;
        rdfs:subClassOf  :Behavioral_Assay ;
        rdf:type         owl:Class .

:Open_Field_Test  rdfs:comment  "A test utilizing an enclosure consisting of a single area bordered by clear or opaque walls, used to measure movement, exploratory behavior, etc of an experimental subject." ;
        rdfs:subClassOf  :Behavioral_Assay ;
        rdf:type         owl:Class .

:Rotarod_Performance_Test
        rdfs:comment     "A method that utilizes a device consisting of a rotating rod the speed of which is mechanically driven and precisely controlled, for instance held constant or accelerated. The rotarod test is often used to measure riding time or endurance in order to evaluate balance, motor coordination or grip strength." ;
        rdfs:subClassOf  :Behavioral_Assay ;
        rdf:type         owl:Class .

:MRNA_Counts  rdf:type   owl:Class ;
        rdfs:comment     "A mRNA profiling assay using digital molecular barcoding technology to quantify target mRNA molecules without the need for amplification." ;
        rdfs:subClassOf  :RNA_Assay .

:High_Content_Screen  rdf:type  owl:Class ;
        rdfs:subClassOf  :Imaging_Assay ;
        rdfs:comment     "An image analysis technique combining automated fluorescence microscopy with multi-parameter quantitative image analysis for the large scale study of cells (cellomics)." .

:Immunocytochemistry  rdf:type  owl:Class ;
        rdfs:subClassOf  :Immuno_Assay ;
        rdfs:comment     "The branch of immunochemistry dealing with cells and cellular activity; the application of immunochemical techniques to cytochemistry." .

:Immunofluorescence  rdfs:comment  "An immunological procedure in which the antibodies are coupled with molecules which fluoresce under ultra violet (UV) light. This makes them particularly suitable for detection of specific antigens in tissues or on cells." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Immuno_Assay .

:Autoradiography  rdfs:subClassOf  :Radio_Assay ;
        rdf:type         owl:Class ;
        rdfs:comment     "A radioactivity detection technique using X- ray film to visualize molecules or fragments of molecules that have been radioactively labeled." .

:Reporter_Gene_Assay  rdfs:comment  "Reporter gene assay measures the gene expression from a reporter gene. The reporter gene is inserted under the control of a foreign promoter or an artificial regulatory element of interest. Reporters include luciferase, beta galactosidase, beta lactamase, chloramphenicol acetyl transferase, or a fluorescent protein." ;
        rdfs:subClassOf  :RNA_Assay ;
        rdf:type         owl:Class .

:Electrochemiluminescence
        rdfs:comment     "A method in which electromagnetic radiation, in the form of light emission, is generated from an electrochemical reaction in a solution." ;
        rdfs:subClassOf  :RNA_Assay ;
        rdf:type         owl:Class .

:Real_Time_PCR  rdfs:subClassOf  :RNA_Assay ;
        rdf:type         owl:Class ;
        rdfs:comment     "An application of PCR that measures the products generated during each cycle of the polymerase chain reaction process in order to determine the starting amount of template in the reaction." .

:In_Vivo_Tumor_Growth
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Volume_Measurement_Assay ;
        rdfs:comment     "The growth of a tumor measured using calipers, ruler, or another similar measurement device. See also \"\"in vivo bioluminescence\"\"." .

:Scale  rdfs:comment     "An instrument or machine for weighing." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Platform .

:Blood_Chemistry_Measurement
        rdfs:subClassOf  :Clinical_Assay ;
        rdf:type         owl:Class ;
        rdfs:comment     "The determination of the measured concentrations of chemical constituents of the blood by assay in a clinical laboratory." .

:In_Vivo_Bioluminescence
        rdf:type         owl:Class ;
        rdfs:comment     "An imaging assay that allows detection of bioluminescence from a living organism or organisms." ;
        rdfs:subClassOf  :Imaging_Assay .

:Immunohistochemistry
        rdf:type         owl:Class ;
        rdfs:comment     "An immunostaining assay to detect and potentially localize antigens within the cells of a tissue section" ;
        rdfs:subClassOf  :Immuno_Assay .

:NOMe-Seq  rdfs:comment  "Nucleosome Occupancy and Methylome Sequencing" ;
        rdfs:subClassOf  :Epigenetics_Assay ;
        rdf:type         owl:Class .

:FIA-MSMS  rdf:type      owl:Class ;
        rdfs:comment     "Flow injection analysis - tandem mass spectrometer" ;
        rdfs:subClassOf  :Proteomics_Assay .

:UPLC-MSMS  rdf:type     owl:Class ;
        rdfs:subClassOf  :Proteomics_Assay ;
        rdfs:comment     "Ultra performance liquid chromatography - tandem mass spectrometer." .

:HPLC-MSMS  rdfs:comment  "An analytical technique wherein high performance liquid chromatography is coupled to tandem mass spectrometry in order to separate, identify, and quantify substances in a sample." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Proteomics_Assay .

:Liquid_Chromatography-Electrochemical_Detection
        rdfs:subClassOf  :Proteomics_Assay ;
        rdfs:comment     "A liquid chromatography method that is sensitive to compounds which can be either reduced or oxidised. The mobile phase passes directly over the working electrode, which is set to the specific potential required for oxidation or reduction. The current produced is then measured." ;
        rdf:type         owl:Class .

:RNA-Seq  rdfs:comment   "RNA Sequencing measurements" ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :RNA_Assay .

:MiRNA-Seq  rdfs:subClassOf  :RNA_Assay ;
        rdf:type         owl:Class ;
        rdfs:comment     "Small RNA measurements collected from RNA-Seq experiments" .

:LC-MSMS  rdfs:subClassOf  :Proteomics_Assay ;
        rdfs:comment     "A method where a sample mixture is first separated by liquid chromatography before being ionised and characterised by mass-to-charge ratio and relative abundance using two mass spectrometers in series" ;
        rdf:type         owl:Class .

:LC-MS  rdf:type         owl:Class ;
        rdfs:subClassOf  :Proteomics_Assay ;
        rdfs:comment     "A method where a sample mixture is first separated by liquid chromatography before being converted into ions which are characterised by their mass-to-charge ratio and relative abundance" .

:LCRNA-Seq  rdfs:subClassOf  :RNA_Assay ;
        rdfs:comment     "Long non-coding RNA measurements collected from RNA-Seq experiments" ;
        rdf:type         owl:Class .

:Whole_Exome_Sequencing
        rdfs:subClassOf  :DNA_Assay ;
        rdf:type         owl:Class ;
        rdfs:comment     "A procedure that can determine the DNA sequence for all of the exons in an individual." .

:Sanger_Sequencing  rdf:type  owl:Class ;
        rdfs:comment     "A DNA sequencing technique in which a mixture of deoxynucleosidetriphosphates (dNTPs) and chain-terminating dNTPs, which are radioactively or fluorescently labeled, are combined within the reaction mixture. Once the reaction is complete, the DNA strands are separated by size, and the labeled chain terminating dNTPs can be read in sequence by the investigator or by a machine." ;
        rdfs:subClassOf  :DNA_Assay .

:ChIP-Seq  rdf:type      owl:Class ;
        rdfs:subClassOf  :Epigenetics_Assay ;
        rdfs:comment     "Chromatin immuno-precipitation followed by sequencing" .

:RNA_Array  rdfs:subClassOf  :RNA_Assay ;
        rdfs:comment     "RNA measurements captured by array technology" ;
        rdf:type         owl:Class .

:SNP_Array  rdfs:subClassOf  :DNA_Assay ;
        rdf:type         owl:Class ;
        rdfs:comment     "SNP measurements captured by array technology" .

:Methylation_Array  rdf:type  owl:Class ;
        rdfs:subClassOf  :Epigenetics_Assay ;
        rdfs:comment     "Methylation data captured by array technology" .

:MiRNA_Array  rdfs:subClassOf  :RNA_Assay ;
        rdf:type         owl:Class ;
        rdfs:comment     "microRNA measurements captured by array technology" .

:Bisulfite_Seq  rdf:type  owl:Class ;
        rdfs:subClassOf  :Epigenetics_Assay ;
        rdfs:comment     "Methylation data captured by sequencing of DNA treated by a bisulfite-based chemical process" .

:ATAC_Seq  rdfs:subClassOf  :Epigenetics_Assay ;
        rdf:type         owl:Class ;
        rdfs:comment     "Open chromatin regions measured by sequencing DNA after assay for transposase-accessible chromatin (ATAC) treatment" .

:HI-C   rdfs:comment     "Chromatin interactions detected by HI-C protocol" ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Epigenetics_Assay .

:Err_Bisulfite_Seq  rdf:type  owl:Class ;
        rdfs:comment     "Data for enriched reduced representation bisulfite sequencing data" ;
        rdfs:subClassOf  :Bisulfite_Seq .

:ISO-Seq  rdf:type       owl:Class ;
        rdfs:comment     "Full isoform sequencing" ;
        rdfs:subClassOf  :RNA_Assay .

:Western_Blot  rdfs:comment  "A multistep process in which a mixture of proteins is separated by gel electrophoresis" ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Proteomics_Assay .

:Whole_Genome_Seq  rdfs:comment  "Laboratory technique to sequence the complete DNA sequence of an organism's genome at a single time" ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :DNA_Assay .

:Polymerase_Chain_Reaction
        rdfs:comment     "A rapid technique for in vitro amplification of specific DNA or RNA sequences, allowing small quantities of short sequences to be analyzed without cloning" ;
        rdfs:subClassOf  :RNA_Assay ;
        rdf:type         owl:Class .

:Cell_Viability_Assay
        rdfs:comment     "This assay type measures the cellular state of living or dying by measuring an indicator of life or death" ;
        rdfs:subClassOf  :Cell_Assay ;
        rdf:type         owl:Class .

:2D_Incucyte_Assay  rdfs:comment  "Cell viability assay on a 2D monolayer model." ;
        rdfs:subClassOf  :Cell_Viability_Assay ;
        rdf:type         owl:Class .

:2D_Cell_Titer_Glo_Assay
        rdfs:subClassOf  :Cell_Viability_Assay ;
        rdf:type         owl:Class ;
        rdfs:comment     "Cell viability assay based on detection of ATP." .

:3D_Microtissue_Viability_Assay
        rdfs:subClassOf  :Cell_Viability_Assay ;
        rdfs:comment     "Cell viability assay on a 3D microtissue model." ;
        rdf:type         owl:Class .

:2D_AlamarBlue_Fluorescence
        rdfs:comment     "Cell viability assay based on detection of AlamarBlue (resazurin). Living cells reduce blue, non-fluorescent resazurin to the red, fluorescent molecule resorufin. The amount of fluorescence or absorbance is proportional to the number of living cells and corresponds to the cell’s metabolic activity. For the fluorescence-based assay, color change and fluorescence can be detected using 560/590 nm (excitation/emission)." ;
        rdfs:subClassOf  :Cell_Viability_Assay ;
        rdf:type         owl:Class .

:2D_AlamarBlue_Absorbance
        rdfs:comment     "Cell viability assay based on detection of AlamarBlue (resazurin). Living cells reduce blue, non-fluorescent resazurin to the red, fluorescent molecule resorufin.  The amount of fluorescence or absorbance is proportional to the number of living cells and corresponds to the cell’s metabolic activity. For the absorbance-based assay, absorbance can be read at 570 nm." ;
        rdfs:subClassOf  :Cell_Viability_Assay ;
        rdf:type         owl:Class .

:In_Vivo_PDX_Viability_Assay
        rdfs:comment     "Assay to assess viability using PDX model." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Cell_Viability_Assay .

:Atomic_Force_Microscopy
        rdfs:subClassOf  :Imaging_Assay ;
        rdfs:comment     "Microscopy which uses a sharp spike (known as a 'tip') mounted on the end of a cantilever to scan the surface of the specimen" ;
        rdf:type         owl:Class .

:Brightfield_Microscopy
        rdfs:comment     "Microscopy where the specimen is illuminated with light transmitted from a source on the opposite side of the specimen from the objective" ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Imaging_Assay .

:Traction_Force_Microscopy
        rdfs:comment     "An experimental method for determining the tractions on the surface of a biological cell by obtaining measurements of the surrounding displacement field within an in vitro extracellular matrix (ECM)" ;
        rdfs:subClassOf  :Imaging_Assay ;
        rdf:type         owl:Class .

:Phase-Contrast_Microscopy
        rdfs:subClassOf  :Imaging_Assay ;
        rdfs:comment     "A simple non-quantitative form of interference microscopy of great utility in visualising live cells. Small differences in optical path length due to differences in refractive index and thickness of structures are visualised as differences in light intensity." ;
        rdf:type         owl:Class .

:NextGeneration_Targeted_Seq
        rdf:type         owl:Class ;
        rdfs:subClassOf  :DNA_Assay ;
        rdfs:comment     "A type of next generation sequencing in which specific genes or portions of genes are targeted for sequencing using amplicon-based workflow." .

:Jumping_Library  rdf:type  owl:Class .

:MIB_MS  rdfs:subClassOf  :Proteomics_Assay ;
        rdf:type         owl:Class ;
        rdfs:comment     "Kinomics assay using multiplexed kinase inhibitor beads and mass spectrometry (MIB/MS)" .

:ScCGI_Seq  rdfs:subClassOf  :Epigenetics_Assay ;
        rdf:type         owl:Class ;
        rdfs:comment     "A method for genome-wide CpG island (CGI) methylation sequencing for single cells (scCGI-seq), combining methylation-sensitive restriction enzyme digestion and multiple displacement amplification for selective detection of methylated CGIs" .

:MudPIT  rdfs:subClassOf  :Proteomics_Assay ;
        rdf:type         owl:Class ;
        rdfs:comment     "MudPIT is a method for rapid and large-scale protein identification by multidimensional liquid chromatography associated with tandem mass spectrometry" .

:Questionnaire  rdfs:comment  "A document with a set of printed or written questions with a choice of answers, devised for the purposes of a survey or statistical study." ;
        rdfs:subClassOf  :Behavioral_Assay ;
        rdf:type         owl:Class .

:DNA_Optical_Mapping  rdfs:comment  "Fluorescent imaging of linearly extended DNA molecules to probe information patterns along the molecules" ;
        rdfs:subClassOf  :Imaging_Assay ;
        rdf:type         owl:Class .

:OxBS-Seq  rdfs:subClassOf  :Epigenetics_Assay ;
        rdf:type         owl:Class ;
        rdfs:comment     "Oxidative bisulfite sequencing (oxBS-Seq) to map 5-methylcytosine and 5-hydroxymethylcytosine" .

:Ribo-Seq  rdfs:comment  "Ribosome profiling (Ribo-Seq)." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :RNA-Seq .

:Positron_Emission_Tomography
        rdf:type         owl:Class ;
        rdfs:comment     "A technique for measuring the gamma radiation produced by collisions of electrons and positrons (anti-electrons) within living tissue." ;
        rdfs:subClassOf  :Imaging_Assay .

:RPPA   rdfs:subClassOf  :Proteomics_Assay ;
        rdf:type         owl:Class ;
        rdfs:comment     "Reverse phase protein array (RPPA) is a an assay that measures multiple protein expression levels in a large number of biological samples simultaneously using high quality antibodies" .

:ELISA  rdf:type         owl:Class ;
        rdfs:comment     "A highly sensitive technique for detecting and measuring antigens or antibodies in a solution; the solution is run over a surface to which immobilized antibodies specific to the substance have been attached, and if the substance is present, it will bind to the antibody layer, and its presence is verified and visualized with an application of antibodies that have been tagged in some way." ;
        rdfs:subClassOf  :Proteomics_Assay .

:LTP    rdf:type         owl:Class ;
        rdfs:subClassOf  :Electrophysiology_Assay ;
        rdfs:comment     "Any measurable or observable characteristic related to the persistent robust synaptic response induced by synchronous stimulation of pre- and postsynaptic cells." .

:LFP    rdfs:comment     "An extracellular electrophysiology assay where a microelectrode is placed in the extracellular space of brain tissue to measure action potential and compared to an electrode either outside or inside that tissue." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Electrophysiology_Assay .

:Whole-cell_Patch_Clamp
        rdfs:comment     "A patch-clamp assay where the electrode is left in place on the cell, as in cell-attached recordings, but the membrane patch has been perforated, providing access from the interior of the pipette to the intracellular space of the cell. Measurements made with this technique involve recording currents through multiple channels simultaneously, over the membrane of the entire cell." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Cell_Assay .

:Sandwich_ELISA  rdfs:subClassOf  :ELISA ;
        rdfs:comment     "The sandwich ELISA measures the amount of antigen between two layers of antibodies. The antigens to be measured must contain at least two antigenic sites, capable of binding to antibody, since at least two antibodies act in the sandwich. So sandwich assays are restricted to the quantitation of multivalent antigens such as proteins or polysaccharides. Sandwich ELISAs for quantitation of antigens are especially valuable when the concentration of antigens is low and/or they are contained in high concentrations of contaminating protein." ;
        rdf:type         owl:Class .

:Laser_Speckle_Imaging
        rdfs:comment     "A noninvasive, non-scanning optical imaging technique that provides full-field visualization of blood flow to the tissue being imaged, which provides information about tissue perfusion and the efficiency of disease treatment." ;
        rdfs:subClassOf  :Imaging_Assay ;
        rdf:type         owl:Class .

:Genotyping_Assay  rdf:type  owl:Class ;
        rdfs:comment     "The determination of the DNA sequence of an individual." ;
        rdfs:subClassOf  :DNA_Assay .

:TMT_Quantitation  rdfs:subClassOf  :Proteomics_Assay ;
        rdf:type         owl:Class ;
        rdfs:comment     "An isobaric labeling technique that uses tags containing four regions with the same total molecular weights and structure, so that during chromatographic or electrophoretic separation and in single MS mode, molecules labelled with different tags are indistinguishable." .

:Label_Free_Mass_Spectrometry
        rdfs:comment     "A mass spectrometry assay that allows for measurement for endogenous targets in live cell assays, and eliminates the need for tags, dyes, or specialized reagents or engineered cells." ;
        rdfs:subClassOf  :Proteomics_Assay ;
        rdf:type         owl:Class .

:Cell_Count  rdfs:subClassOf  :Cell_Assay ;
        rdf:type         owl:Class ;
        rdfs:comment     "A procedure to determine the number of cells in a sample. Also used to mean the result of such a procedure." .

:Immuno_Assay  rdfs:comment  "Generic immunology assay" ;
        rdfs:subClassOf  :Assay ;
        rdf:type         owl:Class .

:Conventional_MRI  rdf:type  owl:Class ;
        rdfs:comment     "Magnetic resonance imaging using standard protocols for high resolution structural and anatomic characterization, including T1 weighted, T2 weighted, fluid attenuated inversion recovery (FLAIR), and gadolinium-enhanced sequences. [  NCI  ]" ;
        rdfs:subClassOf  :MRI_Assay .

:Functional_MRI  rdf:type  owl:Class ;
        rdfs:subClassOf  :MRI_Assay ;
        rdfs:comment     "The principle of functional MRI imaging is to take a series of images of an organ in quick succession and to statistically analyze the images for differences among them. Most commonly used in studies of brain function. [  NCI  ]" .

:Magnetic_Resonance_Spectroscopy
        rdfs:subClassOf  :Radio_Assay ;
        rdfs:comment     "Detection and measurement of the resonant spectra of molecular species in a tissue or sample." ;
        rdf:type         owl:Class .

:MRI_Sequence  rdfs:comment  "The scanning sequence/modality that is used for a conventional MRI scan." ;
        rdf:type      owl:Class .

:T1-weighted  rdf:type   owl:Class ;
        rdfs:subClassOf  :MRI_Sequence .

:T2-weighted  rdfs:subClassOf  :MRI_Sequence ;
        rdf:type         owl:Class .

:PD-weighted  rdf:type   owl:Class ;
        rdfs:subClassOf  :MRI_Sequence .

:Short_Tau_Inversion_Recovery
        rdf:type         owl:Class ;
        rdfs:subClassOf  :MRI_Sequence .

:Head   rdfs:subClassOf  :Body_Part ;
        rdf:type         owl:Class ;
        rdfs:comment     "The head is the anterior-most division of the body." .

:Schwann_Cell_Precursor
        rdfs:comment     "A giioblast cell that develops from a migratory neural crest cell. The SCP is embedded among neurons (axons) with minimal extracellular spaces separating them from nerve cell membranes and has no basal lamina. In rodents SCPs are the only cells in the Schwann cell linage that expresses Cdh19." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Primary_Cell .

:B-lymphocytes  rdf:type  owl:Class ;
        rdfs:subClassOf  :Primary_Cell ;
        rdfs:comment     "A lymphocyte of B lineage with the phenotype CD19-positive and surface immunoglobulin-positive." .

:Embryonic_Stem_Cells
        rdfs:subClassOf  :Primary_Cell ;
        rdf:type         owl:Class ;
        rdfs:comment     "Embryonic stem (ES) cells are cells derived from the inner cell mass of the early embryo that can be propagated indefinitely in the primitive undifferentiated state while remaining pluripotent." .

:iPSC   rdfs:comment     "Induced pluripotent stem cells (iPS cells or iPSCs) are a type of pluripotent stem cell artificially derived from a non-pluripotent cell." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :iPSC .

:iPSC-derived_telencephalic_organoids
        rdf:type         owl:Class ;
        rdfs:subClassOf  :iPSC ;
        rdfs:comment     "three-dimensional neural cultures (organoids) derived from induced pluripotent stem cells." .

:GABAergic_neurons  rdfs:subClassOf  :Primary_Cell ;
        rdf:type         owl:Class ;
        rdfs:comment     "A neuron that uses GABA as a vesicular neurotransmitter." .

:monocytes  rdfs:subClassOf  :Primary_Cell ;
        rdf:type         owl:Class ;
        rdfs:comment     "Myeloid mononuclear recirculating leukocyte that can act as a precursor of tissue macrophages, osteoclasts and some populations of tissue dendritic cells." .

:microglia  rdfs:comment  "The small, non-neural, interstitial cells of mesodermal origin that form part of the supporting structure of the central nervous system." ;
        rdfs:subClassOf  :Primary_Cell ;
        rdf:type         owl:Class .

:macrophages  rdf:type   owl:Class ;
        rdfs:subClassOf  :Primary_Cell ;
        rdfs:comment     "A mononuclear phagocyte present in variety of tissues, typically differentiated from monocytes, capable of phagocytosing a variety of extracellular particulate material, including immune complexes, microorganisms, and dead cells." .

:astrocytes  rdfs:subClassOf  :Primary_Cell ;
        rdf:type         owl:Class ;
        rdfs:comment     "Astrocytes (from 'star' cells) are irregularly shaped with many long processes, including those with end-feet which form the glial (limiting) membrane and directly and indirectly contribute to the blood-brain barrier." .

:SH-SY5Y  rdf:type       owl:Class ;
        rdfs:subClassOf  :Cell_Line ;
        rdfs:comment     "Human neuroblastoma clonal subline of the neuroepithelioma cell line SK-N-SH that had been established in 1970 from the bone marrow biopsy of a 4-year-old girl with metastatic neuroblastoma." .

<http://nf-osi.github.com/terms#GLUtamatergic_neurons>
        rdfs:comment     "Have Glutamate receptors, which are synaptic receptors located primarily on the membranes of neuronal cells. Glutamate (the conjugate base of glutamic acid) is abundant in the human body, but particularly in the nervous system and especially prominent in the human brain." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Primary_Cell .

<http://nf-osi.github.com/terms#NeuN+>
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Primary_Cell ;
        rdfs:comment     "Is a neuronal nuclear antigen that is commonly used as a biomarker for neurons and NeuN immunoreactivity has been widely used to identify neurons in tissue culture to measure the neuron(positive)/glia(negative) ratio in brain regions." .

:NeuN-  rdfs:subClassOf  :Primary_Cell ;
        rdf:type         owl:Class ;
        rdfs:comment     "Is a neuronal nuclear antigen that is commonly used as a biomarker for neurons and NeuN immunoreactivity has been widely used to identify neurons in tissue culture to measure the neuron(positive)/glia(negative) ratio in brain regions." .

:epithelial  rdfs:subClassOf  :Primary_Cell ;
        rdfs:comment     "Somatic cells that cover the surface of the body and line its cavities." ;
        rdf:type         owl:Class .

:epithelial-like  rdfs:subClassOf  :Primary_Cell ;
        rdf:type         owl:Class ;
        rdfs:comment     "In cell morphology, epithelial-like cells are polygonal in shape with more regular dimensions, and grow attached to a substrate in discrete patches." .

:fibroblast  rdf:type    owl:Class ;
        rdfs:comment     "A connective tissue cell which secretes an extracellular matrix rich in collagen and other macromolecules. Flattened and irregular in outline with branching processes; appear fusiform or spindle-shaped." ;
        rdfs:subClassOf  :Primary_Cell .

:round  rdfs:subClassOf  :Primary_Cell ;
        rdfs:comment     "A phenotype observation at the level of the cell shape where the cell is round" ;
        rdf:type         owl:Class .

:lymphoblast  rdfs:subClassOf  :Primary_Cell ;
        rdfs:comment     "Often referred to as a blast cell. Unlike other usages of the suffix -blast a lymphoblast is a further differentiation of a lymphocyte, T- or B-, occasioned by an antigenic stimulus. The lymphoblast usually develops by enlargement of a lymphocyte, active re-entry to the S phase of the cell cycle, mitogenesis and production of much m-RNA and ribosomes." ;
        rdf:type         owl:Class .

:polygonal  rdfs:comment  "A polygonal face is a polygon bounded by a circuit of polygon edges, and includes the flat (plane) region inside the boundary." ;
        rdf:type      owl:Class .

:CD8_T-Cells  rdfs:subClassOf  :Primary_Cell ;
        rdf:type         owl:Class ;
        rdfs:comment     "Is a T lymphocyte (a type of white blood cell) that kills cancer cells, cells that are infected (particularly with viruses), or cells that are damaged in other ways." .

:arachnoid  rdfs:comment  "An arachnoid mater is a delicate membrane that encloses the spinal cord and brain and lies between the pia mater and dura mater." ;
        rdfs:subClassOf  :Tissue ;
        rdf:type         owl:Class .

:meningioma  rdfs:comment  "A central nervous system cancer tissue that are manifested in the central nervous system and arise from the arachnoid 'cap' cells of the arachnoid villi in the meninges." ;
        rdfs:subClassOf  :Tissue ;
        rdf:type         owl:Class .

:schwannoma  rdf:type    owl:Class ;
        rdfs:comment     "A neoplasm that arises from SCHWANN CELLS of the cranial, peripheral, and autonomic nerves." ;
        rdfs:subClassOf  :Tissue .

:oligodendrocyte  rdfs:subClassOf  :Cell ;
        rdfs:comment     "A class of large neuroglial (macroglial) cells in the central nervous system. Form the insulating myelin sheath of axons in the central nervous system." ;
        rdf:type         owl:Class .

:schwann  rdfs:comment   "Schwann cells are a variety of glial cell that keep peripheral nerve fibres (both myelinated and unmyelinated) alive." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Cell .

:iPSC-derived_neuron  rdfs:subClassOf  :iPSC ;
        rdf:type         owl:Class .

:iPSC-derived_glia  rdf:type  owl:Class ;
        rdfs:subClassOf  :iPSC .

:iPSC-derived_astrocytes
        rdfs:subClassOf  :iPSC ;
        rdf:type         owl:Class .

:monocyte-derived_microglia
        rdfs:subClassOf  :Primary_Cell ;
        rdf:type         owl:Class .

:iPSC-derived_neuronal_progenitor_cell
        rdf:type         owl:Class ;
        rdfs:subClassOf  :iPSC .

:CD138_positive  rdfs:subClassOf  :Cell ;
        rdf:type         owl:Class .

:CNON   rdfs:comment     "Cultured Neuronal cells derived from Olfactory Neuroepithelium" ;
        rdfs:subClassOf  :Cell ;
        rdf:type         owl:Class .

:Teratoma  rdfs:subClassOf  :Tumor ;
        rdf:type         owl:Class ;
        rdfs:comment     "A non-seminomatous germ cell tumor characterized by the presence of various tissues which correspond to the different germinal layers (endoderm, mesoderm, and ectoderm). It occurs in the testis, ovary, and extragonadal sites including central nervous system, mediastinum, lung, and stomach" .

:Cy5    rdfs:comment     "Fluorescent dye used for the red channel on an array" ;
        rdfs:subClassOf  :Channel ;
        rdf:type         owl:Class .

:Cy3    rdfs:subClassOf  :Channel ;
        rdf:type         owl:Class ;
        rdfs:comment     "Fluorescent dye used for the green channel on an array" .

:Gene_Symbol  rdfs:comment  "A unique gene name approved by an organism specific nomenclature committee." ;
        rdf:type      owl:Class .

:Clinical_Curated_Data
        rdfs:comment  "Data obtained through patient examination or treatment." ;
        rdf:type      owl:Class .

:Gene_Function  rdfs:comment  "A term that expresses the function of a gene product." ;
        rdf:type      owl:Class .

:Chemical_Descriptor  rdfs:comment  "A chemical descriptor is a data item (quantity or value) about a chemical entity that conforms to a specification for how it is calculated, measured or recorded." ;
        rdf:type      owl:Class .

:Normalized  rdfs:subClassOf  :Data ;
        rdfs:comment     "A data set that is produced as the output of a normalization data transformation." ;
        rdf:type         owl:Class .

:Data_Matrix  rdf:type   owl:Class ;
        rdfs:comment     "A file of data containing multiple values for multiple samples." ;
        rdfs:subClassOf  :Data .

:Raw    rdfs:comment     "A data file produced by an instrument, or one with very little subsequent processing." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Data .

:Processed  rdf:type     owl:Class ;
        rdfs:subClassOf  :Data ;
        rdfs:comment     "A file of data generated from running one or more bioinformatics methods on a raw file." .

:Metadata  rdfs:subClassOf  :Data ;
        rdf:type         owl:Class ;
        rdfs:comment     "A file of clinical, technical, or other parameters that describe a dataset." .

:Representative  rdfs:subClassOf  :Data ;
        rdfs:comment     "An activity that stands as an equivalent of something or results in an equivalent; typical of, or the same as, others in a larger group of people or things." ;
        rdf:type         owl:Class .

:Raw_Counts  rdfs:comment  "The number or amount of something." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Data .

:Volume  rdfs:comment    "The amount of three dimensional space occupied by an object or the capacity of a space or container." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Data .

:Weight  rdf:type        owl:Class ;
        rdfs:subClassOf  :Data ;
        rdfs:comment     "The vertical force exerted by a mass as a result of gravity." .

:Pharmacokinetic_Study
        rdfs:comment     "A study of the process by which a drug is absorbed, distributed, metabolized, and eliminated by the body." ;
        rdfs:subClassOf  :Data ;
        rdf:type         owl:Class .

:Genomic_Variants  rdfs:comment  "Genomic alterations, including single nucleotide polymorphisms, short indels and structural variants, in a genome sequence." ;
        rdf:type      owl:Class .

:Behavior_Process  rdfs:comment  "The action, reaction, or performance of an organism in response to external or internal stimuli." ;
        rdf:type      owl:Class .

:Metabolomics  rdfs:comment  "The systematic study of metabolites, the chemical processes they are involved, and the chemical fingerprints of specific cellular processes in a whole cell, tissue, organ or organism." ;
        rdf:type      owl:Class .

:Image  rdfs:comment  "Biological or biomedical data that has been rendered into an image." ;
        rdf:type      owl:Class .

:Gene_Expression  rdfs:comment  "The analysis of levels and patterns of synthesis of gene products (proteins and functional RNA) including interpretation in functional terms of gene expression data." ;
        rdf:type      owl:Class .

:Isoform_Expression  rdf:type  owl:Class ;
        rdfs:comment  "Expression of protien isoforms formed from alternative splicings or other post-translational modifications of a single gene through RNA splicing mechanisms." .

:Proteomics  rdf:type  owl:Class ;
        rdfs:comment  "Protein and peptide identification, especially in the study of whole proteomes of organisms." .

:Kinomics  rdfs:comment  "Kinomics is the study of protein kinases and protein kinase signaling." ;
        rdf:type      owl:Class .

:Drug_Screen  rdf:type  owl:Class ;
        rdfs:comment  "Information on drug sensitivity and molecular markers of drug response" .

:Drug_Combination_Screen
        rdf:type      owl:Class ;
        rdfs:comment  "Information on drug sensitivity of more than one compound" .

:Cellular_Physiology  rdf:type  owl:Class .

:Chromatin_Activity  rdfs:comment  "Chromatin activity that allow access of condensed genomic DNA and potentially control gene expression." ;
        rdf:type      owl:Class .

:Survey_Data  rdfs:comment  "A data set that contains the outcome of a survey." ;
        rdf:type      owl:Class .

:Network  rdfs:comment  "An interconnected system of things or people." ;
        rdf:type      owl:Class .

:Clinical_Data  rdf:type  owl:Class ;
        rdfs:comment  "Data obtained through patient examination or treatment." .

:Electrophysiology  rdf:type  owl:Class ;
        rdfs:comment  "Data generated from an electrophysiology assay." .

:Mask_Image  rdfs:comment  "Image used as the mask for an image processing operation, such as subtraction." ;
        rdf:type      owl:Class .

:Neurofibromatosis_Type_1
        rdfs:comment     "(NF1) - A disease characterized by patches of skin pigmentation (cafe-au-lait spots), Lisch nodules of the iris, tumors in the peripheral nervous system and fibromatous skin tumors. Individuals with the disorder have increased susceptibility to the development of benign and malignant tumors." ;
        rdfs:subClassOf  :Diagnosis ;
        rdf:type         owl:Class .

:Neurofibromatosis_Type_2
        rdfs:subClassOf  :Diagnosis ;
        rdf:type         owl:Class ;
        rdfs:comment     "(NF2) - Genetic disorder characterized by bilateral vestibular schwannomas (formerly called acoustic neuromas), schwannomas of other cranial and peripheral nerves, meningiomas, and ependymomas. It is inherited in an autosomal dominant fashion with full penetrance." .

:Schwannomatosis  rdfs:subClassOf  :Diagnosis ;
        rdf:type         owl:Class ;
        rdfs:comment     "A rare genetic disorder characterized by the presence of multiple schwannomas." .

:Not_Applicable  rdf:type  owl:Class ;
        rdfs:comment  "An NF diagnosis (e.g. NF1, NF2, or Schwannomatosis) does not apply here." .

:Sporadic_Schwannoma  rdf:type  owl:Class ;
        rdfs:comment     "A" ;
        rdfs:subClassOf  :Diagnosis .

:FACS   rdf:type         owl:Class ;
        rdfs:subClassOf  :Dissociation_Method .

:Drop-Seq  rdfs:subClassOf  :Dissociation_Method ;
        rdf:type         owl:Class .

:InDrop  rdfs:subClassOf  :Dissociation_Method ;
        rdf:type         owl:Class .

:Mouth_Pipette  rdfs:subClassOf  :Dissociation_Method ;
        rdf:type         owl:Class .

:Enzymatic  rdf:type     owl:Class ;
        rdfs:subClassOf  :Dissociation_Method .

:Mechanical  rdfs:subClassOf  :Dissociation_Method ;
        rdf:type         owl:Class .

:Single_Molecule_Drug_Screen
        rdfs:subClassOf  :Drug_Screen ;
        rdfs:comment     "An experiment in which a single molecule was used in an assay" ;
        rdf:type         owl:Class .

:Small_Molecule_Library_Screen
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Drug_Screen ;
        rdfs:comment     "High throughput sample analysis of small molecules for purpose such as drug discovery, or biochemical, genetic or pharmacological tests." .

:Combination_Library_Screen
        rdfs:comment     "High throughput sample analysis of collections of compounds that provide a variety of chemically diverse structures that can be used to identify structure types that have affinity with pharmacological targets." ;
        rdfs:subClassOf  :Drug_Screen ;
        rdf:type         owl:Class .

:Combination_Screen  rdf:type  owl:Class ;
        rdfs:subClassOf  :Drug_Screen .

:Male   rdfs:comment  "A person who belongs to the sex that normally produces sperm. The term is used to indicate biological sex distinctions, cultural gender role distinctions, or both." ;
        rdf:type      owl:Class .

:Female  rdf:type     owl:Class ;
        rdfs:comment  "A person who belongs to the sex that normally produces ova. The term is used to indicate biological sex distinctions, or cultural gender role distinctions, or both." .

:Unknown  rdfs:comment  "Not known, observed, recorded; or reported as unknown by the data contributor." ;
        rdf:type      owl:Class .

:bash_script  rdfs:comment  "Bash Shell Script" ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Open_Format .

:bedgraph  rdfs:subClassOf  :Open_Format ;
        rdf:type         owl:Class ;
        rdfs:comment     "Holds a tab-delimited chromosome /start /end / datavalue dataset. The bedGraph format allows display of continuous-valued data in track format. This display type is useful for probability scores and transcriptome data" .

:ai     rdf:type         owl:Class ;
        rdfs:comment     "Adobe Illustrator format" ;
        rdfs:subClassOf  :Proprietary_Format .

:idx    rdfs:subClassOf  :File_Format ;
        rdf:type         owl:Class .

:idat   rdfs:comment     "Proprietary file format for (raw) BeadArray data used by genomewide profiling platforms from Illumina Inc. This format is output directly from the scanner and stores summary intensities for each probe-type on an array." ;
        rdfs:subClassOf  :Proprietary_Format ;
        rdf:type         owl:Class .

:bam    rdfs:comment     "BAM format, the binary, BGZF-formatted compressed version of SAM format for alignment of nucleotide sequences (e.g. sequencing reads) to (a) reference sequence(s)" ;
        rdfs:subClassOf  :Open_Format ;
        rdf:type         owl:Class .

:bai    rdfs:comment     "BAM indexing format" ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Open_Format .

:excel  rdf:type         owl:Class ;
        rdfs:subClassOf  :Proprietary_Format ;
        rdfs:comment     "Microsoft Excel spreadsheet format" .

:powerpoint  rdfs:comment  "Microsoft Powerpoint slide format" ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Proprietary_Format .

:tif    rdf:type         owl:Class ;
        rdfs:subClassOf  :Preferred_Open_Format ;
        rdfs:comment     "Tagged Image File Format, abbreviated TIFF or TIF, is a computer file format for storing raster graphics images" .

:png    rdf:type         owl:Class ;
        rdfs:subClassOf  :Open_Format ;
        rdfs:comment     "PNG is a file format for image compression" .

:doc    rdfs:subClassOf  :Proprietary_Format ;
        rdfs:comment     "Microsoft Word document format" ;
        rdf:type         owl:Class .

:pdf    rdf:type         owl:Class ;
        rdfs:comment     "Portable Document Format" ;
        rdfs:subClassOf  :Proprietary_Format .

:hdf    rdfs:subClassOf  :Open_Format ;
        rdfs:comment     "Hierarchical Data Format (HDF) is a set of file formats (HDF4, HDF5) designed to store and organize large amounts of data" ;
        rdf:type         owl:Class .

:fasta  rdfs:subClassOf  :Preferred_Open_Format ;
        rdfs:comment     "FASTA format is a text-based format for representing either nucleotide sequences or peptide sequences, in which nucleotides or amino acids are represented using single-letter codes" ;
        rdf:type         owl:Class .

:fastq  rdfs:subClassOf  :Preferred_Open_Format ;
        rdfs:comment     "FASTQ format is a text-based format for storing both a biological sequence (usually nucleotide sequence) and its corresponding quality scores. Both the sequence letter and quality score are each encoded with a single ASCII character for brevity" ;
        rdf:type         owl:Class .

:sam    rdfs:subClassOf  :Open_Format ;
        rdfs:comment     "Sequence Alignment/Map (SAM) format for alignment of nucleotide sequences (e.g. sequencing reads) to (a) reference sequence(s)" ;
        rdf:type         owl:Class .

:vcf    rdfs:comment     "Variant Call Format (VCF) for sequence variation (indels, polymorphisms, structural variation)" ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Open_Format .

:bcf    rdf:type         owl:Class ;
        rdfs:subClassOf  :Open_Format ;
        rdfs:comment     "BCF, the binary version of Variant Call Format (VCF) for sequence variation (indels, polymorphisms, structural variation)" .

:maf    rdf:type         owl:Class ;
        rdfs:subClassOf  :Open_Format ;
        rdfs:comment     "Multiple Alignment Format (MAF) supporting alignments of whole genomes with rearrangements, directions, multiple pieces to the alignment, and so forth" .

:bed    rdfs:subClassOf  :Open_Format ;
        rdfs:comment     "Browser Extensible Data (BED) format of sequence annotation track, typically to be displayed in a genome browser" ;
        rdf:type         owl:Class .

:chp    rdf:type         owl:Class ;
        rdfs:comment     "CHP file contains probe set analysis results generated from Affymetrix software" ;
        rdfs:subClassOf  :Proprietary_Format .

:cel    rdfs:comment     "Format of Affymetrix data file of information about (raw) expression levels of the individual probes" ;
        rdfs:subClassOf  :Proprietary_Format ;
        rdf:type         owl:Class .

:sif    rdf:type         owl:Class ;
        rdfs:subClassOf  :File_Format ;
        rdfs:comment     "SIF (simple interaction file) Format - a network/pathway format used for instance in cytoscape" .

:tsv    rdfs:comment     "Tabular data represented as tab-separated values in a text file" ;
        rdfs:subClassOf  :Preferred_Open_Format ;
        rdf:type         owl:Class .

:csv    rdf:type         owl:Class ;
        rdfs:comment     "Tabular data represented as comma-separated values in a text file" ;
        rdfs:subClassOf  :Preferred_Open_Format .

:txt    rdfs:comment     "Textual format" ;
        rdfs:subClassOf  :Preferred_Open_Format ;
        rdf:type         owl:Class .

:plink  rdfs:comment     "Any Plink file format (MAP/PED/BED/BIM/FAM)" ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Open_Format .

:bigwig  rdfs:comment    "bigWig format for large sequence annotation tracks that consist of a value for each sequence position" ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Open_Format .

:wiggle  rdf:type        owl:Class ;
        rdfs:comment     "Wiggle format (WIG) of a sequence annotation track that consists of a value for each sequence position" ;
        rdfs:subClassOf  :Open_Format .

:gct    rdfs:subClassOf  :File_Format ;
        rdfs:comment     "Tab-delimited text files of GenePattern that contain a column for each sample, a row for each gene, and an expression value for each gene in each sample" ;
        rdf:type         owl:Class .

:bgzip  rdf:type         owl:Class ;
        rdfs:subClassOf  :Open_Format ;
        rdfs:comment     "Blocked GNU Zip format" .

:zip    rdfs:comment     "zip is a format standard of a digital entity that is conformant with the PKWARE .ZIP file format specification" ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Open_Format .

:seg    rdf:type         owl:Class ;
        rdfs:subClassOf  :Open_Format ;
        rdfs:comment     "SEG file (segmented data; .seg or .cbs) is a tab-delimited text file that lists loci and associated numeric values" .

:html   rdfs:comment     "HTML format" ;
        rdfs:subClassOf  :File_Format ;
        rdf:type         owl:Class .

:mov    rdfs:subClassOf  :File_Format ;
        rdf:type         owl:Class ;
        rdfs:comment     "A video file format with the .mov extension" .

:hyperlink  rdfs:comment  "A reference (link) from some point in one hypertext document to another document, another place in the same document, or a website." ;
        rdfs:subClassOf  :File_Format ;
        rdf:type         owl:Class .

:svs    rdf:type         owl:Class ;
        rdfs:subClassOf  :File_Format ;
        rdfs:comment     "A single-file pyramidal tiled TIFF, with non-standard metadata and compression." .

:md     rdfs:comment     "Markdown (MD) is a lightweight markup language with plain text formatting syntax" ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :File_Format .

:flagstat  rdfs:subClassOf  :File_Format ;
        rdfs:comment     "Output of samtools flagstat tool" ;
        rdf:type         owl:Class .

:gtf    rdf:type         owl:Class ;
        rdfs:subClassOf  :File_Format ;
        rdfs:comment     "Gene transfer format (GTF) is a file format used to hold information about gene structure" .

:raw    rdf:type         owl:Class ;
        rdfs:comment     "Proprietary file format for mass spectrometry data from Thermo Scientific" ;
        rdfs:subClassOf  :File_Format .

:msf    rdfs:subClassOf  :File_Format ;
        rdfs:comment     "Proprietary mass-spectrometry format of Thermo Scientific's ProteomeDiscoverer software" ;
        rdf:type         owl:Class .

:rmd    rdfs:comment     "markdown document specific to r analyses" ;
        rdfs:subClassOf  :File_Format ;
        rdf:type         owl:Class .

:bed_narrowPeak  rdfs:subClassOf  :File_Format ;
        rdfs:comment     "This format is used to provide called peaks of signal enrichment based on pooled, normalized (interpreted) data. It is a BED6+4 format." ;
        rdf:type         owl:Class .

:bed_broadPeak  rdfs:subClassOf  :File_Format ;
        rdfs:comment     "This format is used to provide called regions of signal enrichment based on pooled, normalized (interpreted) data. It is a BED 6+3 format." ;
        rdf:type         owl:Class .

:bed_gappedPeak  rdfs:subClassOf  :File_Format ;
        rdf:type         owl:Class ;
        rdfs:comment     "This format is used to provide called regions of signal enrichment based on pooled, normalized (interpreted) data where the regions may be spliced or incorporate gaps in the genomic sequence. It is a BED12+3 format." .

:avi    rdf:type         owl:Class ;
        rdfs:comment     "AVI files can contain both audio and video data in a file container that allows synchronous audio-with-video playback." ;
        rdfs:subClassOf  :File_Format .

:pzfx   rdf:type         owl:Class ;
        rdfs:subClassOf  :File_Format ;
        rdfs:comment     "A PZFX file is a Prism project created by GraphPad Prism, a scientific application used to analyze and graph data. It contains project data including graphs and layouts, notes, and tables." .

:fig    rdfs:comment     "Line drawing saved in the Xfig format; stored as a vector image that may include lines, shapes, arcs, splines, arrows, and text objects; may also include images, colors, and patterns." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :File_Format .

:xml    rdf:type         owl:Class ;
        rdfs:subClassOf  :File_Format ;
        rdfs:comment     "eXtensible Markup Language (XML) format." .

:tar    rdfs:comment     "tape archive" ;
        rdfs:subClassOf  :File_Format ;
        rdf:type         owl:Class .

:R_script  rdfs:subClassOf  :File_Format ;
        rdf:type         owl:Class ;
        rdfs:comment     "R Script" .

:abf    rdfs:subClassOf  :File_Format ;
        rdf:type         owl:Class ;
        rdfs:comment     "The Axon Binary File format (ABF) was created for the storage of binary experimental data." .

:bpm    rdfs:comment     "A beaded pool manifest. Describe the SNP or probe content on a BeadChip or in an assay pool." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :File_Format .

:dat    rdfs:comment     "Format of Affymetrix data file of raw image data." ;
        rdfs:subClassOf  :File_Format ;
        rdf:type         owl:Class .

:jpg    rdf:type         owl:Class ;
        rdfs:subClassOf  :File_Format ;
        rdfs:comment     "Joint Picture Group file format for lossy graphics file." .

:locs   rdfs:subClassOf  :File_Format ;
        rdf:type         owl:Class ;
        rdfs:comment     "Illumina iScan bead location file." .

:Sentrix_descriptor_file
        rdfs:comment     "A BeadScan specific file needed to perform scan setting checks for different array formats and assay type." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :File_Format .

:Python_script  rdfs:subClassOf  :File_Format ;
        rdfs:comment     "Python is an interpreted, object-oriented, high-level programming language with dynamic semantics." ;
        rdf:type         owl:Class .

:sav    rdfs:comment     "The SPSS Statistics File Format is a proprietary binary format, developed and maintained as the native format for the SPSS statistical software application." ;
        rdfs:subClassOf  :File_Format ;
        rdf:type         owl:Class .

:gzip   rdfs:comment     "GZipped format" ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :File_Format .

:sdf    rdfs:subClassOf  :File_Format ;
        rdfs:comment     "SDF is one of a family of chemical-data file formats developed by MDL Information Systems; it is intended especially for structural information." ;
        rdf:type         owl:Class .

:RData  rdfs:comment     "The RData format (usually with extension .rdata or .rda) is a format designed for use with R, a system for statistical computation and related graphics, for storing a complete R workspace or selected 'objects' from a workspace in a form that can be loaded back by R." ;
        rdfs:subClassOf  :File_Format ;
        rdf:type         owl:Class .

:hic    rdfs:subClassOf  :File_Format ;
        rdfs:comment     "Hi-C contact matrix file" ;
        rdf:type         owl:Class .

:ab1    rdfs:subClassOf  :File_Format ;
        rdfs:comment     "TAB1 binary format of raw DNA sequence reads (output of Applied Biosystems' sequencing analysis software). Contains an electropherogram and the DNA base sequence." ;
        rdf:type         owl:Class .

:7z     rdfs:comment     "A compressed archive file format that supports several different data compression, encryption and pre-processing filters." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :File_Format .

:gff3   rdfs:comment     "Generic Feature Format version 3 (GFF3) of sequence features." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :File_Format .

:json   rdfs:comment     "JavaScript Object Notation format; a lightweight, text-based format to represent tree-structured data using key-value pairs." ;
        rdfs:subClassOf  :File_Format ;
        rdf:type         owl:Class .

:sqlite  rdfs:comment    "Data format used by the SQLite database." ;
        rdfs:subClassOf  :File_Format ;
        rdf:type         owl:Class .

:svg    rdfs:comment     "Scalable Vector Graphics (SVG) is an XML-based vector image format for two-dimensional graphics with support for interactivity and animation." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :File_Format .

:sra    rdfs:subClassOf  :File_Format ;
        rdfs:comment     "SRA archive format (SRA) is the archive format used for input to the NCBI Sequence Read Archive." ;
        rdf:type         owl:Class .

:recal  rdfs:comment     ".recal file from GATK VQSR" ;
        rdfs:subClassOf  :File_Format ;
        rdf:type         owl:Class .

:tranches  rdf:type      owl:Class ;
        rdfs:comment     ".tranches file from GATK VQSR" ;
        rdfs:subClassOf  :File_Format .

:mtx    rdf:type         owl:Class ;
        rdfs:subClassOf  :File_Format ;
        rdfs:comment     "Matrix Market Exchange Format" .

:tagAlign  rdf:type      owl:Class ;
        rdfs:comment     "Tag Alignment provides genomic mapping of short sequence tags." ;
        rdfs:subClassOf  :File_Format .

:dup    rdf:type         owl:Class ;
        rdfs:comment     "output of the Picard MarkDuplicates tool." ;
        rdfs:subClassOf  :File_Format .

:DICOM  rdf:type         owl:Class ;
        rdfs:comment     "A comprehensive set of standards for communications between medical imaging devices, including handling, storing and transmitting information in medical imaging. It includes a file format definition and a network communication protocol." ;
        rdfs:subClassOf  :File_Format .

:czi    rdfs:comment     "microscopy imaging file format that saves multidimensional images such as time lapse, Z-stacks, multiposition experiments and virtual slides, combined with relevant meta information" ;
        rdfs:subClassOf  :File_Format ;
        rdf:type         owl:Class .

:mzML   rdf:type         owl:Class ;
        rdfs:comment     "mzML format for raw spectrometer output data, standardised by HUPO PSI MSS." ;
        rdfs:subClassOf  :File_Format .

:SPAR   rdfs:subClassOf  :File_Format ;
        rdfs:comment     "Phillips MRS Header File" ;
        rdf:type         owl:Class .

:SDAT   rdf:type         owl:Class ;
        rdfs:subClassOf  :File_Format ;
        rdfs:comment     "Phillips MRS Data File" .

:nii    rdfs:comment     "NIfTI-1 can store image data from any modality such as PET, MRI, CT, EEG that produces regularly sampled 1-5D rasters." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :File_Format .

:PAR    rdf:type         owl:Class ;
        rdfs:subClassOf  :File_Format ;
        rdfs:comment     "This is yet another MRI image format generated by Philips scanners. It is an ASCII header (PAR) plus a binary blob (REC)." .

