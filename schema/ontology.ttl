################################################################################

nf:abbreviation a owl:DatatypeProperty ;
    rdfs:label "abbreviation" ;
    rdfs:comment "Short abbreviation or acronym for the initiative." ;
    rdfs:domain nf:Initiative ;
    rdfs:range xsd:string .

nf:website a owl:ObjectProperty ;
    rdfs:label "website" ;
    rdfs:comment "URL of the initiative or resource website." ;
    rdfs:domain nf:Initiative .

################################################################################
# Properties - Dataset
################################################################################

nf:creator a owl:DatatypeProperty ;
    rdfs:label "creator" ;
    rdfs:comment "Individual(s) who created the dataset." ;
    rdfs:domain nf:Dataset ;
    rdfs:range xsd:string .

nf:contributor a owl:DatatypeProperty ;
    rdfs:label "contributor" ;
    rdfs:comment "Individual(s) who contributed to the dataset." ;
    rdfs:domain nf:Dataset ;
    rdfs:range xsd:string .

nf:accessType a owl:DatatypeProperty ;
    rdfs:label "accessType" ;
    rdfs:comment "Access level for the dataset (e.g. Public Access, Controlled Access)." ;
    rdfs:domain nf:Dataset ;
    rdfs:range xsd:string .

nf:license a owl:ObjectProperty ;
    rdfs:label "license" ;
    rdfs:comment "License URL governing use of the dataset." ;
    rdfs:domain nf:Dataset .

nf:conditionsOfAccess a owl:DatatypeProperty ;
    rdfs:label "conditionsOfAccess" ;
    rdfs:comment "Conditions or requirements for accessing the dataset." ;
    rdfs:domain nf:Dataset ;
    rdfs:range xsd:string .

nf:keywords a owl:DatatypeProperty ;
    rdfs:label "keywords" ;
    rdfs:comment "Keywords describing the dataset content." ;
    rdfs:domain nf:Dataset ;
    rdfs:range xsd:string .

nf:measurementTechnique a owl:DatatypeProperty ;
    rdfs:label "measurementTechnique" ;
    rdfs:comment "Measurement or assay technique used to generate the dataset." ;
    rdfs:domain nf:Dataset ;
    rdfs:range xsd:string .

nf:ageGroup a owl:DatatypeProperty ;
    rdfs:label "ageGroup" ;
    rdfs:comment "Age group(s) of the subjects in the dataset (e.g. pediatric, adult)." ;
    rdfs:domain nf:Dataset ;
    rdfs:range xsd:string .

nf:dataUseModifiers a owl:DatatypeProperty ;
    rdfs:label "dataUseModifiers" ;
    rdfs:comment "Data use conditions or modifiers applicable to the dataset (GA4GH DUO terms)." ;
    rdfs:domain nf:Dataset ;
    rdfs:range xsd:string .

nf:countryOfOrigin a owl:DatatypeProperty ;
    rdfs:label "countryOfOrigin" ;
    rdfs:comment "Country where the data was collected." ;
    rdfs:domain nf:Dataset ;
    rdfs:range xsd:string .

nf:datasetSizeInBytes a owl:DatatypeProperty ;
    rdfs:label "datasetSizeInBytes" ;
    rdfs:comment "Total size of the dataset in bytes." ;
    rdfs:domain nf:Dataset ;
    rdfs:range xsd:long .

nf:datasetItemCount a owl:DatatypeProperty ;
    rdfs:label "datasetItemCount" ;
    rdfs:comment "Number of items (files) in the dataset." ;
    rdfs:domain nf:Dataset ;
    rdfs:range xsd:integer .

nf:individualCount a owl:DatatypeProperty ;
    rdfs:label "individualCount" ;
    rdfs:comment "Number of individuals represented in the dataset." ;
    rdfs:domain nf:Dataset ;
    rdfs:range xsd:integer .

nf:specimenCount a owl:DatatypeProperty ;
    rdfs:label "specimenCount" ;
    rdfs:comment "Number of specimens represented in the dataset." ;
    rdfs:domain nf:Dataset ;
    rdfs:range xsd:integer .

nf:yearPublished a owl:DatatypeProperty ;
    rdfs:label "yearPublished" ;
    rdfs:comment "Year the dataset was published or released." ;
    rdfs:domain nf:Dataset ;
    rdfs:range xsd:integer .

nf:visualizeDataOn a owl:DatatypeProperty ;
    rdfs:label "visualizeDataOn" ;
    rdfs:comment "External platform(s) where the dataset can be visualized." ;
    rdfs:domain nf:Dataset ;
    rdfs:range xsd:string .

nf:alternateName a owl:DatatypeProperty ;
    rdfs:label "alternateName" ;
    rdfs:comment "Alternative name or title for the dataset." ;
    rdfs:domain nf:Dataset ;
    rdfs:range xsd:string .

nf:versionLabel a owl:DatatypeProperty ;
    rdfs:label "versionLabel" ;
    rdfs:comment "Human-readable label for the dataset version." ;
    rdfs:domain nf:Dataset ;
    rdfs:range xsd:string .

nf:externalRepositoryUri a owl:ObjectProperty ;
    rdfs:label "externalRepositoryUri" ;
    rdfs:comment "URI of an external repository where the dataset is also deposited." ;
    rdfs:domain nf:Dataset .

################################################################################
# Properties - Development related
################################################################################

nf:resourceId a owl:DatatypeProperty ;
    rdfs:label "resourceId" ;
    rdfs:comment "Canonical resource ID, as a string. Used as a join key by nf:forResourceId to link an nf:Observation or nf:Development record back to this resource." ;
    rdfs:domain nf:Tool ;
    rdfs:range xsd:string .

# Funder
nf:hasFunder a owl:ObjectProperty ;
    rdfs:label "hasFunder" ;
    rdfs:comment "Links to the funding organization." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (nf:File nf:Study nf:Development) ] ;
    rdfs:range nf:Funder .

# Investigator
#
# ORCID and Synapse profiles linked via owl:sameAs

nf:institution a owl:DatatypeProperty ;
    rdfs:label "institution" ;
    rdfs:comment "Affiliated institution." ;
    rdfs:domain nf:Investigator ;
    rdfs:range xsd:string .

nf:hasInvestigator a owl:ObjectProperty ;
    rdfs:label "hasInvestigator" ;
    rdfs:comment "Links a development record to an investigator." ;
    rdfs:domain nf:Development ;
    rdfs:range nf:Investigator .

nf:createdBy a owl:ObjectProperty ;
    rdfs:label "createdBy" ;
    rdfs:comment "Synapse user who created the entity." ;
    rdfs:domain nf:File .

nf:modifiedBy a owl:ObjectProperty ;
    rdfs:label "modifiedBy" ;
    rdfs:comment "Synapse user who last modified the entity." ;
    rdfs:domain nf:File .

# Publication
nf:doi a owl:ObjectProperty ;
    rdfs:label "doi" ;
    rdfs:comment "DOI (Digital Object Identifier) of a resource." .

nf:citation a owl:DatatypeProperty ;
    rdfs:label "citation" ;
    rdfs:comment "Formatted citation string." ;
    rdfs:domain nf:Publication ;
    rdfs:range xsd:string .

nf:publicationTitle a owl:DatatypeProperty ;
    rdfs:label "publicationTitle" ;
    rdfs:comment "Title of the publication." ;
    rdfs:domain nf:Publication ;
    rdfs:range xsd:string .

nf:abstract a owl:DatatypeProperty ;
    rdfs:label "abstract" ;
    rdfs:comment "Abstract of the publication." ;
    rdfs:domain nf:Publication ;
    rdfs:range xsd:string .

nf:publicationDate a owl:DatatypeProperty ;
    rdfs:label "publicationDate" ;
    rdfs:comment "Publication date." ;
    rdfs:domain nf:Publication ;
    rdfs:range xsd:string .

nf:publicationDateUnix a owl:DatatypeProperty ;
    rdfs:label "publicationDateUnix" ;
    rdfs:comment "Publication date as Unix timestamp." ;
    rdfs:domain nf:Publication ;
    rdfs:range xsd:string .

nf:journal a owl:DatatypeProperty ;
    rdfs:label "journal" ;
    rdfs:comment "Journal in which the publication appeared." ;
    rdfs:domain nf:Publication ;
    rdfs:range xsd:string .

nf:pmid a owl:ObjectProperty ;
    rdfs:label "pmid" ;
    rdfs:comment "PubMed ID of the publication." ;
    rdfs:domain nf:Publication .

nf:authors a owl:DatatypeProperty ;
    rdfs:label "authors" ;
    rdfs:comment "Authors of the publication." ;
    rdfs:domain nf:Publication ;
    rdfs:range xsd:string .

nf:inFullTextIndex a owl:DatatypeProperty ;
    rdfs:label "inFullTextIndex" ;
    rdfs:comment "Whether the publication is included in the project full-text index." ;
    rdfs:domain nf:Publication ;
    rdfs:range xsd:boolean .

nf:hasPublication a owl:ObjectProperty ;
    rdfs:label "hasPublication" ;
    rdfs:comment "Links a resource-development context to the publication describing it: asserted from an nf:Development record and, as a shortcut, from the nf:Tool itself. This is a resource-development association, NOT authorship -- the linked investigator need not be an author of the paper. For authorship use the publication's DOI IRI and nf:authorOrcid." ;
    rdfs:range nf:Publication .

nf:year a owl:DatatypeProperty ;
    rdfs:label "year" ;
    rdfs:comment "Publication year." ;
    rdfs:domain nf:Publication ;
    rdfs:range xsd:string .

nf:publicationType a owl:DatatypeProperty ;
    rdfs:label "publicationType" ;
    rdfs:comment "Type of publication as recorded by the main portal listing (e.g. preprint, review)." ;
    rdfs:domain nf:Publication ;
    rdfs:range xsd:string .

nf:hasSynapseProfile a owl:ObjectProperty ;
    rdfs:label "hasSynapseProfile" ;
    rdfs:comment "Links a person to the Synapse Profile IRI that identifies them, i.e. asserts that this researcher has a Synapse account. A person with an ORCID but no known Synapse account simply has no nf:hasSynapseProfile triple. Relation is one-to-many: a person may hold more than one Synapse account. Property intentionally has no rdfs:domain: its subject is an ORCID IRI, which for an account-holder is NOT that person's biolink:Person node (their Profile IRI is), so declaring a domain would let a reasoner type the ORCID IRI as a second person and duplicate every account-holder. Like owl:sameAs it relates two identifiers rather than describing one entity." .

nf:onProject a owl:ObjectProperty ;
    rdfs:label "onProject" ;
    rdfs:comment "Links a person (biolink:Person, identified by their Synapse Profile IRI) to a Synapse project they are a member of. Two people sharing a project are project collaborators, which is a different relation from co-authorship (see nf:authorOrcid). CAVEAT: the source column is a bounded list, and the most active people sit exactly at that cap, so their project lists -- and any collaborator counts derived from them -- are truncated LOWER BOUNDS, not true totals. Do not rank people by project count or project-collaborator count until the cap is lifted upstream; per-person questions about someone below the cap are fine." ;
    rdfs:domain biolink:Person .

nf:aboutStudy a owl:ObjectProperty ;
    rdfs:label "aboutStudy" ;
    rdfs:comment "Links a publication to a portal study whose data it reports. Asserted for main-portal (study-associated) publications; a publication can be about more than one study." ;
    rdfs:domain nf:Publication ;
    rdfs:range nf:Study .

nf:authorOrcid a owl:ObjectProperty ;
    rdfs:label "authorOrcid" ;
    rdfs:comment "Links a DOI IRI (the object of a publication's nf:doi, not the Publication node itself) to an author's ORCID identifier: query as `?pub nf:doi ?doi . ?doi nf:authorOrcid ?orcid`. To check whether that author has a Synapse account, ask the ORCID IRI for nf:hasSynapseProfile, which yields the profile directly. To get the author's NAME, ask the ORCID IRI for nf:name directly (authors with no Synapse account are biolink:Person nodes keyed by their ORCID) and fall back to one owl:sameAs hop for those who do have an account: `{ ?orcid nf:name ?name } UNION { ?orcid owl:sameAs ?p . ?p nf:name ?name }`. Do NOT match authors by name string against nf:authors -- the registry's display-name spelling need not match the publication's. Note: ORCID may not be available for all authors, so authorOrcid values can be a partial subset of a publication's authorship. nf:authors (literal author names) is the complete author list; do not assume every author in nf:authors has a corresponding authorOrcid, and do not use the count of authorOrcid values as the author count." .

################################################################################
# Properties - Observation related
################################################################################

nf:observationId a owl:DatatypeProperty ;
    rdfs:label "observationId" ;
    rdfs:comment "A unique identifier for an observation." ;
    rdfs:domain nf:Observation ;
    rdfs:range xsd:string .

nf:observationText a owl:DatatypeProperty ;
    rdfs:label "observationText" ;
    rdfs:comment "The free-text content of an observation. This may be the only place a specific detail is recorded, since related structured fields may hold limited labels." ;
    rdfs:domain nf:Observation ;
    rdfs:range xsd:string .

nf:observationSubmitterName a owl:DatatypeProperty ;
    rdfs:label "observationSubmitterName" ;
    rdfs:comment "Submitter name." ;
    rdfs:domain nf:Observation ;
    rdfs:range xsd:string .

nf:observationPhase a owl:DatatypeProperty ;
    rdfs:label "observationPhase" ;
    rdfs:comment "Phase or stage of the observation (e.g. summary, detailed)." ;
    rdfs:domain nf:Observation ;
    rdfs:range xsd:string .

nf:observationTime a owl:DatatypeProperty ;
    rdfs:label "observationTime" ;
    rdfs:comment "Timestamp of the observation." ;
    rdfs:domain nf:Observation ;
    rdfs:range xsd:decimal .

nf:observationTimeUnits a owl:DatatypeProperty ;
    rdfs:label "observationTimeUnits" ;
    rdfs:comment "Units of the observation timestamp (e.g. milliseconds)." ;
    rdfs:domain nf:Observation ;
    rdfs:range xsd:string .

nf:observationLink a owl:ObjectProperty ;
    rdfs:label "observationLink" ;
    rdfs:comment "Link to supporting material." ;
    rdfs:domain nf:Observation .

nf:investigatorSynapseId a owl:ObjectProperty ;
    rdfs:label "investigatorSynapseId" ;
    rdfs:comment "Synapse Profile IRI (https://www.synapse.org/Profile:{id}) of the observation's submitter. This IS the submitter's biolink:Person node, not a separate identifier -- see the biolink:Person scopeNote for the two ways a person is keyed in this graph." ;
    rdfs:domain nf:Observation ;
    rdfs:range biolink:Person .

nf:reliabilityRating a owl:DatatypeProperty ;
    rdfs:label "reliabilityRating" ;
    rdfs:comment "Reliability rating." ;
    rdfs:domain nf:Observation ;
    rdfs:range xsd:string .

nf:easeOfUseRating a owl:DatatypeProperty ;
    rdfs:label "easeOfUseRating" ;
    rdfs:comment "Ease-of-use rating." ;
    rdfs:domain nf:Observation ;
    rdfs:range xsd:string .

nf:forResourceId a owl:DatatypeProperty ;
    rdfs:label "forResourceId" ;
    rdfs:comment "The nf:resourceId of the nf:Tool this object is about, as a string." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (nf:Observation nf:Development) ] ;
    rdfs:seeAlso nf:aboutResource ;
    rdfs:range xsd:string .

nf:aboutResource a owl:ObjectProperty ;
    rdfs:label "aboutResource" ;
    rdfs:comment "Links an observation to the resource it describes. Materialized as the inverse of nf:hasObservation. Exactly one resource per observation." ;
    rdfs:domain nf:Observation ;
    rdfs:range nf:Tool .

nf:referencesPublication a owl:ObjectProperty ;
    rdfs:label "referencesPublication" ;
    rdfs:comment "Links an observation to a supporting publication." ;
    rdfs:domain nf:Observation ;
    rdfs:range nf:Publication .

################################################################################
# Classes - Text entity annotations (from PubTator3 text index)
################################################################################

nf:Gene a owl:Class ;
    rdfs:subClassOf biolink:Gene ;
    owl:equivalentClass <http://purl.uniprot.org/core/Gene> ;
    rdfs:label "Gene" ;
    rdfs:comment "A gene entity annotated in publication text." .

nf:DiseaseAnnotation a owl:Class ;
    rdfs:subClassOf <http://purl.uniprot.org/core/Disease_Annotation> ;
    rdfs:label "Disease Annotation" ;
    rdfs:comment "A disease entity annotated in publication text." .

# nf:Chemical replaced by biolink:ChemicalEntity (declared under Borrowed classes above)

nf:Variant a owl:Class ;
    rdfs:subClassOf biolink:SequenceVariant ;
    owl:equivalentClass obo:SO_0001564 ;
    rdfs:label "Variant" ;
    rdfs:comment "A genetic variant annotated in publication text." .

################################################################################
# Classes - Specimens and individuals
#
# The portal records specimenID/individualID as string literals on nf:File. These
# classes promote them to nodes so per-specimen reasoning does not require a
# string join at query time. Materialized by scripts/materialize_specimens.py.
################################################################################

nf:Specimen a owl:Class ;
    rdfs:subClassOf biolink:MaterialSample ;
    owl:equivalentClass obo:OBI_0100051 ;
    rdfs:label "Specimen" ;
    rdfs:comment "A biological specimen a portal file was derived from, identified by its non-PII specimenID. Materialized from the specimenID column of the portal files table, so it is faithful to the source rather than curated: a few portal specimenIDs are DICOM instance UIDs or free-text labels. Subclassed under biolink:MaterialSample (whose aliases include 'sample' and 'biospecimen') rather than equated with it, because BioLink maps that class to OBI:0000747 'material sample' while the NF sense is OBI:0100051 'specimen' -- the two are SIBLINGS under BFO material entity, not equivalents. Instances carry both rdf:type values so the alignment is queryable without a reasoner." .

nf:Individual a owl:Class ;
    rdfs:subClassOf biolink:IndividualOrganism ;
    rdfs:label "Individual" ;
    rdfs:comment "The individual (patient or animal) a specimen or file came from, identified by its non-PII individualID. Subclassed under biolink:IndividualOrganism, NOT biolink:Case: Case is defined as a human organism in a patient role, and a large share of NF portal individualIDs name mice or zebrafish, so Case would be false for them. DISTINCT from nf:Donor: nf:Donor is the UUID-keyed source donor of a cell line or animal model, and the two identifier spaces do not overlap at all. Instances carry both rdf:type values so the alignment is queryable without a reasoner." .

################################################################################
# Properties - Specimens and individuals
################################################################################

nf:fromSpecimen a owl:ObjectProperty ;
    rdfs:label "fromSpecimen" ;
    rdfs:comment "Links a file or variant observation to the specimen it was derived from." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (nf:File nf:VariantObservation) ] ;
    rdfs:range nf:Specimen .

nf:hasFile a owl:ObjectProperty ;
    owl:inverseOf nf:fromSpecimen ;
    rdfs:label "hasFile" ;
    rdfs:comment "Links a specimen to a file derived from it." ;
    rdfs:domain nf:Specimen ;
    rdfs:range nf:File .

nf:fromIndividual a owl:ObjectProperty ;
    rdfs:label "fromIndividual" ;
    rdfs:comment "Links a specimen, file, or variant observation to the individual it came from. Asserted on files directly as well as via their specimen, because many files carry an individualID with no specimenID at all." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (nf:File nf:Specimen nf:VariantObservation) ] ;
    rdfs:range nf:Individual .

nf:hasSpecimen a owl:ObjectProperty ;
    owl:inverseOf nf:fromIndividual ;
    rdfs:label "hasSpecimen" ;
    rdfs:comment "Links an individual to a specimen taken from them." ;
    rdfs:domain nf:Individual ;
    rdfs:range nf:Specimen .

################################################################################
# Gene layer
#
# Gene nodes are typed biolink:Gene directly, NOT nf:Gene: that class means "a gene
# entity annotated in publication text" (PubTator3) and carries no identifiers, so
# overloading it would conflate a literature mention with an annotated locus.
# Keyed on the HGNC id, Ensembl as fallback; see docs/variant-layer.md.
################################################################################

nf:geneSymbol a owl:DatatypeProperty ;
    rdfs:label "geneSymbol" ;
    rdfs:comment "Approved HGNC symbol of a gene. Exactly one per gene node: a source symbol is the picked transcript's symbol, so an overlapping antisense or readthrough transcript can report a different gene's symbol against the same locus. Verbatim per-record symbols stay where they were asserted, on nf:affectedGeneSymbol." ;
    rdfs:domain biolink:Gene ;
    rdfs:range xsd:string .

nf:geneName a owl:DatatypeProperty ;
    rdfs:label "geneName" ;
    rdfs:comment "HGNC approved full name of a gene. Asserted only when HGNC's own ensembl_gene_id agrees with the source's, so its presence means the gene's identity was independently cross-checked." ;
    rdfs:domain biolink:Gene ;
    rdfs:range xsd:string .

nf:hgncId a owl:DatatypeProperty ;
    rdfs:label "hgncId" ;
    rdfs:comment "HGNC identifier of a gene, as a CURIE (e.g. HGNC:7765). Gene nodes also carry skos:exactMatch to the resolvable identifiers.org IRI, so HGNC-keyed data can join without a lookup table. Variant observations do not use this: they carry the same identifier as an IRI on nf:affectedGene instead." ;
    rdfs:domain biolink:Gene ;
    rdfs:range xsd:string .

nf:ensemblGeneId a owl:DatatypeProperty ;
    rdfs:label "ensemblGeneId" ;
    rdfs:comment "Ensembl gene identifier (e.g. ENSG00000196712), as a literal. Gene nodes are named by HGNC and carry the Ensembl IRI as skos:exactMatch; a gene with no HGNC id is named by this identifier instead. ENSG->HGNC is the unambiguous direction (0 of 11,211 ambiguous), which is what makes both safe to assert." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (biolink:Gene nf:VariantObservation) ] ;
    rdfs:range xsd:string .

nf:entrezGeneId a owl:DatatypeProperty ;
    rdfs:label "entrezGeneId" ;
    rdfs:comment "NCBI Entrez gene identifier." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (biolink:Gene nf:VariantObservation) ] ;
    rdfs:range xsd:string .

################################################################################
# Ortholog layer
#
# Curated model-system mutations name their gene with a model-organism symbol (Nf1,
# Trp53, nf1a) while the variant layer names genes by HGNC IRI, so an animal model
# matches zero patient alleles structurally. These terms carry the crosswalk; see
# mappings/orthologs.tsv and scripts/materialize_orthologs.py.
################################################################################

nf:ModelOrganismGene a owl:Class ;
    rdfs:subClassOf biolink:Gene ;
    rdfs:label "Model Organism Gene" ;
    rdfs:comment "A non-human gene, named by its model-organism database identifier (MGI, ZFIN, RGD), that exists in this graph only as the far end of an ortholog edge. It is a gene, hence the subclass, but instances are deliberately NOT also typed biolink:Gene: that type denotes the human, HGNC-keyed gene nodes of the variant layer, and every per-gene count in docs/demos/variant-layer-demo.md is a count over that set. The index does no OWL reasoning, so the subclass declaration documents the semantics without letting mouse genes into `?s a biolink:Gene`. Contrast nf:Specimen, where materialize_specimens.py emits both types on purpose for the opposite reason." .

nf:hasOrtholog a owl:ObjectProperty ;
    owl:inverseOf nf:orthologOf ;
    rdfs:label "hasOrtholog" ;
    rdfs:comment "Links a human gene node to its model-organism ortholog. Asserted only for the genes NF-OSI curates mutations on, from a pinned Alliance of Genome Resources release under its Stringent filter; the per-pair supporting-algorithm counts stay in mappings/orthologs.tsv rather than being reified here, because the edge is the assertion and the counts are its evidence. A gene-level ortholog match is not an allele match: a mouse Nf1 knockout covers an NF1 patient at the mechanism level only." ;
    rdfs:domain biolink:Gene ;
    rdfs:range nf:ModelOrganismGene .

nf:orthologOf a owl:ObjectProperty ;
    rdfs:label "orthologOf" ;
    rdfs:comment "Inverse of nf:hasOrtholog: links a model-organism gene to the human gene it is an ortholog of." ;
    rdfs:domain nf:ModelOrganismGene ;
    rdfs:range biolink:Gene .

################################################################################
# Classes - Somatic variant layer (cBioPortal)
#
# The variant node itself is biolink:SequenceVariant, used directly per
# docs/biolink-alignment.md. Note nf:Variant is NOT reused: that class means "a
# variant mentioned in publication text" (PubTator3) and carries no coordinates.
################################################################################

nf:VariantObservation a owl:Class ;
    rdfs:label "Variant Observation" ;
    rdfs:comment "The observation of one sequence variant in one sequenced sample: the context-full half of the two-layer split. Carries the sample, its allele-depth evidence, and the functional annotation of the transcript the caller picked. The context-free half (the allele itself) is the biolink:SequenceVariant it points at via nf:observesVariant, which is shared by every sample carrying the same allele." .

################################################################################
# Properties - Somatic variant layer
################################################################################

nf:hasVariantObservation a owl:ObjectProperty ;
    owl:inverseOf nf:fromSpecimen ;
    rdfs:label "hasVariantObservation" ;
    rdfs:comment "Links a specimen to a variant observed in it." ;
    rdfs:domain nf:Specimen ;
    rdfs:range nf:VariantObservation .

nf:observesVariant a owl:ObjectProperty ;
    rdfs:label "observesVariant" ;
    rdfs:comment "Links a variant observation to the context-free sequence variant it observes." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range biolink:SequenceVariant .

nf:hasConsequence a owl:ObjectProperty ;
    rdfs:label "hasConsequence" ;
    rdfs:comment "Sequence Ontology molecular consequence of a variant observation, resolved from the MAF Consequence column (or Variant_Classification when that is empty) via mappings/sssom/variant_consequence.sssom.tsv. Repeatable: a single variant commonly carries several SO terms." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range owl:Class .

nf:fromVariantDataset a owl:ObjectProperty ;
    rdfs:label "fromVariantDataset" ;
    rdfs:comment "Links a variant observation to the provenance node for the source dataset it was ingested from." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range void:Dataset .

nf:vrsId a owl:DatatypeProperty ;
    rdfs:label "vrsId" ;
    rdfs:comment "GA4GH VRS 2.0 computed identifier (`ga4gh:VA.<digest>`) of a sequence variant, as a literal. This is the cross-cohort join key: the same allele from any source collapses to the same value, and it is what makes future lookups against ClinVar, CIViC, or gnomAD possible. It is also the variant node's own IRI, so joining by IRI needs no property path; this literal is for selecting the identifier as a value. Absent on variants flagged nf:unnormalizedVariant, which have no VRS identity and are named under nf:variant/ instead." ;
    rdfs:domain biolink:SequenceVariant ;
    rdfs:range xsd:string .

nf:refgetAccession a owl:DatatypeProperty ;
    rdfs:label "refgetAccession" ;
    rdfs:comment "GA4GH refget sequence accession (`SQ.<digest>`) of the reference sequence the variant is located on. Carries the assembly implicitly and exactly, which is what keeps a GRCh37 variant from silently colliding with a GRCh38 one." ;
    rdfs:domain biolink:SequenceVariant ;
    rdfs:range xsd:string .

nf:variantStart a owl:DatatypeProperty ;
    rdfs:label "variantStart" ;
    rdfs:comment "Interbase (0-based, half-open) start of the variant on its reference sequence. Equals variantEnd for a pure insertion." ;
    rdfs:domain biolink:SequenceVariant ;
    rdfs:range xsd:integer .

nf:variantEnd a owl:DatatypeProperty ;
    rdfs:label "variantEnd" ;
    rdfs:comment "Interbase (0-based, half-open) end of the variant on its reference sequence." ;
    rdfs:domain biolink:SequenceVariant ;
    rdfs:range xsd:integer .

nf:variantState a owl:DatatypeProperty ;
    rdfs:label "variantState" ;
    rdfs:comment "Replacement sequence for the variant's reference interval. Empty string for a pure deletion." ;
    rdfs:domain biolink:SequenceVariant ;
    rdfs:range xsd:string .

nf:unnormalizedVariant a owl:DatatypeProperty ;
    rdfs:label "unnormalizedVariant" ;
    rdfs:comment "True when a source row could not be given a GA4GH VRS identity (contig absent from the reference seqmap, assembly disagreeing with the source, or non-nucleotide alleles). Such variants are kept rather than dropped, keyed on assembly:chrom:pos:ref:alt, but they do NOT join across cohorts." ;
    rdfs:domain biolink:SequenceVariant ;
    rdfs:range xsd:boolean .

nf:fullyJustified a owl:DatatypeProperty ;
    rdfs:label "fullyJustified" ;
    rdfs:comment "False when an indel's VRS identifier was computed without a reference sequence, so it was not bidirectionally justified and will NOT match vrs-python, ClinVar, or gnomAD. Absent (rather than true) on variants computed correctly, and never present on substitutions, which need no reference." ;
    rdfs:domain biolink:SequenceVariant ;
    rdfs:range xsd:boolean .

nf:variantClassification a owl:DatatypeProperty ;
    rdfs:label "variantClassification" ;
    rdfs:comment "MAF Variant_Classification (e.g. Missense_Mutation). Kept as a literal alongside the SO terms on nf:hasConsequence because it is the vocabulary cBioPortal users filter by." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range xsd:string .

nf:variantType a owl:DatatypeProperty ;
    rdfs:label "variantType" ;
    rdfs:comment "MAF Variant_Type: SNP, DEL, INS, DNP, TNP, or ONP." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range xsd:string .

nf:variantImpact a owl:DatatypeProperty ;
    rdfs:label "variantImpact" ;
    rdfs:comment "VEP IMPACT rating of the variant observation: HIGH, MODERATE, LOW, or MODIFIER." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range xsd:string .

nf:aminoacidChange a owl:DatatypeProperty ;
    rdfs:label "aminoacidChange" ;
    rdfs:comment "Short HGVS protein change (e.g. p.R1276*), the form users search by. Taken from MAF HGVSp_Short, falling back to HGVSp." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range xsd:string .

nf:hgvsC a owl:DatatypeProperty ;
    rdfs:label "hgvsC" ;
    rdfs:comment "HGVS coding-sequence change, transcript-qualified." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range xsd:string .

nf:hgvsP a owl:DatatypeProperty ;
    rdfs:label "hgvsP" ;
    rdfs:comment "HGVS protein change in three-letter form." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range xsd:string .

nf:transcriptId a owl:DatatypeProperty ;
    rdfs:label "transcriptId" ;
    rdfs:comment "Ensembl transcript the annotation was computed against. All annotation on a variant observation is relative to this one picked transcript, not to the gene as a whole." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range xsd:string .

nf:proteinPosition a owl:DatatypeProperty ;
    rdfs:label "proteinPosition" ;
    rdfs:comment "Residue position of the change within the protein." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range xsd:string .

nf:exonNumber a owl:DatatypeProperty ;
    rdfs:label "exonNumber" ;
    rdfs:comment "Affected exon, as exon/total (e.g. 47/57)." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range xsd:string .




nf:dbsnpId a owl:DatatypeProperty ;
    rdfs:label "dbsnpId" ;
    rdfs:comment "dbSNP rsID reported for the variant. Repeatable." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range xsd:string .

nf:gnomadAlleleFrequency a owl:DatatypeProperty ;
    rdfs:label "gnomadAlleleFrequency" ;
    rdfs:comment "gnomAD genome allele frequency reported for the variant, used to judge whether a call is plausibly somatic." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range xsd:double .

nf:tumorSampleBarcode a owl:DatatypeProperty ;
    rdfs:label "tumorSampleBarcode" ;
    rdfs:comment "Source Tumor_Sample_Barcode, retained verbatim so an observation can be traced back to its cBioPortal row even when it did not resolve to a portal specimen." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range xsd:string .

nf:matchedNormalSampleBarcode a owl:DatatypeProperty ;
    rdfs:label "matchedNormalSampleBarcode" ;
    rdfs:comment "Source Matched_Norm_Sample_Barcode. The tumour/normal pairing is what makes the call somatic." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range xsd:string .

nf:mutationStatus a owl:DatatypeProperty ;
    rdfs:label "mutationStatus" ;
    rdfs:comment "Somatic or Germline. NF-OSI MAFs leave MAF's own Mutation_Status blank, so ingest stamps Somatic from the cBioPortal MUTATION_EXTENDED profile, which is somatic by construction." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range xsd:string .

nf:tumorDepth a owl:DatatypeProperty ;
    rdfs:label "tumorDepth" ;
    rdfs:comment "Total read depth at the locus in the tumour sample." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range xsd:integer .

nf:tumorRefCount a owl:DatatypeProperty ;
    rdfs:label "tumorRefCount" ;
    rdfs:comment "Reads supporting the reference allele in the tumour sample." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range xsd:integer .

nf:tumorAltCount a owl:DatatypeProperty ;
    rdfs:label "tumorAltCount" ;
    rdfs:comment "Reads supporting the variant allele in the tumour sample. Zero means no read supports the call in this sample, which is a reason to distrust it, not evidence of the variant." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range xsd:integer .

nf:normalDepth a owl:DatatypeProperty ;
    rdfs:label "normalDepth" ;
    rdfs:comment "Total read depth at the locus in the matched normal sample." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range xsd:integer .

nf:normalRefCount a owl:DatatypeProperty ;
    rdfs:label "normalRefCount" ;
    rdfs:comment "Reads supporting the reference allele in the matched normal sample." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range xsd:integer .

nf:normalAltCount a owl:DatatypeProperty ;
    rdfs:label "normalAltCount" ;
    rdfs:comment "Reads supporting the variant allele in the matched normal sample. A non-zero count on a supposedly somatic call suggests germline contamination." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range xsd:integer .

nf:variantAlleleFrequency a owl:DatatypeProperty ;
    rdfs:label "variantAlleleFrequency" ;
    rdfs:comment "Tumour variant allele frequency, derived as tumorAltCount / tumorDepth. Absent when the source provides no usable depth." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range xsd:double .

nf:assemblyId a owl:DatatypeProperty ;
    rdfs:label "assemblyId" ;
    rdfs:comment "Reference assembly the source row was called against (e.g. GRCh38). On the observation rather than the variant, because the variant's own identity already pins the sequence via nf:refgetAccession." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range xsd:string .

nf:referenceName a owl:DatatypeProperty ;
    rdfs:label "referenceName" ;
    rdfs:comment "Chromosome name in the form Beacon clients query by, with any chr prefix stripped." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range xsd:string .

nf:sourceContig a owl:DatatypeProperty ;
    rdfs:label "sourceContig" ;
    rdfs:comment "Contig name exactly as written in the source file, kept for traceability when it differs from the reference's own naming." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range xsd:string .

nf:sourcePos a owl:DatatypeProperty ;
    rdfs:label "sourcePos" ;
    rdfs:comment "1-based Start_Position exactly as written in the source file. Distinct from the variant's interbase nf:variantStart." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range xsd:integer .

nf:affectedGene a owl:ObjectProperty ;
    rdfs:label "affectedGene" ;
    rdfs:comment "Gene a variant observation affects. On the observation rather than the variant because the association comes from the transcript the caller picked -- it is annotation, not identity, and the same allele annotated against another transcript could name another gene. Carries TWO objects per observation, both IRIs denoting the same gene from two authorities: the gene NODE, which is its HGNC IRI (https://identifiers.org/hgnc:7765, replacing the former nf:hgncId literal so HGNC-keyed sources can join by IRI), and the Ensembl IRI. The two are reconcilable inside the graph: the node carries the Ensembl IRI as skos:exactMatch. A gene with no HGNC id is Ensembl-keyed, and then the Ensembl object is the node. Exactly one object is typed biolink:Gene, so a query that counts or traverses genes must constrain the gene side with `a biolink:Gene` -- without it a bare ?obs nf:affectedGene ?gene matches twice per observation." ;
    rdfs:domain nf:VariantObservation ;
    rdfs:range biolink:Gene .
