@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix nf:   <http://nf-osi.github.com/terms#> .
@prefix efo:   <http://www.ebi.ac.uk/efo/> .
@prefix obo:   <http://purl.obolibrary.org/obo/> .
@prefix prov:  <http://www.w3.org/ns/prov#> .


nf:KGOntology a owl:Ontology ;
    rdfs:label "NF KG Ontology" ;
    rdfs:comment "Ontology documenting classes and properties in the NF-OSI KG." .

################################################################################
# Classes
################################################################################

nf:File a owl:Class ;
    rdfs:label "File" ;
    rdfs:comment "A file resource in the NF-OSI portal." .

nf:Study a owl:Class ;
    rdfs:label "Study" ;
    rdfs:comment "A research study in the NF-OSI portal." .

nf:Tool a owl:Class ;
    rdfs:label "Tool" ;
    rdfs:comment "Base class for research tools and reagents." .

nf:GeneticReagent a owl:Class ;
    rdfs:subClassOf nf:Tool ;
    rdfs:label "Genetic Reagent" ;
    rdfs:comment "A genetic reagent, such as a plasmid or vector." .

nf:BacterialExpressionVector a owl:Class ;
    rdfs:subClassOf nf:GeneticReagent ;
    rdfs:label "Bacterial Expression Vector" ;
    rdfs:comment "A bacterial expression vector." .

nf:CRISPRReagent a owl:Class ;
    rdfs:subClassOf nf:GeneticReagent ;
    rdfs:label "CRISPR Reagent" ;
    rdfs:comment "A CRISPR-based genetic reagent." .

nf:sgRNA a owl:Class ;
    rdfs:subClassOf nf:CRISPRReagent ; 
    owl:equivalentClass obo:SO_0001998 ;
    rdfs:label "sgRNA" ;
    rdfs:comment "Single guide RNA used in CRISPR experiments." .

nf:GatewayEntryClone a owl:Class ;
    rdfs:subClassOf nf:GeneticReagent ;
    rdfs:label "Gateway Entry Clone" ;
    rdfs:comment "A Gateway entry clone." .

nf:LentiviralVector a owl:Class ;
    rdfs:subClassOf nf:GeneticReagent ;
    rdfs:label "Lentiviral Vector" ;
    rdfs:comment "A lentiviral vector." .

nf:MammalianExpressionVector a owl:Class ;
    rdfs:subClassOf nf:GeneticReagent ;
    rdfs:label "Mammalian Expression Vector" ;
    rdfs:comment "A mammalian expression vector." .

nf:MouseTargetingVector a owl:Class ;
    rdfs:subClassOf nf:GeneticReagent ;
    rdfs:label "Mouse Targeting Vector" ;
    rdfs:comment "A mouse targeting vector." .

nf:RNAiReagent a owl:Class ;
    rdfs:subClassOf nf:GeneticReagent ;
    owl:equivalentClass obo:SO_0000337 ;
    rdfs:label "RNAi Reagent" .

nf:TransferVector a owl:Class ;
    rdfs:subClassOf nf:GeneticReagent ;
    rdfs:label "Transfer Vector" ;
    rdfs:comment "A transfer vector." .

nf:TransposonVector a owl:Class ;
    rdfs:subClassOf nf:GeneticReagent ;
    rdfs:label "Transposon Vector" ;
    rdfs:comment "A transposon vector." .

nf:YeastExpressionVector a owl:Class ;
    rdfs:subClassOf nf:GeneticReagent ;
    rdfs:label "Yeast Expression Vector" ;
    rdfs:comment "A yeast expression vector." .

nf:Mutation a owl:Class ;
    rdfs:label "Mutation" ;
    rdfs:comment "A genetic mutation." .

nf:SinglePointMutation a owl:Class ;
    rdfs:subClassOf nf:Mutation ;
    rdfs:label "Single Point Mutation" ;
    rdfs:comment "A single nucleotide change." .

nf:IntragenicDeletion a owl:Class ;
    rdfs:subClassOf nf:Mutation ;
    rdfs:label "Intragenic Deletion" ;
    rdfs:comment "A deletion occurring within a gene." .

nf:Insertion a owl:Class ;
    rdfs:subClassOf nf:Mutation ;
    rdfs:label "Insertion" ;
    rdfs:comment "An insertion of genetic material." .

nf:ExogenousDNAExpression a owl:Class ;
    rdfs:subClassOf nf:Mutation ;
    rdfs:label "Exogenous DNA Expression" ;
    rdfs:comment "Expression of exogenously introduced DNA." .

nf:HomozygousDeletion a owl:Class ;
    rdfs:subClassOf nf:Mutation ;
    rdfs:label "Homozygous Deletion" ;
    rdfs:comment "A deletion present on both alleles." .

nf:IntergenicDeletion a owl:Class ;
    rdfs:subClassOf nf:Mutation ;
    rdfs:label "Intergenic Deletion" ;
    rdfs:comment "A deletion spanning regions between genes." .

nf:LossOfHeterozygosity a owl:Class ;
    rdfs:subClassOf nf:Mutation ;
    rdfs:label "Loss of Heterozygosity" ;
    rdfs:comment "Loss of heterozygosity at a locus." .

nf:LossOfHeterozygosityByDeletion a owl:Class ;
    rdfs:subClassOf nf:LossOfHeterozygosity ;
    rdfs:label "Loss of Heterozygosity (Deletion)" ;
    rdfs:comment "Loss of heterozygosity caused by deletion." .

nf:LossOfHeterozygosityByMitoticRecombination a owl:Class ;
    rdfs:subClassOf nf:LossOfHeterozygosity ;
    rdfs:label "Loss of Heterozygosity (Mitotic Recombination)" ;
    rdfs:comment "Loss of heterozygosity caused by mitotic recombination." .

nf:LossOfHeterozygosityUnspecified a owl:Class ;
    rdfs:subClassOf nf:LossOfHeterozygosity ;
    rdfs:label "Loss of Heterozygosity (Unspecified Mechanism)" ;
    rdfs:comment "Loss of heterozygosity by an unspecified mechanism." .

nf:ViralInsertion a owl:Class ;
    rdfs:subClassOf nf:Mutation ;
    rdfs:label "Viral Insertion" ;
    rdfs:comment "An insertion caused by viral integration." .

nf:StableKnockdown a owl:Class ;
    rdfs:subClassOf nf:Mutation ;
    rdfs:label "Stable Knockdown" ;
    rdfs:comment "A stable reduction of gene expression." .

nf:NucleotideSubstitutions a owl:Class ;
    rdfs:subClassOf nf:Mutation ;
    rdfs:label "Nucleotide Substitutions" ;
    rdfs:comment "One or more nucleotide substitutions." .

nf:Microdeletion a owl:Class ;
    rdfs:subClassOf nf:Mutation ;
    rdfs:label "Microdeletion" ;
    rdfs:comment "A small chromosomal deletion." .

nf:Duplication a owl:Class ;
    rdfs:subClassOf nf:Mutation ;
    rdfs:label "Duplication" ;
    rdfs:comment "A duplication of genetic material." .

nf:UnspecifiedMutation a owl:Class ;
    rdfs:subClassOf nf:Mutation ;
    rdfs:label "Unspecified Mutation" ;
    rdfs:comment "A mutation whose type is not specified." .

nf:Genotype a owl:Class ;
    owl:equivalentClass efo:EFO_0000513 ;
    rdfs:label "Genotype" ;
    rdfs:comment "The genetic makeup at a specific locus." .

nf:NF1WildType a owl:Class ;
    rdfs:subClassOf nf:Genotype , efo:EFO_0005168 ;
    rdfs:label "NF1 Wild Type" ;
    rdfs:comment "Wild-type NF1 genotype (+/+)." .

nf:NF1Heterozygous a owl:Class ;
    rdfs:subClassOf nf:Genotype ;
    rdfs:label "NF1 Heterozygous" ;
    rdfs:comment "Heterozygous NF1 genotype (+/-)." .

nf:NF1HomozygousNull a owl:Class ;
    rdfs:subClassOf nf:Genotype ;
    rdfs:label "NF1 Homozygous Null" ;
    rdfs:comment "Homozygous null NF1 genotype (-/-)." .

nf:NF1UnknownGenotype a owl:Class ;
    rdfs:subClassOf nf:Genotype ;
    rdfs:label "NF1 Unknown Genotype" ;
    rdfs:comment "Unknown or unspecified NF1 genotype." .

nf:NF2WildType a owl:Class ;
    rdfs:subClassOf nf:Genotype , efo:EFO_0005168 ;
    rdfs:label "NF2 Wild Type" ;
    rdfs:comment "Wild-type NF2 genotype (+/+)." .

nf:NF2Heterozygous a owl:Class ;
    rdfs:subClassOf nf:Genotype ;
    rdfs:label "NF2 Heterozygous" ;
    rdfs:comment "Heterozygous NF2 genotype (+/-)." .

nf:NF2HomozygousNull a owl:Class ;
    rdfs:subClassOf nf:Genotype ;
    rdfs:label "NF2 Homozygous Null" ;
    rdfs:comment "Homozygous null NF2 genotype (-/-)." .

nf:NF2UnknownGenotype a owl:Class ;
    rdfs:subClassOf nf:Genotype ;
    rdfs:label "NF2 Unknown Genotype" ;
    rdfs:comment "Unknown or unspecified NF2 genotype." .

nf:Donor a owl:Class ;
    rdfs:label "Donor" ;
    rdfs:comment "An individual (human or animal) that donated a specimen." .

nf:CellLine a owl:Class ;
    rdfs:subClassOf nf:Tool ;
    rdfs:label "Cell Line" ;
    rdfs:comment "A cell line used in research." .

nf:CancerCellLine a owl:Class ;
    rdfs:subClassOf nf:CellLine ;
    owl:equivalentClass efo:EFO_0001639 ;
    rdfs:label "Cancer Cell Line" ;
    rdfs:comment "A cell line derived from cancerous tissue." .

nf:TransformedCellLine a owl:Class ;
    rdfs:subClassOf nf:CellLine ;
    rdfs:label "Transformed Cell Line" ;
    rdfs:comment "A cell line that has been artificially transformed." .

nf:InducedPluripotentStemCellLine a owl:Class ;
    rdfs:subClassOf nf:CellLine ;
    owl:equivalentClass efo:EFO_0005740;
    rdfs:label "Induced Pluripotent Stem Cell Line" ;
    rdfs:comment "A cell line derived from iPS cells." .

nf:TelomeraseImmortalizedCellLine a owl:Class ;
    rdfs:subClassOf nf:CellLine ;
    rdfs:label "Telomerase Immortalized Cell Line" ;
    rdfs:comment "A cell line immortalized via telomerase expression." .

nf:EmbryonicStemCellLine a owl:Class ;
    rdfs:subClassOf nf:CellLine ;
    owl:equivalentClass efo:EFO_0005738 ;
    rdfs:label "Embryonic Stem Cell" ;
    rdfs:comment "A cell line derived from embryonic stem cells." .

nf:FiniteCellLine a owl:Class ;
    rdfs:subClassOf nf:CellLine ;
    rdfs:label "Finite Cell Line" ;
    rdfs:comment "A cell line with a limited lifespan in culture." .

nf:SpontaneouslyImmortalizedCellLine a owl:Class ;
    rdfs:subClassOf nf:CellLine ;
    rdfs:label "Spontaneously Immortalized Cell Line" ;
    rdfs:comment "A cell line that became immortalized without deliberate intervention." .

nf:HybridCellLine a owl:Class ;
    rdfs:subClassOf nf:CellLine ;
    rdfs:label "Hybrid Cell Line" ;
    rdfs:comment "A cell line produced by fusing cells from different sources." .

nf:UndefinedCellLineType a owl:Class ;
    rdfs:subClassOf nf:CellLine ;
    rdfs:label "Undefined Cell Line Type" ;
    rdfs:comment "A cell line whose category is undefined." .

nf:Hybridoma a owl:Class ;
    rdfs:subClassOf nf:CellLine ;
    rdfs:label "Hybridoma" ;
    rdfs:comment "A cell line produced by fusing an antibody-producing cell with a myeloma cell." .

nf:Antibody a owl:Class ;
    rdfs:subClassOf nf:Tool ;
    rdfs:label "Antibody" ;
    rdfs:comment "An antibody reagent." .

nf:AnimalModel a owl:Class ;
    rdfs:subClassOf nf:Tool ;
    owl:equivalentClass efo:EFO_0022953 ;
    rdfs:label "Animal Model" ;
    rdfs:comment "An animal model used in research." .

nf:Biobank a owl:Class ;
    rdfs:subClassOf nf:Tool ;
    rdfs:label "Biobank" ;
    rdfs:comment "A biobank that stores and provides biospecimens for research." .

nf:Development a owl:Class ;
    rdfs:label "Development" ;
    rdfs:comment "Development context linking a resource to funders, investigators, and publications." .

nf:Funder a owl:Class ;
    rdfs:label "Funder" ;
    rdfs:comment "A funding organization." .

nf:Investigator a owl:Class ;
    rdfs:label "Investigator" ;
    rdfs:comment "A researcher involved in resource development." .

nf:Publication a owl:Class ;
    rdfs:label "Publication" ;
    rdfs:comment "A scientific publication." .

nf:Data a owl:Class ;
    rdfs:label "Data" ;
    rdfs:comment "A type of data (experimental, clinical, computational, etc.)." .

nf:UnknownDataType a owl:Class ;
    rdfs:subClassOf nf:Data ;
    rdfs:label "Unknown Data Type" ;
    rdfs:comment "Represents a data type that is not recognized or classified." .

nf:Observation a owl:Class ;
    rdfs:label "Observation" ;
    rdfs:comment "An observation for a resource" .

nf:PhenotypeObservation a owl:Class ;
    rdfs:subClassOf nf:Observation ;
    rdfs:label "Phenotype observation" ;
    rdfs:comment "An observation for an animal model or cell line regarding phenotype" .

nf:AssayObservation a owl:Class ;
    rdfs:subClassOf nf:Observation ;
    rdfs:label "Assay observation" ;
    rdfs:comment "An observation describing laboratory assay results, molecular characterization, or experimental findings for a resource, such as drug response, gene expression, cell proliferation, or genomic profiling" .

nf:MethodObservation a owl:Class ;
    rdfs:subClassOf nf:Observation ;
    rdfs:label "Method observation" ;
    rdfs:comment "An observation describing experimental protocols, methods, or conditions, such as breeding strategy, cell culture conditions, or study design" .

nf:ContributedObservation a owl:Class ;
    rdfs:subClassOf nf:Observation ;
    rdfs:label "Contributed observation" ;
    rdfs:comment "Any commentary from community members or depositors; not classified into more specific observation type" .

nf:UsageObservation a owl:Class ;
    rdfs:subClassOf nf:Observation ;
    rdfs:label "Usage observation" ;
    rdfs:comment "An observation providing practical information about resource usage, availability, acquisition, or access requirements" .

nf:DerivationObservation a owl:Class ;
    rdfs:subClassOf nf:Observation ;
    rdfs:label "Derivation observation" ;
    rdfs:comment "An observation describing the origin, lineage, or creation method of a resource, such as cell line derivation, immortalization, or tissue of origin" .

nf:IssueObservation a owl:Class ;
    rdfs:subClassOf nf:Observation ;
    rdfs:label "Issue observation" ;
    rdfs:comment "An observation regarding an issue for a resource, e.g. a QC issue" .

nf:AIAgent a owl:Class ;
    rdfs:subClassOf prov:Agent ;
    rdfs:label "AI Agent" ;
    rdfs:comment "An artificial intelligence agent." .

nf:ObservationExtraction a prov:Activity ;
    rdfs:label "Observation Extraction" ;
    rdfs:comment "An activity in which structured observations are extracted from unstructured text." .

################################################################################
# Properties - File related
################################################################################

nf:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:comment "Name of a resource." ;
    rdfs:range xsd:string .

nf:parentStudy a owl:ObjectProperty ;
    rdfs:label "parentStudy" ;
    rdfs:comment "The study a file belongs to." ;
    rdfs:domain nf:File ;
    rdfs:range nf:Study .

nf:assay a owl:DatatypeProperty ;
    rdfs:label "assay" ;
    rdfs:comment "Assay used to generate the data in this file." ;
    rdfs:domain nf:File ;
    rdfs:range xsd:string .

nf:platform a owl:DatatypeProperty ;
    rdfs:label "platform" ;
    rdfs:comment "Instrument platform (e.g. sequencer, microscope, plate reader)." ;
    rdfs:domain nf:File ;
    rdfs:range xsd:string .

nf:resourceType a owl:DatatypeProperty ;
    rdfs:label "resourceType" ;
    rdfs:comment "The type of resource being stored and annotated." ;
    rdfs:range xsd:string .

nf:dataType a owl:ObjectProperty ;
    rdfs:label "dataType" ;
    rdfs:comment "Links to a data type (experimental, clinical, computational, etc.)." ;
    rdfs:range nf:Data .

nf:dataSubtype a owl:DatatypeProperty ;
    rdfs:label "dataSubtype" ;
    rdfs:comment "Subtype of dataType, e.g. processing state or aggregation level." ;
    rdfs:range xsd:string .

nf:fileFormat a owl:DatatypeProperty ;
    rdfs:label "fileFormat" ;
    rdfs:comment "Format of the file." ;
    rdfs:domain nf:File ;
    rdfs:range xsd:string .

nf:individualID a owl:DatatypeProperty ;
    rdfs:label "individualID" ;
    rdfs:comment "Non-PII identifier for the individual (patient or animal) the data came from." ;
    rdfs:domain nf:File ;
    rdfs:range xsd:string .

nf:nf1Genotype a owl:DatatypeProperty ;
    rdfs:label "nf1Genotype" ;
    rdfs:comment "NF1 genotype of the source biospecimen." ;
    rdfs:domain nf:File ;
    rdfs:range xsd:string .

nf:nf2Genotype a owl:DatatypeProperty ;
    rdfs:label "nf2Genotype" ;
    rdfs:comment "NF2 genotype of the source biospecimen." ;
    rdfs:domain nf:File ;
    rdfs:range xsd:string .

nf:hasNF1Genotype a owl:ObjectProperty ;
    rdfs:label "hasNF1Genotype" ;
    rdfs:comment "Links data to the included NF1 genotype." ;
    rdfs:domain nf:File ;
    rdfs:range nf:Genotype .

nf:hasNF2Genotype a owl:ObjectProperty ;
    rdfs:label "hasNF2Genotype" ;
    rdfs:comment "Links data to the included NF2 genotype." ;
    rdfs:domain nf:File ;
    rdfs:range nf:Genotype .

nf:sex a owl:DatatypeProperty ;
    rdfs:label "sex" ;
    rdfs:comment "Sex of the associated individual/biospecimen." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (nf:File nf:Donor) ] ;
    rdfs:range xsd:string .

nf:species a owl:DatatypeProperty ;
    rdfs:label "species" ;
    rdfs:comment "Taxonomic group of the associated organism." ;
    rdfs:range xsd:string .

nf:cellType a owl:DatatypeProperty ;
    rdfs:label "cellType" ;
    rdfs:comment "Type of cell associated with the resource" ;
    rdfs:range xsd:string .

nf:tissue a owl:DatatypeProperty ;
    rdfs:label "tissue" ;
    rdfs:comment "Tissue type associated with the resource" ;
    rdfs:range xsd:string .

nf:reportMilestone a owl:DatatypeProperty ;
    rdfs:label "reportMilestone" ;
    rdfs:comment "Report milestone associated with the resource." ;
    rdfs:range xsd:double .

nf:compoundName a owl:DatatypeProperty ;
    rdfs:label "compoundName" ;
    rdfs:comment "Name of the compound used in the experiment." ;
    rdfs:range xsd:string .

nf:experimentalCondition a owl:DatatypeProperty ;
    rdfs:label "experimentalCondition" ;
    rdfs:comment "A free-text description of the experimental condition (e.g. 5 mM doxorubicin)." ;
    rdfs:range xsd:string .

nf:modelSystemName a owl:DatatypeProperty ;
    rdfs:label "modelSystemName" ;
    rdfs:comment "Animal model or cell line used." ;
    rdfs:range xsd:string .

nf:hasModelSystem a owl:ObjectProperty ;
    rdfs:label "hasModelSystem" ;
    rdfs:comment "Links a resource to the animal model or cell line involved." ;
    rdfs:range nf:Tool ;
    owl:propertyChainAxiom ( [ owl:inverseOf nf:parentStudy ] nf:hasModelSystem ) .

nf:diagnosis a owl:DatatypeProperty ;
    rdfs:label "diagnosis" ;
    rdfs:comment "Diagnosis associated with the resource." ;
    rdfs:range xsd:string .

nf:specimenID a owl:DatatypeProperty ;
    rdfs:label "specimenID" ;
    rdfs:comment "Non-PII identifier for the source specimen." ;
    rdfs:domain nf:File ;
    rdfs:range xsd:string .

nf:tumorType a owl:DatatypeProperty ;
    rdfs:label "tumorType" ;
    rdfs:comment "Tumor type of the source biospecimen." ;
    rdfs:range xsd:string .

################################################################################
# Properties - Study related
################################################################################

nf:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:comment "Description of the resource." ;
    rdfs:range xsd:string .

nf:initiative a owl:ObjectProperty ;
    rdfs:label "initiative" ;
    rdfs:comment "Refers to a funding initiative." .

nf:studyStatus a owl:DatatypeProperty ;
    rdfs:label "studyStatus" ;
    rdfs:comment "Current status of the study." ;
    rdfs:domain nf:Study ;
    rdfs:range xsd:string .

nf:dataStatus a owl:DatatypeProperty ;
    rdfs:label "dataStatus" ;
    rdfs:comment "Status of the study's data, e.g. 'Under Embargo'." ;
    rdfs:domain nf:Study ;
    rdfs:range xsd:string .

nf:accessRequirements a owl:DatatypeProperty ;
    rdfs:label "accessRequirements" ;
    rdfs:comment "Requirements to access a resource or its data." ;
    rdfs:range xsd:string .

nf:acknowledgementStatements a owl:DatatypeProperty ;
    rdfs:label "acknowledgementStatements" ;
    rdfs:comment "Acknowledgement statements for a resource." ;
    rdfs:range xsd:string .

nf:studyFileviewId a owl:ObjectProperty ;
    rdfs:label "studyFileviewId" ;
    rdfs:comment "Synapse ID of the study file view." ;
    rdfs:domain nf:Study .

nf:studyLeads a owl:DatatypeProperty ;
    rdfs:label "studyLeads" ;
    rdfs:comment "Principal investigators or leads of a study or project." ;
    rdfs:range xsd:string .

nf:institutions a owl:DatatypeProperty ;
    rdfs:label "institutions" ;
    rdfs:comment "Institutions involved in a study, project, or resource development." ;
    rdfs:range xsd:string .

nf:manifestation a owl:DatatypeProperty ;
    rdfs:label "manifestation" ;
    rdfs:comment "Disease phenotype modeled or studied by the resource." ;
    rdfs:range xsd:string .

nf:diseaseFocus a owl:DatatypeProperty ;
    rdfs:label "diseaseFocus" ;
    rdfs:comment "The disease or diseases that are the primary focus of a resource." ;
    rdfs:range xsd:string .

nf:relatedStudies a owl:ObjectProperty ;
    rdfs:label "relatedStudies" ;
    rdfs:comment "Other studies related to this study." ;
    rdfs:domain nf:Study ;
    rdfs:range nf:Study .

nf:grantDOI a owl:ObjectProperty ;
    rdfs:label "grantDOI" ;
    rdfs:comment "DOI of grant(s) associated with a resource." .

################################################################################
# Properties - Tool and Shared related
################################################################################

# Genetic Reagent - universal properties
nf:geneticReagentId a owl:DatatypeProperty ;
    rdfs:label "geneticReagentId" ;
    rdfs:comment "A unique identifier for a genetic reagent." ;
    rdfs:domain nf:GeneticReagent ;
    rdfs:range xsd:string .

nf:insertName a owl:DatatypeProperty ;
    rdfs:label "insertName" ;
    rdfs:comment "Name of the insert in the genetic reagent." ;
    rdfs:domain nf:GeneticReagent ;
    rdfs:range xsd:string .

nf:insertSpecies a owl:DatatypeProperty ;
    rdfs:label "insertSpecies" ;
    rdfs:comment "Species of origin for the insert." ;
    rdfs:domain nf:GeneticReagent ;
    rdfs:range xsd:string .

nf:vectorBackbone a owl:DatatypeProperty ;
    rdfs:label "vectorBackbone" ;
    rdfs:comment "The backbone vector used." ;
    rdfs:domain nf:GeneticReagent ;
    rdfs:range xsd:string .

nf:hazardous a owl:DatatypeProperty ;
    rdfs:label "hazardous" ;
    rdfs:comment "Whether the reagent is hazardous." ;
    rdfs:domain nf:GeneticReagent ;
    rdfs:range xsd:string .

# Genetic Reagent - properties shared by most vector/clone types
nf:insertEntrezId a owl:DatatypeProperty ;
    rdfs:label "insertEntrezId" ;
    rdfs:comment "Entrez gene ID of the insert." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (nf:BacterialExpressionVector nf:CRISPRReagent nf:GatewayEntryClone nf:LentiviralVector nf:RNAiReagent nf:TransferVector nf:YeastExpressionVector) ] ;
    rdfs:range xsd:string .

nf:insertSize a owl:DatatypeProperty ;
    rdfs:label "insertSize" ;
    rdfs:comment "Size of the insert in base pairs." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (nf:BacterialExpressionVector nf:GatewayEntryClone nf:LentiviralVector nf:MammalianExpressionVector nf:RNAiReagent nf:TransferVector nf:YeastExpressionVector) ] ;
    rdfs:range xsd:string .

nf:totalSize a owl:DatatypeProperty ;
    rdfs:label "totalSize" ;
    rdfs:comment "Total size of the construct in base pairs." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (nf:GatewayEntryClone nf:LentiviralVector nf:MammalianExpressionVector nf:MouseTargetingVector nf:RNAiReagent nf:TransferVector) ] ;
    rdfs:range xsd:string .

nf:backboneSize a owl:DatatypeProperty ;
    rdfs:label "backboneSize" ;
    rdfs:comment "Size of the vector backbone in base pairs." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (nf:GatewayEntryClone nf:LentiviralVector nf:MammalianExpressionVector nf:RNAiReagent nf:TransferVector nf:YeastExpressionVector) ] ;
    rdfs:range xsd:string .

nf:cloningMethod a owl:DatatypeProperty ;
    rdfs:label "cloningMethod" ;
    rdfs:comment "Method used for cloning." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (nf:BacterialExpressionVector nf:GatewayEntryClone nf:LentiviralVector nf:TransferVector nf:YeastExpressionVector) ] ;
    rdfs:range xsd:string .

nf:copyNumber a owl:DatatypeProperty ;
    rdfs:label "copyNumber" ;
    rdfs:comment "Plasmid copy number." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (nf:GatewayEntryClone nf:LentiviralVector nf:MammalianExpressionVector nf:MouseTargetingVector nf:RNAiReagent nf:TransferVector nf:YeastExpressionVector) ] ;
    rdfs:range xsd:string .

nf:promoter a owl:DatatypeProperty ;
    rdfs:label "promoter" ;
    rdfs:comment "Promoter driving expression." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (nf:BacterialExpressionVector nf:LentiviralVector nf:RNAiReagent nf:TransferVector nf:YeastExpressionVector) ] ;
    rdfs:range xsd:string .

nf:bacterialResistance a owl:DatatypeProperty ;
    rdfs:label "bacterialResistance" ;
    rdfs:comment "Bacterial antibiotic resistance marker." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (nf:GatewayEntryClone nf:LentiviralVector nf:MammalianExpressionVector nf:MouseTargetingVector nf:RNAiReagent nf:TransferVector nf:YeastExpressionVector) ] ;
    rdfs:range xsd:string .

nf:growthTemp a owl:DatatypeProperty ;
    rdfs:label "growthTemp" ;
    rdfs:comment "Recommended bacterial growth temperature." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (nf:GatewayEntryClone nf:LentiviralVector nf:MammalianExpressionVector nf:MouseTargetingVector nf:RNAiReagent nf:TransferVector nf:YeastExpressionVector) ] ;
    rdfs:range xsd:string .

nf:growthStrain a owl:DatatypeProperty ;
    rdfs:label "growthStrain" ;
    rdfs:comment "Recommended bacterial growth strain." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (nf:GatewayEntryClone nf:LentiviralVector nf:MammalianExpressionVector nf:MouseTargetingVector nf:RNAiReagent nf:TransferVector nf:YeastExpressionVector) ] ;
    rdfs:range xsd:string .

nf:selectableMarker a owl:DatatypeProperty ;
    rdfs:label "selectableMarker" ;
    rdfs:comment "Selectable marker for mammalian cell selection." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (nf:LentiviralVector nf:MammalianExpressionVector nf:MouseTargetingVector nf:RNAiReagent nf:TransferVector) ] ;
    rdfs:range xsd:string .

nf:nTerminalTag a owl:DatatypeProperty ;
    rdfs:label "nTerminalTag" ;
    rdfs:comment "N-terminal fusion tag." ;
    rdfs:domain nf:GeneticReagent ;
    rdfs:range xsd:string .

nf:cTerminalTag a owl:DatatypeProperty ;
    rdfs:label "cTerminalTag" ;
    rdfs:comment "C-terminal fusion tag." ;
    rdfs:domain nf:GeneticReagent ;
    rdfs:range xsd:string .

nf:fivePrimer a owl:DatatypeProperty ;
    rdfs:label "fivePrimer" ;
    rdfs:comment "Sequence of the 5' primer." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (nf:GatewayEntryClone nf:TransferVector) ] ;
    rdfs:range xsd:string .

nf:threePrimer a owl:DatatypeProperty ;
    rdfs:label "threePrimer" ;
    rdfs:comment "Sequence of the 3' primer." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (nf:GatewayEntryClone nf:TransferVector) ] ;
    rdfs:range xsd:string .

nf:fivePrimeCloningSite a owl:DatatypeProperty ;
    rdfs:label "fivePrimeCloningSite" ;
    rdfs:comment "Restriction site at the 5' end of the insert." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (nf:BacterialExpressionVector nf:LentiviralVector nf:TransferVector nf:YeastExpressionVector) ] ;
    rdfs:range xsd:string .

nf:threePrimeCloningSite a owl:DatatypeProperty ;
    rdfs:label "threePrimeCloningSite" ;
    rdfs:comment "Restriction site at the 3' end of the insert." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (nf:BacterialExpressionVector nf:LentiviralVector nf:TransferVector nf:YeastExpressionVector) ] ;
    rdfs:range xsd:string .

nf:fivePrimeSiteDestroyed a owl:DatatypeProperty ;
    rdfs:label "fivePrimeSiteDestroyed" ;
    rdfs:comment "Whether the 5' restriction site is destroyed after cloning." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (nf:BacterialExpressionVector nf:CRISPRReagent nf:GatewayEntryClone nf:LentiviralVector nf:TransferVector nf:TransposonVector nf:YeastExpressionVector) ] ;
    rdfs:range xsd:string .

nf:threePrimeSiteDestroyed a owl:DatatypeProperty ;
    rdfs:label "threePrimeSiteDestroyed" ;
    rdfs:comment "Whether the 3' restriction site is destroyed after cloning." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (nf:BacterialExpressionVector nf:CRISPRReagent nf:GatewayEntryClone nf:LentiviralVector nf:TransferVector nf:TransposonVector nf:YeastExpressionVector) ] ;
    rdfs:range xsd:string .

nf:gRNAshRNASequence a owl:DatatypeProperty ;
    rdfs:label "gRNAshRNASequence" ;
    rdfs:comment "Guide RNA or shRNA target sequence." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (nf:LentiviralVector nf:MammalianExpressionVector nf:MouseTargetingVector nf:RNAiReagent) ] ;
    rdfs:range xsd:string .

# Mutation
nf:mutationId a owl:DatatypeProperty ;
    rdfs:label "mutationId" ;
    rdfs:comment "A unique identifier for a mutation." ;
    rdfs:domain nf:Mutation ;
    rdfs:range xsd:string .

nf:affectedGeneSymbol a owl:DatatypeProperty ;
    rdfs:label "affectedGeneSymbol" ;
    rdfs:comment "HGNC symbol of the gene affected by the mutation." ;
    rdfs:domain nf:Mutation ;
    rdfs:range xsd:string .

nf:affectedGeneName a owl:DatatypeProperty ;
    rdfs:label "affectedGeneName" ;
    rdfs:comment "Full name of the gene affected by the mutation." ;
    rdfs:domain nf:Mutation ;
    rdfs:range xsd:string .

nf:humanClinVarMutation a owl:DatatypeProperty ;
    rdfs:label "humanClinVarMutation" ;
    rdfs:comment "ClinVar identifier for the human mutation." ;
    rdfs:domain nf:Mutation ;
    rdfs:range xsd:string .

nf:externalMutationID a owl:ObjectProperty ;
    rdfs:label "externalMutationID" ;
    rdfs:comment "Link to an external mutation database entry." ;
    rdfs:domain nf:Mutation .

nf:sequenceVariation a owl:DatatypeProperty ;
    rdfs:label "sequenceVariation" ;
    rdfs:comment "HGVS coding DNA sequence variation notation." ;
    rdfs:domain nf:Mutation ;
    rdfs:range xsd:string .

nf:proteinVariation a owl:DatatypeProperty ;
    rdfs:label "proteinVariation" ;
    rdfs:comment "HGVS protein variation notation." ;
    rdfs:domain nf:Mutation ;
    rdfs:range xsd:string .

nf:chromosome a owl:DatatypeProperty ;
    rdfs:label "chromosome" ;
    rdfs:comment "Chromosome on which the mutation is located." ;
    rdfs:domain nf:Mutation ;
    rdfs:range xsd:string .

nf:animalModelMutation a owl:DatatypeProperty ;
    rdfs:label "animalModelMutation" ;
    rdfs:comment "Description of the mutation as engineered in the animal model." ;
    rdfs:domain nf:Mutation ;
    rdfs:range xsd:string .

nf:alleleType a owl:DatatypeProperty ;
    rdfs:label "alleleType" ;
    rdfs:comment "Type of allele (e.g. knockout, knock-in, point mutation)." ;
    rdfs:domain nf:Mutation ;
    rdfs:range xsd:string .

nf:mutationMethod a owl:DatatypeProperty ;
    rdfs:label "mutationMethod" ;
    rdfs:comment "Method used to introduce the mutation." ;
    rdfs:domain nf:Mutation ;
    rdfs:range xsd:string .

nf:hasMutation a owl:ObjectProperty ;
    rdfs:label "hasMutation" ;
    rdfs:comment "Links a resource (cell line, animal model, etc.) to a mutation it carries." ;
    rdfs:range nf:Mutation .

# Donor
nf:donorId a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf (nf:Donor nf:CellLine nf:AnimalModel) ] ;
    rdfs:range xsd:string .

nf:age a owl:DatatypeProperty ;
    rdfs:label "age" ;
    rdfs:comment "Age of the donor." ;
    rdfs:domain nf:Donor ;
    rdfs:range xsd:string .

nf:race a owl:DatatypeProperty ;
    rdfs:label "race" ;
    rdfs:comment "Race or ethnicity of the donor." ;
    rdfs:domain nf:Donor ;
    rdfs:range xsd:string .

nf:transplantationDonorId a owl:ObjectProperty ;
    rdfs:label "transplantationDonorId" ;
    rdfs:comment "Links to the donor that provided transplanted material." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (nf:Donor nf:AnimalModel) ] ;
    rdfs:range nf:Donor .

nf:parentDonorId a owl:ObjectProperty ;
    rdfs:label "parentDonorId" ;
    rdfs:comment "Parent donor, representing isogenic or derivative lineage." ;
    rdfs:domain nf:Donor ;
    rdfs:range nf:Donor .

nf:fromDonor a owl:ObjectProperty ;
    rdfs:label "fromDonor" ;
    rdfs:comment "Links a resource (cell line, animal model) to the donor it was derived from." ;
    rdfs:range nf:Donor ;
    owl:inverseOf nf:hasDerivedResource .

