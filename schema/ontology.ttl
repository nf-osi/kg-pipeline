    rdfs:range xsd:string .

# Animal Model
nf:animalModelId a owl:DatatypeProperty ;
    rdfs:domain nf:AnimalModel ;
    rdfs:range xsd:string .

nf:backgroundStrain a owl:DatatypeProperty ;
    rdfs:domain nf:AnimalModel ;
    rdfs:range xsd:string .

nf:backgroundSubstrain a owl:DatatypeProperty ;
    rdfs:label "backgroundSubstrain" ;
    rdfs:comment "Background substrain of the animal model." ;
    rdfs:domain nf:AnimalModel ;
    rdfs:range xsd:string .

nf:strainNomenclature a owl:DatatypeProperty ;
    rdfs:label "strainNomenclature" ;
    rdfs:comment "Official strain nomenclature." ;
    rdfs:domain nf:AnimalModel ;
    rdfs:range xsd:string .

nf:transplantationType a owl:DatatypeProperty ;
    rdfs:domain nf:AnimalModel ;
    rdfs:range xsd:string .

nf:animalState a owl:DatatypeProperty ;
    rdfs:label "animalState" ;
    rdfs:comment "State of the animal (e.g. live, cryopreserved)." ;
    rdfs:domain nf:AnimalModel ;
    rdfs:range xsd:string .

nf:generation a owl:DatatypeProperty ;
    rdfs:label "generation" ;
    rdfs:comment "Generation or breeding status of the animal model." ;
    rdfs:domain nf:AnimalModel ;
    rdfs:range xsd:string .


# Biobank
nf:biobankURL a owl:ObjectProperty ;
    rdfs:label "biobankURL" ;
    rdfs:comment "URL of the biobank's website." ;
    rdfs:domain nf:Biobank .

nf:contact a owl:DatatypeProperty ;
    rdfs:label "contact" ;
    rdfs:comment "Contact information for the biobank." ;
    rdfs:domain nf:Biobank ;
    rdfs:range xsd:string .

nf:hasResource a owl:ObjectProperty ;
    rdfs:label "hasResource" ;
    rdfs:comment "Links a biobank to a resource it provides." ;
    rdfs:domain nf:Biobank ;
    rdfs:range nf:Tool .

nf:diseaseType a owl:DatatypeProperty ;
    rdfs:label "diseaseType" ;
    rdfs:comment "Disease type of the biobank's specimens." ;
    rdfs:domain nf:Biobank ;
    rdfs:range xsd:string .

nf:specimenPreparationMethod a owl:DatatypeProperty ;
    rdfs:label "specimenPreparationMethod" ;
    rdfs:comment "Method used to prepare specimens (e.g. Flash frozen, FFPE, Cryopreserved)." ;
    rdfs:domain nf:Biobank ;
    rdfs:range xsd:string .

nf:specimenType a owl:DatatypeProperty ;
    rdfs:label "specimenType" ;
    rdfs:comment "Type of specimen available (e.g. cell lines, human tissue)." ;
    rdfs:domain nf:Biobank ;
    rdfs:range xsd:string .

nf:specimenFormat a owl:DatatypeProperty ;
    rdfs:label "specimenFormat" ;
    rdfs:comment "Format of the specimen (e.g. DNA, RNA, whole tumor)." ;
    rdfs:domain nf:Biobank ;
    rdfs:range xsd:string .

nf:specimenTissueType a owl:DatatypeProperty ;
    rdfs:label "specimenTissueType" ;
    rdfs:comment "Type of tissue the specimen is derived from (e.g. Tumor, Blood, Brain)." ;
    rdfs:domain nf:Biobank ;
    rdfs:range xsd:string .

# Shared properties
nf:geneticDisorder a owl:DatatypeProperty ;
    rdfs:label "geneticDisorder" ;
    rdfs:comment "Genetic disorder associated with the resource." ;
    rdfs:range xsd:string .

nf:organ a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf (nf:File nf:CellLine) ] ;
    rdfs:range xsd:string .

nf:rrid a owl:ObjectProperty ;
    rdfs:label "rrid" ;
    rdfs:comment "Research Resource Identifier (RRID) for a resource." .

nf:usageRequirements a owl:DatatypeProperty ;
    rdfs:label "usageRequirements" ;
    rdfs:comment "Requirements or restrictions for using a resource." ;
    rdfs:range xsd:string .

nf:synonyms a owl:DatatypeProperty ;
    rdfs:label "synonyms" ;
    rdfs:comment "Alternative names for the resource." ;
    rdfs:range xsd:string .

nf:howToAcquire a owl:DatatypeProperty ;
    rdfs:label "howToAcquire" ;
    rdfs:comment "How to acquire the resource." ;
    rdfs:range xsd:string .

nf:dateAdded a owl:DatatypeProperty ;
    rdfs:label "dateAdded" ;
    rdfs:comment "Date the resource was added." ;
    rdfs:range xsd:string .

nf:dateModified a owl:DatatypeProperty ;
    rdfs:label "dateModified" ;
    rdfs:comment "Date the resource was last modified." ;
    rdfs:range xsd:string .

################################################################################
# Properties - Development related
################################################################################

nf:resourceId a owl:ObjectProperty ;
    rdfs:label "resourceId" ;
    rdfs:comment "Canonical resource ID." ;
    rdfs:range nf:Tool .

# Funder
nf:hasFunder a owl:ObjectProperty ;
    rdfs:label "hasFunder" ;
    rdfs:comment "Links to the funding organization." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (nf:File nf:Study nf:Development) ] ;
    rdfs:range nf:Funder .

# Investigator
nf:investigatorSynapseId a owl:DatatypeProperty ;
    rdfs:label "investigatorSynapseId" ;
    rdfs:comment "Synapse user ID of the investigator." ;
    rdfs:domain nf:Investigator ;
    rdfs:range xsd:string .

nf:institution a owl:DatatypeProperty ;
    rdfs:label "institution" ;
    rdfs:comment "Affiliated institution." ;
    rdfs:domain nf:Investigator ;
    rdfs:range xsd:string .

nf:orcid a owl:DatatypeProperty ;
    rdfs:label "orcid" ;
    rdfs:comment "ORCID identifier for an investigator." ;
    rdfs:domain nf:Investigator ;
    rdfs:range xsd:string .

nf:hasInvestigator a owl:ObjectProperty ;
    rdfs:label "hasInvestigator" ;
    rdfs:comment "Links a development record to an investigator." ;
    rdfs:domain nf:Development ;
    rdfs:range nf:Investigator .

# Publication
nf:doi a owl:ObjectProperty ;
    rdfs:label "doi" ;
    rdfs:comment "DOI (Digital Object Identifier) of a resource." .

nf:citation a owl:DatatypeProperty ;
    rdfs:label "citation" ;
    rdfs:comment "Formatted citation string." ;
    rdfs:domain nf:Publication ;
    rdfs:range xsd:string .

nf:publicationTitle a owl:DatatypeProperty ;
    rdfs:label "publicationTitle" ;
    rdfs:comment "Title of the publication." ;
    rdfs:domain nf:Publication ;
    rdfs:range xsd:string .

nf:abstract a owl:DatatypeProperty ;
    rdfs:label "abstract" ;
    rdfs:comment "Abstract of the publication." ;
    rdfs:domain nf:Publication ;
    rdfs:range xsd:string .

nf:publicationDate a owl:DatatypeProperty ;
    rdfs:label "publicationDate" ;
    rdfs:comment "Publication date." ;
    rdfs:domain nf:Publication ;
    rdfs:range xsd:string .

nf:publicationDateUnix a owl:DatatypeProperty ;
    rdfs:label "publicationDateUnix" ;
    rdfs:comment "Publication date as Unix timestamp." ;
    rdfs:domain nf:Publication ;
    rdfs:range xsd:string .

nf:journal a owl:DatatypeProperty ;
    rdfs:label "journal" ;
    rdfs:comment "Journal in which the publication appeared." ;
    rdfs:domain nf:Publication ;
    rdfs:range xsd:string .

nf:pmid a owl:ObjectProperty ;
    rdfs:label "pmid" ;
    rdfs:comment "PubMed ID of the publication." ;
    rdfs:domain nf:Publication .

nf:authors a owl:DatatypeProperty ;
    rdfs:label "authors" ;
    rdfs:comment "Authors of the publication." ;
    rdfs:domain nf:Publication ;
    rdfs:range xsd:string .

nf:hasPublication a owl:ObjectProperty ;
    rdfs:label "hasPublication" ;
    rdfs:comment "Links a development record to a publication." ;
    rdfs:range nf:Publication .

################################################################################
# Properties - Observation related
################################################################################

nf:observationId a owl:DatatypeProperty ;
    rdfs:label "observationId" ;
    rdfs:comment "A unique identifier for an observation." ;
    rdfs:domain nf:Observation ;
    rdfs:range xsd:string .

nf:observationText a owl:DatatypeProperty ;
    rdfs:label "observationText" ;
    rdfs:comment "The text content of an observation." ;
    rdfs:domain nf:Observation ;
    rdfs:range xsd:string .

nf:observationSubmitterName a owl:DatatypeProperty ;
    rdfs:label "observationSubmitterName" ;
    rdfs:comment "Submitter name." ;
    rdfs:domain nf:Observation ;
    rdfs:range xsd:string .

nf:observationPhase a owl:DatatypeProperty ;
    rdfs:label "observationPhase" ;
    rdfs:comment "Phase or stage of the observation (e.g. summary, detailed)." ;
    rdfs:domain nf:Observation ;
    rdfs:range xsd:string .

nf:observationTime a owl:DatatypeProperty ;
    rdfs:label "observationTime" ;
    rdfs:comment "Timestamp of the observation." ;
    rdfs:domain nf:Observation ;
    rdfs:range xsd:decimal .

nf:observationTimeUnits a owl:DatatypeProperty ;
    rdfs:label "observationTimeUnits" ;
    rdfs:comment "Units of the observation timestamp (e.g. milliseconds)." ;
    rdfs:domain nf:Observation ;
    rdfs:range xsd:string .

nf:observationLink a owl:ObjectProperty ;
    rdfs:label "observationLink" ;
    rdfs:comment "Link to supporting material." ;
    rdfs:domain nf:Observation .

nf:reliabilityRating a owl:DatatypeProperty ;
    rdfs:label "reliabilityRating" ;
    rdfs:comment "Reliability rating." ;
    rdfs:domain nf:Observation ;
    rdfs:range xsd:string .

nf:easeOfUseRating a owl:DatatypeProperty ;
    rdfs:label "easeOfUseRating" ;
    rdfs:comment "Ease-of-use rating." ;
    rdfs:domain nf:Observation ;
    rdfs:range xsd:string .

nf:aboutResource a owl:ObjectProperty ;
    rdfs:label "aboutResource" ;
    rdfs:comment "Links an observation to the resource it describes." ;
    rdfs:domain nf:Observation ;
    rdfs:range nf:Tool .

nf:referencesPublication a owl:ObjectProperty ;
    rdfs:label "referencesPublication" ;
    rdfs:comment "Links an observation to a supporting publication." ;
    rdfs:domain nf:Observation ;
    rdfs:range nf:Publication .

################################################################################
# Classes - Text entity annotations (from PubTator3 text index)
################################################################################

nf:Gene a owl:Class ;
    owl:equivalentClass <http://purl.uniprot.org/core/Gene> ;
    rdfs:label "Gene" ;
    rdfs:comment "A gene entity annotated in publication text." .

nf:DiseaseAnnotation a owl:Class ;
    rdfs:subClassOf <http://purl.uniprot.org/core/Disease_Annotation> ;
    rdfs:label "Disease Annotation" ;
    rdfs:comment "A disease entity annotated in publication text." .

nf:Chemical a owl:Class ;
    rdfs:label "Chemical" ;
    rdfs:comment "A chemical entity annotated in publication text." .

nf:Variant a owl:Class ;
    owl:equivalentClass obo:SO_0001564 ;
    rdfs:label "Variant" ;
    rdfs:comment "A genetic variant annotated in publication text." .