################################################################################

nf:derivationSource a owl:DatatypeProperty ;
    rdfs:label "derivationSource" ;
    rdfs:comment "Source tissue or material from which the organoid is derived." ;
    rdfs:domain nf:OrganoidProtocol ;
    rdfs:range xsd:string .

nf:cellTypes a owl:DatatypeProperty ;
    rdfs:label "cellTypes" ;
    rdfs:comment "Cell types present in or targeted by the organoid culture." ;
    rdfs:domain nf:OrganoidProtocol ;
    rdfs:range xsd:string .

nf:organoidType a owl:DatatypeProperty ;
    rdfs:label "organoidType" ;
    rdfs:comment "Type of organoid (e.g. intestinal, brain, tumor)." ;
    rdfs:domain nf:OrganoidProtocol ;
    rdfs:range xsd:string .

nf:matrixType a owl:DatatypeProperty ;
    rdfs:label "matrixType" ;
    rdfs:comment "Extracellular matrix or scaffold type used in the organoid culture." ;
    rdfs:domain nf:OrganoidProtocol ;
    rdfs:range xsd:string .

nf:cultureSystem a owl:DatatypeProperty ;
    rdfs:label "cultureSystem" ;
    rdfs:comment "Culture system format (e.g. embedded, suspension, air-liquid interface)." ;
    rdfs:domain nf:OrganoidProtocol ;
    rdfs:range xsd:string .

nf:maturationTime a owl:DatatypeProperty ;
    rdfs:label "maturationTime" ;
    rdfs:comment "Time required for organoid maturation." ;
    rdfs:domain nf:OrganoidProtocol ;
    rdfs:range xsd:string .

nf:characterizationMethods a owl:DatatypeProperty ;
