    rdfs:comment "Whether the cell line is contaminated or misidentified." ;
    rdfs:domain nf:CellLine ;
    rdfs:range xsd:string .

nf:populationDoublingTime a owl:DatatypeProperty ;
    rdfs:label "populationDoublingTime" ;
    rdfs:comment "Population doubling time of the cell line." ;
    rdfs:domain nf:CellLine ;
    rdfs:range xsd:string .

# Antibody
nf:antibodyId a owl:DatatypeProperty ;
    rdfs:domain nf:Antibody ;
    rdfs:range xsd:string .

nf:targetAntigen a owl:DatatypeProperty ;
    rdfs:domain nf:Antibody ;
    rdfs:range xsd:string .

nf:uniprotId a owl:ObjectProperty ;
    rdfs:label "uniprotId" ;
