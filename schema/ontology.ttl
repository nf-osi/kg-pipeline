    rdfs:domain nf:OrganoidProtocol ;
    rdfs:range xsd:string .

nf:qualityControlMetrics a owl:DatatypeProperty ;
    rdfs:label "qualityControlMetrics" ;
    rdfs:comment "Quality control metrics applied to assess organoid integrity and function." ;
    rdfs:domain nf:OrganoidProtocol ;
    rdfs:range xsd:string .

nf:cultureMedia a owl:DatatypeProperty ;
    rdfs:label "cultureMedia" ;
    rdfs:comment "Composition of the culture media used to maintain the organoid." ;
    rdfs:domain nf:OrganoidProtocol ;
    rdfs:range xsd:string .

