    rdfs:domain biolink:Dataset ;
    rdfs:range xsd:string .

nf:versionLabel a owl:DatatypeProperty ;
    rdfs:label "versionLabel" ;
    rdfs:comment "Human-readable label for the dataset version." ;
    rdfs:domain biolink:Dataset ;
    rdfs:range xsd:string .

nf:externalRepositoryUri a owl:ObjectProperty ;
    rdfs:label "externalRepositoryUri" ;
    rdfs:comment "URI of an external repository where the dataset is also deposited." ;
    rdfs:domain biolink:Dataset .

################################################################################
# Properties - Development related
################################################################################

nf:resourceId a owl:ObjectProperty ;
    rdfs:label "resourceId" ;
    rdfs:comment "Canonical resource ID." ;
    rdfs:range nf:Tool .

# Funder
nf:hasFunder a owl:ObjectProperty ;
    rdfs:label "hasFunder" ;
    rdfs:comment "Links to the funding organization." ;
    rdfs:domain [ a owl:Class ; owl:unionOf (nf:File biolink:Study nf:Development) ] ;
    rdfs:range nf:Funder .

# Investigator
nf:investigatorSynapseId a owl:DatatypeProperty ;
    rdfs:label "investigatorSynapseId" ;
    rdfs:comment "Synapse user ID of the investigator." ;
    rdfs:domain nf:Investigator ;
    rdfs:range xsd:string .

nf:institution a owl:DatatypeProperty ;
    rdfs:label "institution" ;
    rdfs:comment "Affiliated institution." ;
    rdfs:domain nf:Investigator ;
    rdfs:range xsd:string .

nf:orcid a owl:DatatypeProperty ;
    rdfs:label "orcid" ;
    rdfs:comment "ORCID identifier for an investigator." ;
    rdfs:domain nf:Investigator ;
    rdfs:range xsd:string .

nf:hasInvestigator a owl:ObjectProperty ;
    rdfs:label "hasInvestigator" ;
    rdfs:comment "Links a development record to an investigator." ;
    rdfs:domain nf:Development ;
    rdfs:range nf:Investigator .

nf:createdBy a owl:ObjectProperty ;
    rdfs:label "createdBy" ;
    rdfs:comment "Synapse user who created the entity." ;
    rdfs:domain nf:File .

nf:modifiedBy a owl:ObjectProperty ;
    rdfs:label "modifiedBy" ;
    rdfs:comment "Synapse user who last modified the entity." ;
    rdfs:domain nf:File .

# Publication
nf:doi a owl:ObjectProperty ;
    rdfs:label "doi" ;
    rdfs:comment "DOI (Digital Object Identifier) of a resource." .

nf:citation a owl:DatatypeProperty ;
    rdfs:label "citation" ;
    rdfs:comment "Formatted citation string." ;
    rdfs:domain biolink:Publication ;
    rdfs:range xsd:string .

nf:publicationTitle a owl:DatatypeProperty ;
    rdfs:label "publicationTitle" ;
    rdfs:comment "Title of the publication." ;
    rdfs:domain biolink:Publication ;
    rdfs:range xsd:string .

nf:abstract a owl:DatatypeProperty ;
    rdfs:label "abstract" ;
    rdfs:comment "Abstract of the publication." ;
    rdfs:domain biolink:Publication ;
    rdfs:range xsd:string .

nf:publicationDate a owl:DatatypeProperty ;
    rdfs:label "publicationDate" ;
    rdfs:comment "Publication date." ;
    rdfs:domain biolink:Publication ;
    rdfs:range xsd:string .

nf:publicationDateUnix a owl:DatatypeProperty ;
    rdfs:label "publicationDateUnix" ;
    rdfs:comment "Publication date as Unix timestamp." ;
    rdfs:domain biolink:Publication ;
    rdfs:range xsd:string .

nf:journal a owl:DatatypeProperty ;
    rdfs:label "journal" ;
    rdfs:comment "Journal in which the publication appeared." ;
    rdfs:domain biolink:Publication ;
    rdfs:range xsd:string .

nf:pmid a owl:ObjectProperty ;
    rdfs:label "pmid" ;
    rdfs:comment "PubMed ID of the publication." ;
    rdfs:domain biolink:Publication .

nf:authors a owl:DatatypeProperty ;
    rdfs:label "authors" ;
    rdfs:comment "Authors of the publication." ;
    rdfs:domain biolink:Publication ;
    rdfs:range xsd:string .

nf:inFullTextIndex a owl:DatatypeProperty ;
    rdfs:label "inFullTextIndex" ;
    rdfs:comment "Whether the publication is included in the project full-text index." ;
    rdfs:domain biolink:Publication ;
    rdfs:range xsd:boolean .

nf:hasPublication a owl:ObjectProperty ;
    rdfs:label "hasPublication" ;
    rdfs:comment "Links a development record to a publication." ;
    rdfs:range biolink:Publication .

