################################################################################
# Classes - Text entity annotations (from PubTator3 text index)
################################################################################

nf:Gene a owl:Class ;
    rdfs:subClassOf biolink:Gene ;
    owl:equivalentClass <http://purl.uniprot.org/core/Gene> ;
    rdfs:label "Gene" ;
    rdfs:comment "A gene entity annotated in publication text." .

nf:DiseaseAnnotation a owl:Class ;
    rdfs:subClassOf <http://purl.uniprot.org/core/Disease_Annotation> ;
    rdfs:label "Disease Annotation" ;
    rdfs:comment "A disease entity annotated in publication text." .

# nf:Chemical replaced by biolink:ChemicalEntity

nf:Variant a owl:Class ;
    rdfs:subClassOf biolink:SequenceVariant ;
    owl:equivalentClass obo:SO_0001564 ;
    rdfs:label "Variant" ;
    rdfs:comment "A genetic variant annotated in publication text." .
