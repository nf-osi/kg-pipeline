        rdfs:subClassOf  :Platform ;
        rdf:type         owl:Class ;
        rdfs:comment     "Illumina Human Whole-Genome DASL HT" .

:IlluminaHumanHap300  rdf:type  owl:Class ;
        rdfs:subClassOf  :Platform .

:NanostringnCounter  rdf:type  owl:Class ;
        rdfs:subClassOf  :Platform .

:LTQ_Orbitrap_XL  rdfs:comment  "LTQ Orbitrap XL Hybrid Ion Trap-Orbitrap Mass Spectrometer" ;
        rdfs:subClassOf  :Platform ;
        rdf:type         owl:Class .

:IlluminaHumanMethylation450
        rdfs:comment     "Illumina HumanMethylation450 BeadChip" ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Platform .

:Illumina_Infinium_MethylationEPIC_BeadChip
        rdfs:comment     "An Illumina methylation BeadChip which is an array that interrogates ~ 850,000 methylation sites per sample at single-nucleotide resolution." ;
        rdfs:subClassOf  :Platform ;
        rdf:type         owl:Class .

:AffymetrixU133AB  rdfs:subClassOf  :Platform ;
        rdf:type         owl:Class .

:Affymetrix_Human_Gene_1.0_ST_Array
        rdfs:subClassOf  :Platform ;
        rdfs:comment     "Affymetrix Human Gene 1.0 ST Array [transcript (gene) version] in situ oligonucleotide" ;
        rdf:type         owl:Class .

:AffymetrixU133Plus2  rdfs:subClassOf  :Platform ;
        rdf:type         owl:Class ;
        rdfs:comment     "Affymetrix Human Genome U133 Plus 2.0 Array" .

:HiSeqX  rdf:type        owl:Class ;
        rdfs:subClassOf  :Platform ;
        rdfs:comment     "Illumina HiSeq X Platform for whole-genome sequencing" .

:Bionano_Irys  rdfs:comment  "Performs whole genome mapping in a nanoscale fluidic environment enabling the structure of the genome to be imaged and then analyzed at the single molecule level" ;
        rdfs:subClassOf  :Platform ;
        rdf:type         owl:Class .

:Infinium_HumanOmniExpressExome
        rdfs:comment     "Infinium HumanOmniExpressExome BeadChip" ;
        rdfs:subClassOf  :Platform ;
        rdf:type         owl:Class .

:Illumina_NovaSeq_6000
        rdfs:comment     "Illumina NovaSeq 6000 performs whole-genome sequencing" ;
        rdfs:subClassOf  :Platform ;
        rdf:type         owl:Class .

:Paired_End_1  rdfs:comment  "One of a pair of sequencing reads in which the two members of the pair are related by originating at either end of a clone insert." ;
        rdfs:subClassOf  :Read_Pair ;
        rdf:type         owl:Class .

:Paired_End_2  rdf:type  owl:Class ;
        rdfs:subClassOf  :Read_Pair ;
        rdfs:comment     "One of a pair of sequencing reads in which the two members of the pair are related by originating at either end of a clone insert." .

:Inward_Read  rdfs:subClassOf  :Read_Pair_Orientation ;
        rdf:type         owl:Class ;
        rdfs:comment     "Reads face each other" .

:Outward_Read  rdfs:comment  "Reads face away from each other" ;
        rdfs:subClassOf  :Read_Pair_Orientation ;
        rdf:type         owl:Class .

:Matching_Read  rdfs:comment  "Reads face the same direction" ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Read_Pair_Orientation .

:Forward_Read  rdf:type  owl:Class ;
        rdfs:subClassOf  :Read_Strand_Origin ;
        rdfs:comment     "Read 1 (or unpaired read) comes from the forward strand and read 2 (if applicable) comes from the reverse strand; equivalent to Tophat 'fr-secondstrand' type" .

:Reverse_Read  rdfs:comment  "read 1 (or unpaired read) comes from the reverse strand and read 2 (if applicable) comes from the forward strand; equivalent to Tophat 'fr-firststrand' type" ;
        rdfs:subClassOf  :Read_Strand_Origin ;
        rdf:type         owl:Class .

:GRCh38  rdf:type        owl:Class ;
        rdfs:subClassOf  :Reference_Genome ;
        rdfs:comment     "Genome Reference Consortium Human Build 38" .

:GRCh37  rdfs:subClassOf  :Reference_Genome ;
        rdfs:comment     "Genome Reference Consortium Human Build 37" ;
        rdf:type         owl:Class .

:MMUL1.0  rdfs:subClassOf  :Reference_Genome ;
        rdfs:comment     "Ensembl preliminary assembly Macaca mulatta" ;
        rdf:type         owl:Class .

:HRC    rdfs:subClassOf  :Reference_Genome ;
        rdf:type         owl:Class ;
        rdfs:comment     "Human haplotype reference panel" .

:Experimental_Data  rdf:type  owl:Class ;
        rdfs:comment     "Any file derived from or pertaining to a scientific experiment. experimentalData annotations should be applied, possibly disease-related" ;
        rdfs:subClassOf  :Resource .

:Result  rdfs:subClassOf  :Resource ;
        rdf:type         owl:Class ;
        rdfs:comment     "Any file that reports data results. Examples include figures, presentations, analysis, etc." .

:Tool   rdf:type         owl:Class ;
        rdfs:comment     "Any file or link that represents a tool, model, or algorithm; the tool annotations could be applied" ;
        rdfs:subClassOf  :Resource .

:Report  rdfs:subClassOf  :Resource ;
        rdfs:comment     "a document assembled by an author for the purpose of providing information for the audience. A report is the output of a documenting process and has the objective to be consumed by a specific audience. Topic of the report is on something that has completed. A report is not a single figure. Examples of reports are journal article, patent application, grant progress report, case report (not patient record)." ;
        rdf:type         owl:Class .

:Single_End  rdfs:comment  "A library preparation that results in the creation of a library of 5' ends of DNA." ;
        rdfs:subClassOf  :Run_Type ;
        rdf:type         owl:Class .

:Paired_End  rdfs:comment  "A library preparation that results in the creation of a library of the 5' and 3' ends of DNA or cDNA fragments using adaptors and endonucleases. The preparation may or may not include cloning process." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Run_Type .

:Human  rdfs:subClassOf  :Species ;
        rdfs:comment     "Homo sapiens with taxonomy ID: 9606 and Genbank common name: human" ;
        rdf:type         owl:Class .

:Mouse  rdfs:comment     "Mus musculus with taxonomy ID: 10090 and Genbank common name: house mouse" ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Species .

:Humanized_Mouse  rdfs:comment  "Mus musculus with taxonomy ID: 10090 and Genbank common name: house mouse" ;
        rdfs:subClassOf  :Species ;
        rdf:type         owl:Class .

:Rat    rdfs:comment     "Rattus with taxonomy ID:10116 and Genbank common name: Norway rat" ;
        rdfs:subClassOf  :Species ;
        rdf:type         owl:Class .

:Fruitfly  rdfs:subClassOf  :Species ;
        rdf:type         owl:Class ;
        rdfs:comment     "Drosophila melanogaster with taxonomy ID: 7227 and Genbank common name: fruit fly" .

:Rhesus_Monkey  rdfs:subClassOf  :Species ;
        rdf:type         owl:Class ;
        rdfs:comment     "Macaca mulatta with taxonomy ID: 9544 and Genbank common name: Rhesus monkey" .

:Chimpanzee  rdfs:comment  "Pan troglodytes with taxonomy ID: 9598 and Genbank common name: chimpanzee" ;
        rdfs:subClassOf  :Species ;
        rdf:type         owl:Class .

:Chicken  rdfs:comment   "The common domestic fowl, Chicken." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Species .

:Pig    rdfs:comment     "Sus scrofa with taxonomy ID: 9823 and Genbank common name: pig" ;
        rdfs:subClassOf  :Species ;
        rdf:type         owl:Class .

:Rabbit  rdfs:comment    "Oryctolagus cuniculus with taxonomy ID: 9986 and Genbank common name: rabbit" ;
        rdfs:subClassOf  :Species ;
        rdf:type         owl:Class .

:Zebrafish  rdfs:subClassOf  :Species ;
        rdfs:comment     "Danio rerio with taxonomy ID: 7955 and Genbank common name: zebrafish" ;
        rdf:type         owl:Class .

:seconds  rdf:type       owl:Class ;
        rdfs:subClassOf  :Time_Unit .

:minutes  rdfs:subClassOf  :Time_Unit ;
        rdf:type         owl:Class .

:hours  rdf:type         owl:Class ;
        rdfs:subClassOf  :Time_Unit .

:days   rdf:type         owl:Class ;
        rdfs:subClassOf  :Time_Unit .

:weeks  rdfs:subClassOf  :Time_Unit ;
        rdf:type         owl:Class .

:months  rdf:type        owl:Class ;
        rdfs:subClassOf  :Time_Unit .

:Nerve_Tissue  rdf:type  owl:Class ;
        rdfs:comment     "Portion of tissue in the nervous system which consists of neurons and glial cells, and may also contain parts of the vasculature." ;
        rdfs:subClassOf  :Tissue .

:Optic_Nerve  rdfs:comment  "The nerve that carries messages from the retina to the brain." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Tissue .

:Serum  rdfs:comment     "Liquid derived from blood plasma that has clotting factors removed." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Tissue .

:Plasma  rdfs:subClassOf  :Tissue ;
        rdf:type         owl:Class ;
        rdfs:comment     "Plasma is the fluid (noncellular) portion of the circulating blood, as distinguished from the serum that is the fluid portion of the blood obtained by removal of the fibrin clot and blood cells after coagulation." .

:Splenocyte  rdfs:subClassOf  :Tissue ;
        rdfs:comment     "Any leukocyte that is part of a spleen." ;
        rdf:type         owl:Class .

:Blood  rdf:type         owl:Class ;
        rdfs:comment     "A fluid that is composed of blood plasma and erythrocytes." ;
        rdfs:subClassOf  :Tissue .

:Primary_Tumor  rdfs:comment  "A primary tumor is the tumor at the initial site of cancer, not where the cancer may have spread or metastasized, called the secondary tumor." ;
        rdfs:subClassOf  :Tissue ;
        rdf:type         owl:Class .

:Embryonic_Tissue  rdfs:comment  "A portion of tissue that is part of an embryo." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Tissue .

:Meninges  rdfs:comment  "The three thin layers of tissue that cover and protect the brain and spinal cord." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Tissue .

:Bone_Marrow  rdfs:subClassOf  :Tissue ;
        rdf:type         owl:Class ;
        rdfs:comment     "The soft, fatty, vascular tissue that fills most bone cavities and is the source of red blood cells and many white blood cells." .

:Buccal_Mucosa  rdf:type  owl:Class ;
        rdfs:subClassOf  :Tissue ;
        rdfs:comment     "The mucosal membranes located on the inside of the cheek, in the buccal cavity.The inner lining of the cheeks." .

:Dorsal_Root_Ganglion
        rdfs:subClassOf  :Tissue ;
        rdfs:comment     "Ganglion with sensory function within the vertebral column." ;
        rdf:type         owl:Class .

:Cerebral_Cortex  rdfs:comment  "The outer layer of the cerebrum composed of neurons and unmyelinated nerve fibers. It is responsible for memory, attention, consciousness and other higher levels of mental function." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Tissue .

:Sciatic_Nerve  rdfs:subClassOf  :Tissue ;
        rdf:type         owl:Class ;
        rdfs:comment     "The longest single nerve that is formed by the merging of the ventral rami of the L4, L5, and S1 in the pelvis and passes down the lower limb where it divides into the common peroneal and tibial nerves" .

:Whole_Brain_Tissue  rdf:type  owl:Class ;
        rdfs:comment     "Brain tissue not limited to a specific region." ;
        rdfs:subClassOf  :Tissue .

:Buffy_Coat  rdfs:comment  "The middle layer of an anticoagulated blood specimen following separation by centrifugation. It contains most of the white blood cells and platelets." ;
        rdfs:subClassOf  :Tissue ;
        rdf:type         owl:Class .

:Allograft  rdf:type     owl:Class ;
        rdfs:subClassOf  :Transplantation ;
        rdfs:comment     "Tissues, cells, or organs transplanted between genetically different individuals of the same species" .

:Xenograft  rdfs:subClassOf  :Transplantation ;
        rdf:type         owl:Class ;
        rdfs:comment     "Tissues, cells or organs transplanted between animals of different species" .

:Autograft  rdfs:comment  "Transplant comprised of an individual's own tissue, transferred from one part of the body to another." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Transplantation .

:Isograft  rdfs:comment  "Tissues, cells or organs transplanted between genetically identical individuals" ;
        rdfs:subClassOf  :Transplantation ;
        rdf:type         owl:Class .

:Teratoma  rdf:type      owl:Class ;
        rdfs:subClassOf  :Tumor ;
        rdfs:comment     "A non-seminomatous germ cell tumor characterized by the presence of various tissues which correspond to the different germinal layers (endoderm, mesoderm, and ectoderm). It occurs in the testis, ovary, and extragonadal sites including central nervous system, mediastinum, lung, and stomach" .

:Cutaneous_Neurofibroma
        rdf:type         owl:Class ;
        rdfs:comment     "A neurofibroma that grows along small branches of nerves in the dermis in patients with neurofibromatosis. It presents as a solid cutaneous tumor." ;
        rdfs:subClassOf  :Tumor .

:Plexiform_Neurofibroma
        rdf:type         owl:Class ;
        rdfs:comment     "An elongated and multinodular neurofibroma, formed when the tumor involves either multiple trunks of a plexus or multiple fascicles of a large nerve, such as the sciatic. Some plexiform neurofibromas resemble a bag of worms, others produce a massive ropy enlargement of the nerve." ;
        rdfs:subClassOf  :Tumor .

:Atypical_Neurofibroma
        rdfs:subClassOf  :Tumor ;
        rdfs:comment     "A neurofibroma characterized by the presence of cellular pleomorphism." ;
        rdf:type         owl:Class .

:Malignant_Peripheral_Nerve_Sheath_Tumor
        rdfs:subClassOf  :Tumor ;
        rdfs:comment     "The tumors usually develop along peripheral or cranial nerves and are a central feature of NEUROFIBROMATOSIS 1, where they may occur intracranially or involve spinal roots." ;
        rdf:type         owl:Class .

:Adenocarcinoma  rdfs:subClassOf  :Tumor ;
        rdf:type         owl:Class ;
        rdfs:comment     "A common cancer characterized by the presence of malignant glandular cells. Morphologically, adenocarcinomas are classified according to the growth pattern (e.g., papillary, alveolar) or according to the secreting product (e.g., mucinous, serous)." .

:Carcinoma  rdf:type     owl:Class ;
        rdfs:comment     "A cell type cancer that has_material_basis_in abnormally proliferating cells derives_from epithelial cells." ;
        rdfs:subClassOf  :Tumor .

:Ductal_Carcinoma  rdfs:subClassOf  :Tumor ;
        rdf:type         owl:Class ;
        rdfs:comment     "Invasive ductal carcinoma (IDC), an infiltrating, malignant and abnormal proliferation of neoplastic cells in the breast tissue, or ductal carcinoma in situ (DCIS), a noninvasive, possibly malignant, neoplasm that is still confined to the milk ducts (lactiferous ducts), where breast cancer most often originates." .

:Melanoma  rdfs:comment  "A malignant, usually aggressive tumor composed of atypical, neoplastic melanocytes." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Tumor .

:Glioma  rdfs:subClassOf  :Tumor ;
        rdfs:comment     "A benign or malignant brain and spinal cord tumor that arises from glial cells (astrocytes, oligodendrocytes, ependymal cells). Tumors that arise from astrocytes are called astrocytic tumors or astrocytomas. Tumors that arise from oligodendrocytes are called oligodendroglial tumors. Tumors that arise from ependymal cells are called ependymomas." ;
        rdf:type         owl:Class .

:Low_Grade_Glioma  rdfs:subClassOf  :Tumor ;
        rdfs:comment     "Low grade gliomas are brain tumors that come from two different types of brain cells known as astrocytes and oligodendrocytes." ;
        rdf:type         owl:Class .

:Diffuse_Astrocytoma  rdfs:subClassOf  :Tumor ;
        rdf:type         owl:Class ;
        rdfs:comment     "Also called Low-Grade or Astrocytoma Grade II is a subtype of glial tumor of the brain or spinal cord showing astrocytic differentiation." .

:Anaplastic_Astrocytoma
        rdfs:comment     "A diffusely infiltrating, WHO grade III astrocytoma with focal or dispersed anaplasia, and a marked proliferative potential. It may arise from a low-grade astrocytoma, but it can also be diagnosed at first biopsy, without indication of a less malignant precursor lesion. It has an intrinsic tendency for malignant progression to glioblastoma." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Tumor .

:Glioblastoma  rdf:type  owl:Class ;
        rdfs:subClassOf  :Tumor ;
        rdfs:comment     "Develop primarily through increasing anaplasia of well differentiated gliomas, mainly astrocytomas or oligodendrogliomas. Typically large and contain cells of different sizes with irrregular nuclei and atypical mitotic figures." .

:Schwannoma  rdfs:comment  "A neoplasm that arises from SCHWANN CELLS of the cranial, peripheral, and autonomic nerves." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Tumor .

:Lymphoblastic_Lymphoma
        rdfs:comment     "A lymphoma composed of immature small to medium-sized precursor lymphoid cells (lymphoblasts). It includes the B- and T-cell lymphoblastic lymphoma." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Tumor .

:Meningioma  rdf:type    owl:Class ;
        rdfs:subClassOf  :Tumor ;
        rdfs:comment     "A generally slow growing tumor attached to the dura mater. It is composed of neoplastic meningothelial (arachnoidal) cells." .

:Myeloma  rdfs:subClassOf  :Tumor ;
        rdfs:comment     "A bone marrow cancer that is formed of any one of the bone marrow cells belonging to the granulocytic (neutrophil, eosinophil, basophil), monocytic/macrophage, erythroid, megakaryocytic and mast cell lineages." ;
        rdf:type         owl:Class .

:PDX_Genomics_Assay_Template
        rdfs:subClassOf  :Genomics_Assay_Template ;
        rdfs:comment     "Extends genomicsAssay for PDX experiments" ;
        rdf:type         owl:Class .

:ScRNA_Seq  rdfs:comment  "A procedure that can determine the nucleotide sequence for all of the RNA transcripts in an amplified nucleotide sample that was derived from a single cell." ;
        rdfs:subClassOf  :Sequencing ;
        rdf:type         owl:Class .

:Update_Milestone_Report_Template
        rdfs:subClassOf  :Non_Assay_Template ;
        rdf:type         owl:Class ;
        rdfs:comment     "Defines a metadata template for updating milestone report values in NF studies -- currently a supported feature for NTAP and GFF." .

:Template  rdfs:comment  "Parent attribute for the manifest template attributes." ;
        rdf:type      owl:Class .

:Normal  rdfs:comment  "No pathological entity observable." ;
        rdf:type      owl:Class .

:Massive_Soft_Tissue_Neurofibroma
        rdf:type         owl:Class ;
        rdfs:comment     "Massive soft tissue neurofibroma is characterized  by local infiltration and extension to multiple nerve branches,  as well as substantial overgrowth of adjacent soft tissue and  skin, which distinguishes it from its more benign variant, plexiform neurofibroma. With striking presentation and  severe dysmorphism, massive soft tissue neurofibroma is also labeled elephantiasis neuromatosa. Although considered benign it  shares similarities with malignant peripheral nerve sheath  tumors such as local infiltration and cell mitogenesis. Massive soft tissue neurofibroma is associated with significant morbidity and mortality and almost no response to  conventional chemotherapy and radiotherapy. Surgery is eventually pursued, although bleeding may be a life-threatening  complication as massive soft tissue neurofibromas are highly  vascularized." ;
        rdfs:subClassOf  :Tumor .

:Diffuse_Infiltrating_Neurofibroma
        rdfs:comment     "Diffuse infiltrating neurofibroma can present as slow-growing, soft tissue masses with overlying skin thickening. These le-sions infiltrate the dermis and the subcutaneous tissue and  characteristically spread along the connective tissues enveloping islands of normal fat. Some of these lesions develop fatty proliferation and can mimic lipomas,  angiolipomas, or angiomyolipomas on imaging and histological evaluation" ;
        rdfs:subClassOf  :Tumor ;
        rdf:type         owl:Class .

:Localized_Neurofibroma
        rdfs:subClassOf  :Tumor ;
        rdf:type         owl:Class .

:Neurofibroma_With_Degenerative_Atypia
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Tumor .

:Neurofibroma  rdf:type  owl:Class ;
        rdfs:subClassOf  :Tumor .

:Mesentery  rdfs:subClassOf  :Tissue ;
        rdf:type         owl:Class .

:Connective_Tissue  rdfs:subClassOf  :Tissue ;
        rdf:type         owl:Class .

:Viably_Frozen  rdfs:subClassOf  :Specimen_State ;
        rdf:type         owl:Class .

:Scalp  rdfs:subClassOf  :Body_Part ;
        rdf:type         owl:Class .

:Pelvis  rdf:type        owl:Class ;
        rdfs:subClassOf  :Body_Part .

:Neck   rdfs:subClassOf  :Body_Part ;
        rdf:type         owl:Class .

:Leg    rdf:type         owl:Class ;
        rdfs:subClassOf  :Body_Part .

:Liver  rdfs:subClassOf  :Body_Part ;
        rdf:type         owl:Class .

:Axilla  rdfs:subClassOf  :Body_Part ;
        rdf:type         owl:Class .

:Acetabulum  rdf:type    owl:Class ;
        rdfs:subClassOf  :Body_Part .

:Forearm  rdfs:subClassOf  :Body_Part ;
        rdf:type         owl:Class .

:Muscle  rdf:type        owl:Class ;
        rdfs:subClassOf  :Body_Part .

:Finger  rdfs:subClassOf  :Body_Part ;
        rdf:type         owl:Class .

:Thoracic_Spine  rdf:type  owl:Class ;
        rdfs:subClassOf  :Body_Part .

:Groin  rdf:type         owl:Class ;
        rdfs:comment     "Anatomically also known as the inguinal part of abdomen." ;
        rdfs:subClassOf  :Body_Part .

:Back   rdf:type         owl:Class ;
        rdfs:subClassOf  :Body_Part ;
        rdfs:comment     "Anatomically also known as the dorsum." .

:Iliac_Spine  rdfs:subClassOf  :Body_Part ;
        rdf:type         owl:Class .

:Spine  rdf:type         owl:Class ;
        rdfs:subClassOf  :Body_Part .

:Shoulder  rdf:type      owl:Class ;
        rdfs:subClassOf  :Body_Part .

:Scapula  rdfs:subClassOf  :Body_Part ;
        rdf:type         owl:Class .

:Curated_Data  rdf:type  owl:Class ;
        rdfs:subClassOf  :Data ;
        rdfs:comment     "Any file derived from or pertaining a manually or programatically curated data resource. Examples include: reference sequences, drug information databases, identifier maps\"\"" .

:Tumor_Adjacent_Normal
        rdfs:comment     "Tissue comprised of morphologically normal tissue collected from the area immediately surrounding a tumor." ;
        rdfs:subClassOf  :Tissue ;
        rdf:type         owl:Class .

:PDX_Tissue  rdfs:comment  "Patient derived xenograft tissue" ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Tissue .

:CDX_Tissue  rdfs:comment  "Cell line derived xenograft tissue" ;
        rdfs:subClassOf  :Tissue ;
        rdf:type         owl:Class .

:Tumor  rdf:type      owl:Class ;
        rdfs:comment  "General term for tumor sample – use when it is unknown when a more specific clinical classification is unknown, e.g. whether it is primary or secondary." .

:Metastatic_Tumor  rdfs:comment  "For neoplasms, a non-infiltrating and non-metastasizing neoplastic process that is characterized by the absence of morphologic features associated with malignancy (e.g., severe atypia, nuclear pleomorphism, tumor cell necrosis, and abnormal mitoses)." ;
        rdf:type         owl:Class ;
        rdfs:subClassOf  :Tumor .

:Metastatic_Recurrent_Tumor
        rdfs:comment     "A tumor with metastatic/recurrent characteristic." ;
        rdfs:subClassOf  :Tumor ;
        rdf:type         owl:Class .

:Recurrent_Tumor  rdfs:comment  "A tumor described with recurrent characteristic." ;
        rdfs:subClassOf  :Tumor ;
        rdf:type         owl:Class .

:Organoid  rdf:type      owl:Class ;
        rdfs:subClassOf  :Tissue ;
        rdfs:comment     "Organoids are three-dimensional cell culture models that self-organize into complex organ-like tissues." .

:Spheroid  rdf:type      owl:Class ;
        rdfs:comment     "Spheroids are 3D culture systems that can be used to model multicellular tumors; more broadly, spheroids can be defined as cell aggregates cultured on nonadherent substrates." ;
        rdfs:subClassOf  :Tissue .

:Microtissue  rdfs:subClassOf  :Tissue ;
        rdf:type         owl:Class ;
        rdfs:comment     "Microtissue usually refers to the microtissue formed by the aggregation of seed cells under the action of cell-cell or cell-extracellular matrix (ECM). Compared with traditional cell monolayer culture, cells are cultivated into a three-dimensional microstructure in a specific way. The microstructure characteristics of microtissue are similar to natural tissues and can promote cell proliferation and differentiation." .

<#OTTR>  rdf:type        owl:Class ;
        rdfs:subClassOf  <end> .
