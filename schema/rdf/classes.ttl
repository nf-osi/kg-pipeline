:Illumina_Omni2pt5M  rdf:type  owl:Class ;
        rdfs:subClassOf  :Platform .

:Illumina_Omni5M  rdf:type  owl:Class ;
        rdfs:subClassOf  :Platform .

:Illumina_MouseWG-6_v2.0_expression_beadchip
        rdfs:subClassOf  :Platform ;
        rdfs:comment     "Whole-genome expression profiling in the mouse" ;
        rdf:type         owl:Class .

