shapes:Nf1MutationSetShape a sh:NodeShape ;
    sh:targetClass nf:Nf1MutationSet ;
    rdfs:label "NF1 Mutation Set shape" ;
    rdfs:comment "Expected properties for derived NF1 mutation set instances." ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:comment ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:hasMutation ;
        sh:nodeKind sh:IRI ;
        sh:class nf:Mutation ;
    ] .

