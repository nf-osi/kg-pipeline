# Development
################################################################################

shapes:DevelopmentShape a sh:NodeShape ;
    sh:targetClass nf:Development ;
    rdfs:label "Development shape" ;
    rdfs:comment "Expected properties for Development instances." ;
    sh:property [
        sh:path nf:forResourceId ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:hasFunder ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path nf:hasInvestigator ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path nf:hasPublication ;
        sh:nodeKind sh:IRI ;
    ] .

################################################################################
# Observation
################################################################################

shapes:ObservationShape a sh:NodeShape ;
    sh:targetClass nf:Observation ;
    rdfs:label "Observation shape" ;
    rdfs:comment "Expected properties for Observation instances." ;
    sh:property [
        sh:path nf:observationId ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:observationText ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:observationSubmitterName ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:observationPhase ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:observationTime ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:observationTimeUnits ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:observationLink ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:reliabilityRating ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:easeOfUseRating ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:investigatorSynapseId ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:forResourceId ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:referencesPublication ;
        sh:nodeKind sh:IRI ;
    ] .

################################################################################
# Tool (Resource)
################################################################################

shapes:ToolShape a sh:NodeShape ;
    sh:targetClass nf:Tool ;
    rdfs:label "Tool shape" ;
    rdfs:comment "Expected properties for Tool (Resource) instances." ;
    sh:property [
        sh:path nf:resourceId ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:resourceType ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:description ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:rrid ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:howToAcquire ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:dateAdded ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:dateModified ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:usageRequirements ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path nf:synonyms ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path nf:fromDonor ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path nf:hasPublication ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path nf:hasFunder ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path nf:hasInvestigator ;
        sh:nodeKind sh:IRI ;
    ] .
