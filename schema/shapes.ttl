@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix nf:   <http://nf-osi.github.com/terms#> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix shapes: <http://nf-osi.github.com/shapes#> .

################################################################################
# File
################################################################################

shapes:FileShape a sh:NodeShape ;
    sh:targetClass nf:File ;
    rdfs:label "File shape" ;
    rdfs:comment "Expected properties for File instances." ;
    sh:property [
        sh:path nf:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:parentStudy ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path nf:assay ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:platform ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:resourceType ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:dataType ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path nf:dataSubtype ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:fileFormat ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:individualID ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path nf:specimenID ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path nf:sex ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:species ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:nf1Genotype ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path nf:nf2Genotype ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path nf:hasNF1Genotype ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path nf:hasNF2Genotype ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path nf:cellType ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path nf:tissue ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path nf:organ ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path nf:diagnosis ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path nf:tumorType ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path nf:compoundName ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path nf:experimentalCondition ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path nf:modelSystemName ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path nf:hasModelSystem ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path nf:reportMilestone ;
        sh:datatype xsd:double ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:hasFunder ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path nf:createdBy ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nf:modifiedBy ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] .

